---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickQuote from '../components/forms/QuickQuote.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout
  title="Cotiza tu proyecto"
  description="Solicita una cotización de drones, desarrollo web, software o licencias originales por WhatsApp o correo."
>
  <section class="quote-page">
    <div class="quote-page__glow" aria-hidden="true"></div>
    <div class="container quote-page__layout">
      <div class="quote-page__intro">
        <p class="quote-page__eyebrow"><span></span>COTIZACIÓN DIRECTA</p>
        <h1>Cuéntanos qué necesitas.</h1>
        <p class="quote-page__lead">Elige un servicio, resume tu idea y envíala por el canal que prefieras.</p>

        <div class="quote-page__services" aria-label="Servicios disponibles">
          <span><Icon name="drone" size={18} />Drones</span>
          <span><Icon name="code" size={18} />Desarrollo web</span>
          <span><Icon name="key" size={18} />Software</span>
        </div>

        <div class="quote-page__signal">
          <span class="quote-page__signal-icon"><Icon name="check" size={20} /></span>
          <p><strong>Respuesta personalizada</strong><small>Revisamos cada solicitud antes de confirmar alcance y precio.</small></p>
        </div>
      </div>

      <div class="quote-page__form">
        <div class="quote-page__form-heading">
          <span>01</span>
          <div><p>EMPECEMOS</p><h2>Solicita tu cotización</h2></div>
        </div>
        <QuickQuote />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-page{position:relative;display:grid;align-items:center;min-height:calc(100svh - var(--header-h) - 88px);padding:clamp(1.25rem,3.5vw,3rem) 0;overflow:hidden;background:linear-gradient(115deg,#031b31 0%,#062d46 48%,#075253 100%);color:#fff}
  .quote-page::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgb(89 188 230/.055) 1px,transparent 1px),linear-gradient(90deg,rgb(89 188 230/.055) 1px,transparent 1px);background-size:56px 56px;mask-image:linear-gradient(90deg,#000,transparent 85%)}
  .quote-page__glow{position:absolute;right:-12vw;bottom:-32vw;width:62vw;aspect-ratio:1;border:1px solid rgb(66 200 231/.18);border-radius:50%;box-shadow:0 0 0 8vw rgb(39 185 204/.035),0 0 0 16vw rgb(39 185 204/.025)}
  .quote-page__layout{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,.85fr) minmax(520px,1.15fr);align-items:center;gap:clamp(2rem,5vw,5.5rem)}
  .quote-page__intro{max-width:540px}
  .quote-page__eyebrow{display:flex;align-items:center;gap:.7rem;margin:0 0 1rem;color:#62e0ee;font-size:.78rem;font-weight:800;letter-spacing:.12em}
  .quote-page__eyebrow span{width:28px;height:2px;background:#62e0ee;box-shadow:0 0 14px #62e0ee}
  .quote-page h1{max-width:9ch;margin:0;color:#fff;font-size:clamp(3.1rem,5.5vw,5.5rem);line-height:.93;letter-spacing:-.06em}
  .quote-page__lead{max-width:30rem;margin:1.25rem 0 1.4rem;color:#b7ccda;font-size:clamp(1rem,1.4vw,1.2rem);line-height:1.55}
  .quote-page__services{display:flex;flex-wrap:wrap;gap:.55rem}
  .quote-page__services span{display:inline-flex;align-items:center;gap:.45rem;padding:.55rem .75rem;border:1px solid rgb(97 205 235/.22);border-radius:999px;background:rgb(3 25 43/.42);color:#e4f5fb;font-size:.78rem;font-weight:700}
  .quote-page__services :global(svg){color:#5bd9ef}
  .quote-page__signal{display:flex;align-items:center;gap:.8rem;margin-top:1.35rem;padding-top:1.1rem;border-top:1px solid rgb(136 196 220/.16)}
  .quote-page__signal-icon{display:grid;place-items:center;flex:0 0 auto;width:40px;height:40px;border-radius:12px;background:rgb(66 219 156/.12);color:#4bdd9e}
  .quote-page__signal p,.quote-page__signal small{display:block;margin:0}
  .quote-page__signal strong{font-size:.85rem}.quote-page__signal small{margin-top:2px;color:#91aabd;font-size:.72rem}
  .quote-page__form-heading{display:flex;align-items:flex-end;gap:.9rem;margin:0 0 .75rem;padding-inline:.3rem}
  .quote-page__form-heading>span{color:rgb(105 209 235/.34);font-size:2.5rem;font-weight:800;line-height:1}
  .quote-page__form-heading p{margin:0 0 .15rem;color:#5ddcee;font-size:.7rem;font-weight:800;letter-spacing:.13em}
  .quote-page__form-heading h2{margin:0;color:#fff;font-size:clamp(1.4rem,2vw,2rem)}
  @media(max-width:980px){.quote-page{min-height:auto}.quote-page__layout{grid-template-columns:1fr;gap:1.6rem}.quote-page__intro{max-width:none}.quote-page h1{max-width:12ch;font-size:clamp(2.8rem,9vw,4.5rem)}.quote-page__lead{margin-block:.9rem}.quote-page__signal{display:none}}
  @media(max-width:640px){.quote-page{padding:1.2rem 0 1.5rem}.quote-page__services{display:none}.quote-page__form-heading{margin-bottom:.55rem}.quote-page__form-heading>span{font-size:2rem}}
</style>
