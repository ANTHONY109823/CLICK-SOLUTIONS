---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import LicenseCatalog from '../../components/licenses/LicenseCatalog.astro';
import ResetEpsonProduct from '../../components/licenses/ResetEpsonProduct.astro';
import CommercialPlans from '../../components/sections/CommercialPlans.astro';
import ServiceHeroVisual from '../../components/sections/ServiceHeroVisual.astro';
import { site } from '../../config/site';
import { getServices, getLicenses } from '../../lib/content';
import { whatsappUrl } from '../../lib/links';
import { serviceSchema, breadcrumbSchema } from '../../lib/seo';
import type { Service } from '../../data/services';

export const getStaticPaths = (() =>
  getServices().map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const path = `/servicios/${service.slug}`;
const siteUrl = new URL(Astro.site ?? Astro.url.origin);
const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/#servicios' },
  { label: service.name, href: path },
];

const isLicenses = service.slug === 'licencias-software';
const commercialPlanService = service.slug === 'drones' || service.slug === 'desarrollo-web' ? service.slug : null;
const hasCommercialPlans = commercialPlanService !== null;
const contentAnchor = isLicenses ? 'catalogo' : hasCommercialPlans ? 'planes' : 'trabajos';
const contentLabel = isLicenses ? 'Ver productos' : hasCommercialPlans ? 'Ver planes' : 'Ver soluciones';

const whatsapp = whatsappUrl(`Hola ${site.name}, quisiera información sobre: ${service.name}.`);
const products = isLicenses ? getLicenses() : [];
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  schema={[
    serviceSchema(siteUrl, { name: service.name, description: service.seo.description, path }),
    breadcrumbSchema(siteUrl, breadcrumbs),
  ]}
>
  <PageHero compact eyebrow={service.hero.eyebrow} title={service.hero.title} lead={service.hero.lead} breadcrumbs={breadcrumbs}>
    <Fragment slot="actions">
      <Button href={`#${contentAnchor}`} variant="on-dark" size="lg" iconRight="arrow-right">
        {contentLabel}
      </Button>
    </Fragment>
    <div slot="aside" class="hero-visual"><ServiceHeroVisual service={service.slug} /></div>
  </PageHero>

  <section class="service-sheet" id={contentAnchor}>
    <div class="container service-sheet__inner">
      <header class="work-heading">
        <div>
          <span class="eyebrow">{isLicenses ? 'Producto destacado y catálogo' : hasCommercialPlans ? 'Opciones claras' : 'Qué ofrecemos'}</span>
          <h2>{isLicenses ? 'Software para trabajar mejor' : hasCommercialPlans ? (service.slug === 'drones' ? 'Paquetes según tu objetivo' : 'Tres niveles para crecer') : service.offeringsTitle}</h2>
          <p>{service.description[0]}</p>
        </div>
        <div class="audience-pills" aria-label="A quién está dirigido">
          {service.audiences.map((audience) => <span><Icon name={audience.icon} size={15} />{audience.title}</span>)}
        </div>
      </header>

      {isLicenses ? (
        <div class="license-stack">
          <ResetEpsonProduct />
          <div class="catalog-heading">
            <div><span>Más opciones</span><h2>Licencias y descargas gratuitas</h2></div>
            <p>Busca por nombre o categoría y revisa la modalidad antes de continuar.</p>
          </div>
          <LicenseCatalog products={products} />
        </div>
      ) : commercialPlanService ? (
        <CommercialPlans service={commercialPlanService} />
      ) : (
        <div class="rail-shell" data-scroll-shell>
          <div class="rail-controls" aria-label="Mover servicios">
            <button type="button" aria-label="Ver servicios anteriores" data-scroll-prev><Icon name="arrow-right" size={17} /></button>
            <button type="button" aria-label="Ver más servicios" data-scroll-next><Icon name="arrow-right" size={17} /></button>
          </div>
          <div class="work-rail" aria-label={service.offeringsTitle} data-scroll-rail tabindex="0">
            {service.offerings.map((offering) => (
              <article class="work-card">
                <span class="work-card__icon"><Icon name={offering.icon} size={21} /></span>
                <h3>{offering.title}</h3>
                <p>{offering.summary}</p>
                <div class="work-card__bottom"><strong>Precio según alcance</strong></div>
              </article>
            ))}
          </div>
        </div>
      )}

      {service.notes?.[0] && <p class="service-note"><Icon name="info" size={17} />{service.notes[0]}</p>}

      <aside class="quote-strip" id="cotizar">
        <div>
          <span>Cotización clara</span>
          <h2>{service.cta.formHeading}</h2>
          <p>Elige la opción que más se acerca a lo que necesitas. Confirmamos alcance, precio y próximos pasos antes de empezar.</p>
        </div>
        <div class="quote-strip__actions">
          <Button href={`/contacto?servicio=${service.slug}`} size="lg" iconRight="arrow-right" track="quote_cta" data-track-label={`${service.slug}-compact`}>
            {service.cta.label}
          </Button>
          {whatsapp && <Button href={whatsapp} variant="secondary" size="lg" icon="message" external track="whatsapp_click" data-track-label={`${service.slug}-compact`}>WhatsApp</Button>}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-scroll-shell]').forEach((shell) => {
    const rail = shell.querySelector<HTMLElement>('[data-scroll-rail]');
    const previous = shell.querySelector<HTMLButtonElement>('[data-scroll-prev]');
    const next = shell.querySelector<HTMLButtonElement>('[data-scroll-next]');
    if (!rail || !previous || !next) return;

    const move = (direction: number) => rail.scrollBy({ left: direction * Math.min(rail.clientWidth * 0.82, 720), behavior: 'smooth' });
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));

    const update = () => {
      previous.disabled = rail.scrollLeft < 4;
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
    };
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  });
</script>

<style>
  .hero-visual {
    max-width: 520px;
    margin-inline: auto;
    width: 100%;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .audiences {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .audience {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .audience .icon-tile {
    flex-shrink: 0;
    margin: 0;
  }

  .audience h3 {
    font-size: var(--fs-md);
    margin-bottom: var(--space-1);
  }

  .audience p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .offering {
    display: flex;
    flex-direction: column;
  }

  .offering__summary {
    color: var(--text-muted);
  }

  .offering__details {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: var(--fs-sm);
  }

  dt,
  .offering__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  dd {
    margin: 2px 0 0;
  }

  .offering__label {
    margin-bottom: var(--space-2);
  }

  .offering .check-list {
    font-size: var(--fs-sm);
    margin: 0;
  }

  .offering-note {
    margin: var(--space-6) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .support-note,
  .licenses-note {
    margin-top: var(--space-8);
  }

  .store-promises {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .store-promises article {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, #fff, #f7fbfe);
  }

  .store-promises :global(svg) {
    flex: 0 0 auto;
    color: var(--brand-blue);
  }

  .store-promises strong,
  .store-promises small {
    display: block;
  }

  .store-promises strong {
    color: var(--brand-ink);
    font-size: var(--fs-sm);
  }

  .store-promises small {
    margin-top: 3px;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.45;
  }

  .section-header--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: none;
  }

  .notes {
    display: grid;
    gap: var(--space-3);
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-12);
  }

  .requirements {
    margin-top: var(--space-6);
  }

  .form-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: start;
  }

  .form-intro {
    position: sticky;
    top: calc(var(--header-h) + var(--space-8));
  }

  .form-card {
    padding: clamp(1.25rem, 0.5rem + 3vw, 2.5rem);
  }

  @media (max-width: 899px) {
    .intro,
    .two-col,
    .form-layout {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .form-intro {
      position: static;
    }

    .store-promises {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .store-promises {
      grid-template-columns: 1fr;
    }
  }

  .service-sheet {
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(2.5rem, 5vh, 4.5rem);
    background: radial-gradient(circle at 88% 8%, rgb(0 170 231 / 0.07), transparent 25%), var(--bg);
  }

  .service-sheet__inner { display: grid; gap: clamp(1.4rem, 3vh, 2.2rem); }

  .work-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-8);
  }

  .work-heading h2 { margin-bottom: var(--space-2); }
  .work-heading p { max-width: 68ch; margin: 0; color: var(--text-muted); font-size: var(--fs-sm); }

  .audience-pills { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-2); }
  .audience-pills span { display: inline-flex; align-items: center; gap: 6px; padding: 7px 11px; border: 1px solid var(--border); border-radius: var(--radius-full); background: #fff; color: var(--text-muted); font-size: var(--fs-xs); font-weight: 650; white-space: nowrap; }
  .audience-pills :global(svg) { color: var(--link); }

  .work-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 1fr);
    gap: var(--space-4);
    overflow-x: auto;
    padding: 4px 2px var(--space-4);
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .rail-shell { position: relative; }
  .rail-controls { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: var(--space-2); }
  .rail-controls button { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--border); border-radius: 12px; background: #fff; color: var(--brand-navy); cursor: pointer; transition: border-color var(--dur-fast), background-color var(--dur-fast), opacity var(--dur-fast); }
  .rail-controls button:first-child { transform: rotate(180deg); }
  .rail-controls button:hover:not(:disabled) { border-color: var(--brand-cyan); background: var(--info-bg); }
  .rail-controls button:disabled { opacity: 0.35; cursor: default; }

  .work-card {
    display: flex;
    flex-direction: column;
    min-height: 270px;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, #fff, #f6fbff);
    box-shadow: var(--shadow-sm);
    scroll-snap-align: start;
  }

  .work-card__icon { display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: var(--space-5); border-radius: 14px; background: linear-gradient(145deg, #daf5ff, #cee9ff); color: var(--brand-blue); }
  .work-card h3 { font-size: var(--fs-md); }
  .work-card > p { display: -webkit-box; margin-bottom: var(--space-5); overflow: hidden; color: var(--text-muted); font-size: var(--fs-sm); -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .work-card__bottom { display: flex; align-items: center; gap: var(--space-3); margin-top: auto; padding-top: var(--space-4); border-top: 1px solid var(--border); }
  .work-card__bottom strong { font-size: var(--fs-xs); color: var(--brand-ink); }
  .work-card__bottom a { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-xs); font-weight: 700; text-decoration: none; }

  .service-note { display: flex; align-items: flex-start; gap: var(--space-2); margin: 0; color: var(--text-muted); font-size: var(--fs-xs); }
  .service-note :global(svg) { flex: 0 0 auto; margin-top: 2px; color: var(--link); }

  .license-stack { display: grid; min-width: 0; gap: clamp(2.25rem, 5vw, 4rem); }
  .license-stack > * { min-width: 0; }
  .catalog-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-6); margin-bottom: calc(var(--space-4) * -1); }
  .catalog-heading span { color: var(--link); font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .catalog-heading h2 { margin: 3px 0 0; font-size: var(--fs-xl); }
  .catalog-heading p { max-width: 46ch; margin: 0; color: var(--text-muted); font-size: var(--fs-sm); text-align: right; }

  .quote-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-8);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 22px;
    background: linear-gradient(125deg, #041a36, #073d69);
    color: var(--dark-text);
    box-shadow: 0 28px 55px -38px #001020;
  }

  .quote-strip > div > span { color: var(--dark-accent); font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
  .quote-strip h2 { margin: 3px 0 5px; color: #fff; font-size: var(--fs-xl); }
  .quote-strip p { max-width: 62ch; margin: 0; color: #9db5ca; font-size: var(--fs-sm); }
  .quote-strip__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-3); }

  @media (min-width: 1100px) {
    .work-rail { grid-auto-columns: minmax(250px, calc((100% - 3 * var(--space-4)) / 4)); }
  }

  @media (max-width: 820px) {
    .service-sheet { min-height: auto; }
    .work-heading, .quote-strip { grid-template-columns: 1fr; }
    .audience-pills, .quote-strip__actions { justify-content: flex-start; }
    .catalog-heading { align-items: flex-start; flex-direction: column; gap: var(--space-2); }
    .catalog-heading p { text-align: left; }
  }

  @media (max-width: 520px) {
    .work-rail { grid-auto-columns: minmax(84vw, 1fr); }
    .quote-strip__actions { display: grid; }
    .quote-strip__actions :global(.btn) { width: 100%; }
  }
</style>
