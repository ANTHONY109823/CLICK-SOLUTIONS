---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { getServices } from '../../lib/content';

const services = getServices();
---

<BaseLayout
  title="Servicios"
  description="Conoce los servicios de ClickSolutions: drones, desarrollo web, soporte técnico, software y licencias para personas y empresas en Perú."
>
  <PageHero
    compact
    eyebrow="Servicios"
    title="Elige y entra directamente"
    lead="Cuatro áreas, sin pasos intermedios. Abre el servicio que necesitas para ver opciones, condiciones y cotización."
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Servicios', href: '/servicios' },
    ]}
  />

  <section class="section services-direct">
    <div class="container services-list">
      {
        services.map((service, index) => (
          <a class="service-row" href={`/servicios/${service.slug}`}>
            <div class="service-row__head">
              <span class="service-row__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="icon-tile"><Icon name={service.icon} size={24} /></span>
              <h2>{service.name}</h2>
              <p>{service.tagline}</p>
            </div>
            <span class="service-row__open">Abrir <Icon name="arrow-right" size={18} /></span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .services-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 210px;
    padding: clamp(1.35rem, 2.5vw, 2.25rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: linear-gradient(145deg, #fff, #f6fbff);
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base), box-shadow var(--dur-base);
  }

  .service-row:hover { color: inherit; transform: translateY(-4px); border-color: #9bdcf5; box-shadow: var(--shadow-md); }

  .service-row__index {
    float: right;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--border-strong);
  }

  .service-row h2 { margin-bottom: 5px; font-size: var(--fs-xl); }
  .service-row p { max-width: 40ch; margin: 0; color: var(--text-muted); font-size: var(--fs-sm); }
  .service-row .icon-tile { margin-bottom: var(--space-4); }
  .service-row__open { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; color: var(--link); font-size: var(--fs-sm); font-weight: 750; }

  @media (max-width: 899px) {
    .services-list { grid-template-columns: 1fr; }
    .service-row { min-height: 170px; }
  }

  @media (max-width: 480px) {
    .service-row { align-items: flex-start; flex-direction: column; }
  }
</style>
