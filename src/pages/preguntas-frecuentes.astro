---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FAQList from '../components/sections/FAQList.astro';
import Icon from '../components/ui/Icon.astro';
import CTABand from '../components/sections/CTABand.astro';
import { getServices, getGeneralFaqs } from '../lib/content';
import { faqSchema } from '../lib/seo';

const services = getServices();
const groups = [
  { id: 'general', title: 'Preguntas generales', icon: 'help' as const, faqs: getGeneralFaqs() },
  ...services.map((s) => ({ id: s.slug, title: s.name, icon: s.icon, faqs: s.faqs })),
];
---

<BaseLayout
  title="Preguntas frecuentes"
  description="Respuestas a las preguntas más comunes sobre los servicios de ClickSolutions: cotizaciones, drones, desarrollo web, soporte técnico y licencias."
  schema={[faqSchema(groups.flatMap((g) => g.faqs))]}
>
  <PageHero
    compact
    eyebrow="Ayuda"
    title="Preguntas frecuentes"
    lead="Encuentra respuestas rápidas sobre cómo trabajamos y sobre cada uno de nuestros servicios."
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes' },
    ]}
  />

  <section class="section">
    <div class="container faq-page">
      <nav class="faq-nav" aria-label="Temas">
        <p class="faq-nav__title">Temas</p>
        <ul>
          {groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
        </ul>
      </nav>
      <div class="faq-groups">
        {
          groups.map((g) => (
            <section id={g.id} class="faq-group" aria-labelledby={`${g.id}-title`}>
              <h2 id={`${g.id}-title`}>
                <span class="icon-tile"><Icon name={g.icon} size={20} /></span>
                {g.title}
              </h2>
              <FAQList faqs={g.faqs} />
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand title="¿No encontraste tu respuesta?" text="Escríbenos y te ayudamos con tu caso específico." ctaLabel="Contactar" />
</BaseLayout>

<style>
  .faq-page {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .faq-nav {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
  }

  .faq-nav__title {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .faq-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .faq-nav a {
    display: block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
  }

  .faq-nav a:hover {
    color: var(--brand-navy);
  }

  .faq-groups {
    display: grid;
    gap: var(--space-12);
  }

  .faq-group h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-xl);
  }

  .faq-group .icon-tile {
    margin: 0;
  }

  @media (max-width: 799px) {
    .faq-page {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .faq-nav {
      position: static;
    }
  }
</style>
