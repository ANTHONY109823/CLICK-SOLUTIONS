---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import ProjectCard from '../components/sections/ProjectCard.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import { getServices, getProjects } from '../lib/content';
import type { IconName } from '../components/ui/icons';

const services = getServices();
const projects = getProjects().slice(0, 2);

const projectFormats: { title: string; text: string; icon: IconName; href: string }[] = [
  { title: 'Experiencias web', text: 'Sitios, catálogos y sistemas enfocados en objetivos reales.', icon: 'code', href: '/servicios/desarrollo-web' },
  { title: 'Contenido desde el aire', text: 'Fotografía y video para inmuebles, eventos y empresas.', icon: 'drone', href: '/servicios/drones' },
  { title: 'Tecnología lista para usar', text: 'Equipos, software y soporte con orientación clara.', icon: 'cpu', href: '/servicios/soporte-tecnico' },
];

const values: { title: string; text: string; icon: IconName }[] = [
  { title: 'Claridad', text: 'Alcance y precio antes de empezar.', icon: 'clipboard' },
  { title: 'Criterio', text: 'La solución adecuada, no la más complicada.', icon: 'target' },
  { title: 'Confianza', text: 'Software legítimo y datos protegidos.', icon: 'shield' },
];
---

<BaseLayout
  title="ClickSolutions | Tecnología para personas y empresas"
  rawTitle
  description="Soluciones tecnológicas en Perú: drones, desarrollo web, soporte técnico, licencias y herramientas de software para personas y empresas."
>
  <HomeHero services={services} />

  <section class="home-panel projects-panel" id="proyectos">
    <div class="container panel-inner">
      <header class="panel-heading" data-reveal>
        <div><span class="eyebrow">Proyectos</span><h2>Ideas convertidas en soluciones útiles</h2></div>
        <Button href="/proyectos" variant="ghost" iconRight="arrow-right">Ver portafolio</Button>
      </header>
      <div class:list={['projects-layout', { 'projects-layout--empty': projects.length === 0 }]}>
        {projects.length > 0 && <div class="featured-project" data-reveal="left"><ProjectCard project={projects[0]} /></div>}
        <div class="project-formats" data-reveal="right">
          {projectFormats.map((item) => (
            <a href={item.href} class="format-card">
              <span><Icon name={item.icon} size={22} /></span>
              <div><h3>{item.title}</h3><p>{item.text}</p></div>
              <Icon name="arrow-right" size={17} />
            </a>
          ))}
        </div>
      </div>
      {projects.length === 0 && <p class="portfolio-note">Estamos documentando proyectos reales para publicarlos con autorización de cada cliente.</p>}
    </div>
  </section>

  <section class="home-panel about-panel" id="empresa">
    <div class="container about-grid">
      <div class="about-copy" data-reveal="left">
        <span class="eyebrow">ClickSolutions</span>
        <h2>Un socio tecnológico, sin complicaciones.</h2>
        <p>Reunimos desarrollo web, drones, soporte y software para que personas y empresas resuelvan sus necesidades con un solo equipo.</p>
        <div class="about-actions">
          <Button href="/contacto" size="lg" iconRight="arrow-right" track="quote_cta" data-track-label="home-final">Hablemos de tu proyecto</Button>
          <Button href="/nosotros" variant="secondary" size="lg">Conocer la empresa</Button>
        </div>
      </div>
      <div class="values" data-reveal="right">
        {values.map((value) => (
          <article><span><Icon name={value.icon} size={21} /></span><div><h3>{value.title}</h3><p>{value.text}</p></div></article>
        ))}
        <div class="availability"><span class="availability__dot"></span><div><strong>¿Tienes una idea?</strong><small>Cuéntanos qué necesitas y te orientamos.</small></div></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 2rem + 7vw, 8rem);
    background: var(--dark-bg);
    color: var(--dark-text);
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 70% 40%, black 20%, transparent 75%);
  }

  .hero::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -15%;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(0 170 231 / 0.2), transparent 62%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  .hero h1 {
    color: var(--dark-text);
    max-width: 16ch;
  }

  .hero__lead {
    max-width: 52ch;
    font-size: var(--fs-md);
    color: var(--dark-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero__services {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-lg);
    background: rgb(23 35 56 / 0.7);
    color: var(--dark-text);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      background-color var(--dur-base);
  }

  .hero-tile:hover {
    border-color: rgb(0 170 231 / 0.6);
    background: var(--dark-card);
    color: var(--dark-text);
    transform: translateY(-2px);
  }

  .hero__services li:nth-child(even) {
    transform: translateY(var(--space-6));
  }

  .hero-tile__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-md);
    background: rgb(0 170 231 / 0.12);
    color: var(--dark-accent);
  }

  .hero-tile__name {
    font-weight: 600;
  }

  .hero-tile__text {
    font-size: var(--fs-sm);
    color: var(--dark-muted);
  }

  .section-header--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: none;
  }

  .muted {
    color: var(--text-muted);
  }

  .inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .inline-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .inline-links a:hover {
    text-decoration: underline;
  }

  .commitment h3 {
    font-size: var(--fs-md);
    margin-bottom: var(--space-2);
  }

  .commitment p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: start;
  }

  @media (max-width: 899px) {
    .hero__inner,
    .faq-layout {
      grid-template-columns: 1fr;
    }

    .faq-layout {
      gap: 0;
    }

    .hero__services li:nth-child(even) {
      transform: none;
    }
  }

  @media (max-width: 479px) {
    .hero__services {
      grid-template-columns: 1fr;
    }

    .hero__actions :global(.btn) {
      width: 100%;
    }
  }

  .home-panel {
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(3.5rem, 7vh, 6rem);
    overflow: hidden;
  }

  .projects-panel {
    background: radial-gradient(circle at 90% 15%, rgb(0 170 231 / 0.08), transparent 28%), var(--bg);
  }

  .panel-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: clamp(1.75rem, 4vh, 3rem);
  }

  .panel-heading h2 { max-width: 15ch; margin: 0; }

  .projects-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(330px, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: stretch;
  }

  .projects-layout--empty { grid-template-columns: 1fr; }
  .featured-project :global(.project-card) { min-height: 360px; }
  .project-formats { display: grid; gap: var(--space-4); }

  .format-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 108px;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, #fff, #f5fbff);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur-base), border-color var(--dur-base), box-shadow var(--dur-base);
  }

  .format-card:hover {
    border-color: #a8ddf3;
    box-shadow: var(--shadow-md);
    color: inherit;
    transform: translateX(6px);
  }

  .format-card > span {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 15px;
    background: linear-gradient(145deg, #daf4ff, #c8e8ff);
    color: var(--brand-blue);
  }

  .format-card h3 { margin: 0 0 4px; font-size: var(--fs-md); }
  .format-card p { margin: 0; color: var(--text-muted); font-size: var(--fs-sm); }
  .format-card > :global(svg) { color: var(--link); }
  .portfolio-note { margin: var(--space-5) 0 0; color: var(--text-muted); font-size: var(--fs-sm); }

  .about-panel {
    background: radial-gradient(circle at 14% 18%, rgb(0 170 231 / 0.2), transparent 26%), linear-gradient(135deg, #031329, #07345f);
    color: var(--dark-text);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.82fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .about-copy .eyebrow { color: var(--dark-accent); }
  .about-copy h2 { max-width: 13ch; color: #fff; font-size: clamp(2.5rem, 5vw, 4.5rem); }
  .about-copy > p { max-width: 54ch; color: var(--dark-muted); font-size: var(--fs-md); }
  .about-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  .values {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--dark-border);
    border-radius: 24px;
    background: rgb(5 27 52 / 0.72);
    box-shadow: 0 38px 80px -42px #000;
    backdrop-filter: blur(16px);
  }

  .values article,
  .availability {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.035);
  }

  .values article > span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border-radius: 13px;
    background: rgb(0 170 231 / 0.13);
    color: var(--dark-accent);
  }

  .values h3 { margin: 0 0 2px; color: #fff; font-size: var(--fs-sm); }
  .values p { margin: 0; color: #8fa9c0; font-size: var(--fs-xs); }

  .availability {
    margin-top: var(--space-2);
    border: 1px solid rgb(81 211 157 / 0.2);
    background: rgb(29 168 105 / 0.08);
  }

  .availability__dot { width: 10px; height: 10px; border-radius: 50%; background: #45df9a; box-shadow: 0 0 16px #45df9a; }
  .availability strong, .availability small { display: block; }
  .availability strong { color: #fff; font-size: var(--fs-sm); }
  .availability small { color: #8fa9c0; font-size: var(--fs-xs); }

  @media (max-width: 860px) {
    .home-panel { min-height: auto; }
    .projects-layout, .about-grid { grid-template-columns: 1fr; }
    .featured-project :global(.project-card) { min-height: 0; }
    .about-grid { gap: var(--space-10); }
  }

  @media (max-width: 560px) {
    .panel-heading { align-items: flex-start; flex-direction: column; }
    .format-card { min-height: 92px; padding: var(--space-4); }
    .about-actions { display: grid; }
    .about-actions :global(.btn) { width: 100%; }
  }
</style>
