---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import SolutionsConstellation from '../components/sections/SolutionsConstellation.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import { getServices, getHomeContent } from '../lib/content';
import type { IconName } from '../components/ui/icons';

const services = getServices();
const home = getHomeContent();


const values: { title: string; text: string; icon: IconName }[] = [
  { title: 'Claridad', text: 'Alcance y precio antes de empezar.', icon: 'clipboard' },
  { title: 'Criterio', text: 'La solución adecuada, no la más complicada.', icon: 'target' },
  { title: 'Confianza', text: 'Software legítimo y datos protegidos.', icon: 'shield' },
];
---

<BaseLayout
  title="ClickSolutions | Tecnología para personas y empresas"
  rawTitle
  description="Soluciones tecnológicas en Perú: drones, desarrollo web, soporte técnico, licencias y herramientas de software para personas y empresas."
>
  <HomeHero services={services} content={home} />

  <section class="home-panel projects-panel" id="proyectos" aria-label="Soluciones de Click Solutions">
    <div class="container panel-inner">
      <SolutionsConstellation />
    </div>
  </section>

  <section class="home-panel about-panel" id="empresa">
    <div class="container about-grid">
      <div class="about-copy" data-reveal="left">
        <span class="eyebrow">{home.aboutEyebrow}</span>
        <h2>{home.aboutTitle}</h2>
        <p>{home.aboutLead}</p>
        <div class="about-actions">
          <Button href="/contacto" size="lg" iconRight="arrow-right" track="quote_cta" data-track-label="home-final">{home.aboutCta}</Button>
        </div>
      </div>
      <div class="values" id="ayuda" data-reveal="right">
        {values.map((value) => (
          <article><span><Icon name={value.icon} size={21} /></span><div><h3>{value.title}</h3><p>{value.text}</p></div></article>
        ))}
        <div class="availability"><span class="availability__help"><Icon name="help" size={19} /></span><div><strong>Ayuda rápida</strong><small>Elige el servicio adecuado y cuéntanos tu objetivo; te orientamos antes de cotizar.</small></div></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 2rem + 7vw, 8rem);
    background: var(--dark-bg);
    color: var(--dark-text);
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 70% 40%, black 20%, transparent 75%);
  }

  .hero::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -15%;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(0 170 231 / 0.2), transparent 62%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  .hero h1 {
    color: var(--dark-text);
    max-width: 16ch;
  }

  .hero__lead {
    max-width: 52ch;
    font-size: var(--fs-md);
    color: var(--dark-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero__services {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-lg);
    background: rgb(23 35 56 / 0.7);
    color: var(--dark-text);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      background-color var(--dur-base);
  }

  .hero-tile:hover {
    border-color: rgb(0 170 231 / 0.6);
    background: var(--dark-card);
    color: var(--dark-text);
    transform: translateY(-2px);
  }

  .hero__services li:nth-child(even) {
    transform: translateY(var(--space-6));
  }

  .hero-tile__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-md);
    background: rgb(0 170 231 / 0.12);
    color: var(--dark-accent);
  }

  .hero-tile__name {
    font-weight: 600;
  }

  .hero-tile__text {
    font-size: var(--fs-sm);
    color: var(--dark-muted);
  }

  .section-header--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: none;
  }

  .muted {
    color: var(--text-muted);
  }

  .inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .inline-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .inline-links a:hover {
    text-decoration: underline;
  }

  .commitment h3 {
    font-size: var(--fs-md);
    margin-bottom: var(--space-2);
  }

  .commitment p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: start;
  }

  @media (max-width: 899px) {
    .hero__inner,
    .faq-layout {
      grid-template-columns: 1fr;
    }

    .faq-layout {
      gap: 0;
    }

    .hero__services li:nth-child(even) {
      transform: none;
    }
  }

  @media (max-width: 479px) {
    .hero__services {
      grid-template-columns: 1fr;
    }

    .hero__actions :global(.btn) {
      width: 100%;
    }
  }

  .home-panel {
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(3.5rem, 7vh, 6rem);
    overflow: hidden;
  }

  .projects-panel {
    background: radial-gradient(circle at 90% 15%, rgb(0 170 231 / 0.08), transparent 28%), var(--bg);
  }

  .panel-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: clamp(1.75rem, 4vh, 3rem);
  }

  .panel-heading h2 { max-width: 15ch; margin: 0; }
  .panel-heading > p { max-width: 28ch; margin: 0; color: var(--text-muted); font-size: var(--fs-sm); text-align: right; }

  .about-panel {
    background: radial-gradient(circle at 14% 18%, rgb(0 170 231 / 0.2), transparent 26%), linear-gradient(135deg, #031329, #07345f);
    color: var(--dark-text);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.82fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .about-copy .eyebrow { color: var(--dark-accent); }
  .about-copy h2 { max-width: 13ch; color: #fff; font-size: clamp(2.5rem, 5vw, 4.5rem); }
  .about-copy > p { max-width: 54ch; color: var(--dark-muted); font-size: var(--fs-md); }
  .about-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  .values {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--dark-border);
    border-radius: 24px;
    background: rgb(5 27 52 / 0.72);
    box-shadow: 0 38px 80px -42px #000;
    backdrop-filter: blur(16px);
  }

  .values article,
  .availability {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.035);
  }

  .values article > span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border-radius: 13px;
    background: rgb(0 170 231 / 0.13);
    color: var(--dark-accent);
  }

  .values h3 { margin: 0 0 2px; color: #fff; font-size: var(--fs-sm); }
  .values p { margin: 0; color: #8fa9c0; font-size: var(--fs-xs); }

  .availability {
    margin-top: var(--space-2);
    border: 1px solid rgb(81 211 157 / 0.2);
    background: rgb(29 168 105 / 0.08);
  }

  .availability__help { display: grid; place-items: center; width: 38px; height: 38px; flex: 0 0 auto; border-radius: 12px; background: rgb(69 223 154 / 0.12); color: #63e8a9; }
  .availability strong, .availability small { display: block; }
  .availability strong { color: #fff; font-size: var(--fs-sm); }
  .availability small { color: #8fa9c0; font-size: var(--fs-xs); }

  @media (max-width: 860px) {
    .home-panel { min-height: auto; }
    .about-grid { grid-template-columns: 1fr; }
    .about-grid { gap: var(--space-10); }
  }

  @media (max-width: 560px) {
    .panel-heading { align-items: flex-start; flex-direction: column; }
    .panel-heading > p { text-align: left; }
    .about-actions { display: grid; }
    .about-actions :global(.btn) { width: 100%; }
  }
</style>
