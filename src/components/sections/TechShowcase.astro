---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

const capabilities: { title: string; text: string; icon: IconName }[] = [
  { title: 'Diseño adaptable', text: 'Experiencias claras en celular, tablet y escritorio.', icon: 'layout' },
  { title: 'Rendimiento', text: 'Sitios ligeros que priorizan una carga rápida.', icon: 'zap' },
  { title: 'Visibilidad', text: 'Estructura preparada para buscadores y contenido.', icon: 'search' },
  { title: 'Acompañamiento', text: 'Del diagnóstico a la publicación y soporte posterior.', icon: 'headset' },
];
---

<section class="section web-lab">
  <div class="container web-lab__inner">
    <div class="web-lab__visual" data-reveal="left">
      <div class="terminal">
        <div class="terminal__bar">
          <div><span></span><span></span><span></span></div>
          <small>clicksolutions — proyecto-web</small>
        </div>
        <div class="terminal__content">
          <p><span class="terminal__prompt">$</span> npm run construir-tu-idea</p>
          <p class="terminal__muted">✓ Analizando objetivos</p>
          <p class="terminal__muted">✓ Diseñando experiencia</p>
          <p class="terminal__muted">✓ Desarrollando solución</p>
          <p><span class="terminal__success">Proyecto listo</span> para crecer <span class="terminal__cursor"></span></p>
        </div>
      </div>
      <div class="web-preview" aria-hidden="true">
        <span></span><span></span><span></span>
        <div></div><div></div>
      </div>
    </div>

    <div class="web-lab__content" data-reveal="right">
      <span class="eyebrow">Desarrollo web</span>
      <h2>No solo hacemos páginas. Construimos herramientas para tu negocio.</h2>
      <p>Desde una presencia corporativa hasta un sistema personalizado, cada proyecto parte de un objetivo real y se construye para funcionar en todos los dispositivos.</p>
      <div class="capabilities">
        {capabilities.map((item) => (
          <article>
            <Icon name={item.icon} size={20} />
            <div><h3>{item.title}</h3><p>{item.text}</p></div>
          </article>
        ))}
      </div>
      <Button href="/servicios/desarrollo-web" variant="on-dark" iconRight="arrow-right">Explorar desarrollo web</Button>
    </div>
  </div>
</section>

<style>
  .web-lab { overflow: hidden; background: var(--dark-bg); color: var(--dark-text); }
  .web-lab::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgb(73 177 231 / 0.14) 1px, transparent 1px); background-size: 26px 26px; mask-image: linear-gradient(to right, black, transparent 65%); }
  .web-lab::after { content: ''; position: absolute; top: -30%; right: -12%; width: 55%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(0 138 255 / 0.13), transparent 67%); }
  .web-lab__inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: center; gap: clamp(3rem, 7vw, 7rem); }
  .web-lab__visual { position: relative; z-index: 1; min-height: 470px; }
  .terminal { position: absolute; top: 0; right: 5%; left: 0; z-index: 2; overflow: hidden; border: 1px solid var(--dark-border); border-radius: 20px; background: #05162b; box-shadow: 0 35px 75px -35px #000; }
  .terminal__bar { display: flex; align-items: center; justify-content: space-between; height: 48px; padding-inline: var(--space-4); border-bottom: 1px solid var(--dark-border); background: rgb(255 255 255 / 0.035); }
  .terminal__bar > div { display: flex; gap: 6px; }
  .terminal__bar span { width: 8px; height: 8px; border-radius: 50%; background: #315474; }
  .terminal__bar span:first-child { background: #ff6470; }
  .terminal__bar span:nth-child(2) { background: #f8bc4b; }
  .terminal__bar span:last-child { background: #20cb7d; }
  .terminal__bar small { color: #7892aa; font: 0.72rem ui-monospace, SFMono-Regular, Consolas, monospace; }
  .terminal__content { display: grid; gap: 16px; padding: clamp(1.5rem, 4vw, 2.6rem); font: clamp(0.78rem, 1.3vw, 0.95rem)/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .terminal__content p { margin: 0; color: #d4e8f8; }
  .terminal__prompt { color: var(--dark-accent); }
  .terminal__content .terminal__muted { color: #7690a8; }
  .terminal__success { color: #4be29a; }
  .terminal__cursor { display: inline-block; width: 8px; height: 1em; margin-left: 4px; vertical-align: -2px; background: var(--dark-accent); animation: blink 1s steps(1) infinite; }
  .web-preview { position: absolute; right: 0; bottom: 0; width: 66%; height: 230px; padding: 30px 24px 20px; border: 1px solid rgb(75 188 240 / 0.28); border-radius: 18px; background: linear-gradient(145deg, #0b4271, #09659a); box-shadow: 0 30px 65px -28px #000; transform: rotate(3deg); }
  .web-preview span { display: block; width: 72%; height: 12px; margin-bottom: 12px; border-radius: 10px; background: rgb(255 255 255 / 0.82); }
  .web-preview span:nth-child(2) { width: 54%; background: rgb(255 255 255 / 0.35); }
  .web-preview span:nth-child(3) { width: 38%; height: 32px; margin-top: 24px; background: var(--brand-cyan); }
  .web-preview div { position: absolute; right: 20px; bottom: 20px; width: 42%; height: 90px; border-radius: 12px; background: rgb(255 255 255 / 0.12); }
  .web-preview div:last-child { right: 38%; bottom: 8px; width: 22%; height: 52px; background: rgb(0 16 32 / 0.22); }
  .web-lab__content { position: relative; z-index: 2; }
  .web-lab__content h2 { max-width: 16ch; color: #fff; }
  .web-lab__content > p { color: var(--dark-muted); font-size: var(--fs-md); }
  .capabilities { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-block: var(--space-8); }
  .capabilities article { display: flex; gap: var(--space-3); }
  .capabilities article > :global(svg) { flex: 0 0 auto; margin-top: 3px; color: var(--dark-accent); }
  .capabilities h3 { margin-bottom: 3px; color: #fff; font-size: var(--fs-sm); }
  .capabilities p { margin: 0; color: #89a3bb; font-size: var(--fs-xs); line-height: 1.5; }

  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 860px) {
    .web-lab__inner { grid-template-columns: 1fr; }
    .web-lab__visual { width: min(100%, 650px); min-height: 430px; }
    .web-lab__content h2 { max-width: 20ch; }
  }

  @media (max-width: 620px) {
    .capabilities { grid-template-columns: 1fr; }
    .web-lab__visual { min-height: 360px; }
    .terminal { right: 0; }
    .web-preview { width: 74%; height: 180px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__cursor { animation: none; }
  }
</style>
