---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import web from '../../data/web-development.json';
---

<div class="web-experience">
  <section class="web-hero web-screen" aria-labelledby="web-hero-title">
    <div class="web-hero__glow" aria-hidden="true"></div>
    <div class="container web-hero__inner">
      <div class="web-hero__copy" data-reveal="left">
        <span class="web-eyebrow"><i></i>{web.hero.eyebrow}</span>
        <h1 id="web-hero-title">{web.hero.title}</h1>
        <p>{web.hero.lead}</p>
        <div class="web-hero__actions">
          <Button href="#soluciones-web" size="lg" variant="on-dark" iconRight="arrow-right">{web.hero.ctaLabel}</Button>
        </div>
        <ul class="web-signals" aria-label="Características principales">
          {web.hero.signals.map((signal) => <li><Icon name="check" size={14} />{signal}</li>)}
        </ul>
      </div>

      <div class="product-lab" data-tabs data-autoplay="4800" data-reveal="right">
        <div class="product-lab__status"><i></i>PROYECTO EN LÍNEA</div>
        <div class="browser-window">
          <div class="browser-window__bar">
            <div class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <span>clicksolutions / producto-digital</span>
          </div>
          <div class="browser-window__tabs" role="tablist" aria-label="Tipos de producto web">
            {web.showcase.map((item, index) => (
              <button
                type="button"
                role="tab"
                id={`showcase-tab-${item.id}`}
                aria-controls={`showcase-panel-${item.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-tab={item.id}
              >{item.label}</button>
            ))}
          </div>
          <div class="browser-window__viewport">
            {web.showcase.map((item, index) => (
              <section
                class="product-view"
                data-kind={item.id}
                data-tab-panel={item.id}
                id={`showcase-panel-${item.id}`}
                role="tabpanel"
                aria-labelledby={`showcase-tab-${item.id}`}
                hidden={index !== 0}
              >
                <div class="product-view__copy">
                  <span>{item.eyebrow}</span>
                  <h2>{item.title}</h2>
                  <small>{item.metric}</small>
                </div>
                <div class="product-view__ui" aria-hidden="true">
                  <i></i><i></i><i></i><i></i><i></i><i></i>
                </div>
              </section>
            ))}
          </div>
        </div>
        <div class="product-lab__badge"><Icon name="shield" size={15} />Diseño + código + publicación</div>
      </div>
    </div>
  </section>

  <section class="web-solutions web-screen" id="soluciones-web" aria-labelledby="solutions-title">
    <div class="container web-screen__inner">
      <header class="web-heading" data-reveal>
        <span class="web-eyebrow web-eyebrow--light"><i></i>Soluciones según tu objetivo</span>
        <div class="web-heading__row">
          <h2 id="solutions-title">Dos planes. Una web preparada para crecer.</h2>
        </div>
      </header>

      <div class="solution-grid">
        {web.solutions.map((solution, index) => (
          <article class:list={["solution-card", { "solution-card--recommended": index === 1 }]} data-kind={solution.id} data-reveal style={`--reveal-delay:${index * 90}ms`}>
            {index === 1 && <span class="solution-card__badge"><i></i>Más recomendado</span>}
            <div class="solution-card__top">
              <span class="solution-card__icon"><Icon name={solution.icon as IconName} size={22} /></span>
            </div>
            <p class="solution-card__eyebrow">{solution.eyebrow}</p>
            <h3>{solution.title}</h3>
            <p class="solution-card__description">{solution.description}</p>
            <ul>
              {solution.includes.map((item) => <li><Icon name="check" size={15} />{item}</li>)}
            </ul>
            <div class="solution-card__meta">
              <strong>{solution.price}</strong>
              <span><Icon name="clock" size={15} />{solution.timing}</span>
            </div>
            <Button
              href={`/contacto?servicio=desarrollo-web&plan=${solution.id}`}
              size="sm"
              variant={index === 1 ? 'primary' : 'secondary'}
              iconRight="arrow-right"
              track="quote_cta"
              data-track-label={`web-plan-${solution.id}`}
            >Elegir este plan</Button>
          </article>
        ))}
      </div>

      <p class="price-note"><Icon name="info" size={16} />{web.priceNote}</p>
    </div>
  </section>

  <section class="web-proof web-screen" aria-labelledby="proof-title">
    <div class="proof-grid" aria-hidden="true"></div>
    <div class="container web-screen__inner web-proof__inner">
      <header class="web-heading web-heading--dark" data-reveal>
        <span class="web-eyebrow"><i></i>Así puede verse tu solución</span>
        <div class="web-heading__row">
          <h2 id="proof-title">Ideas concretas, antes de hablar de funciones.</h2>
          <p>Estas interfaces son demostraciones conceptuales. Sirven para visualizar cómo una web puede resolver necesidades reales sin inventar proyectos de clientes.</p>
        </div>
      </header>

      <div class="proof-layout">
        <div class="demo-console" data-tabs data-reveal="left">
          <div class="demo-console__tabs" role="tablist" aria-label="Demostraciones conceptuales">
            {web.demos.map((demo, index) => (
              <button
                type="button"
                role="tab"
                id={`demo-tab-${demo.id}`}
                aria-controls={`demo-panel-${demo.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-tab={demo.id}
              >{demo.label}</button>
            ))}
          </div>
          <div class="demo-console__viewport">
            {web.demos.map((demo, index) => (
              <section
                class="demo-view"
                data-kind={demo.id}
                data-tab-panel={demo.id}
                id={`demo-panel-${demo.id}`}
                role="tabpanel"
                aria-labelledby={`demo-tab-${demo.id}`}
                hidden={index !== 0}
              >
                <div class="demo-view__copy">
                  <span>DEMO CONCEPTUAL</span>
                  <h3>{demo.title}</h3>
                  <p>{demo.description}</p>
                  <div>{demo.features.map((feature) => <small>{feature}</small>)}</div>
                </div>
                <div class="demo-view__screen" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              </section>
            ))}
          </div>
        </div>

        <div class="delivery-route" data-reveal="right">
          <span class="delivery-route__eyebrow">Proceso ClickSolutions</span>
          <h3>Del objetivo a un producto listo para trabajar.</h3>
          <div class="delivery-route__steps">
            {web.process.map((step, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><strong>{step.title}</strong><p>{step.text}</p></div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <aside class="web-cta" data-reveal>
        <div>
          <span>{web.cta.eyebrow}</span>
          <h2>{web.cta.title}</h2>
          <p>{web.cta.text}</p>
        </div>
        <Button href="/contacto?servicio=desarrollo-web" size="lg" iconRight="arrow-right" track="quote_cta" data-track-label="web-experience-final">{web.cta.label}</Button>
      </aside>
    </div>
  </section>
</div>

<script>
  const initTabs = (group: HTMLElement) => {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-tab-panel]'));
    let activeIndex = Math.max(0, buttons.findIndex((button) => button.getAttribute('aria-selected') === 'true'));
    let timer: number | undefined;

    const activate = (index: number, moveFocus = false) => {
      activeIndex = (index + buttons.length) % buttons.length;
      buttons.forEach((button, buttonIndex) => {
        const active = buttonIndex === activeIndex;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
        if (active && moveFocus) button.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.tabPanel !== buttons[activeIndex]?.dataset.tab; });
    };

    const stop = () => { if (timer) window.clearInterval(timer); };
    const start = () => {
      stop();
      const delay = Number(group.dataset.autoplay);
      if (!delay || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => activate(activeIndex + 1), delay);
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => { activate(index); start(); });
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        activate(activeIndex + (event.key === 'ArrowRight' ? 1 : -1), true);
      });
    });
    group.addEventListener('pointerenter', stop);
    group.addEventListener('pointerleave', start);
    group.addEventListener('focusin', stop);
    group.addEventListener('focusout', start);
    start();
  };

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs);
</script>

<style>
  .web-experience { --web-green: #5ce4a9; --web-blue: #28b7ef; --web-ink: #061a33; }
  .web-screen { position: relative; min-height: calc(100svh - var(--header-h) - 1rem); scroll-snap-align: start; overflow: hidden; isolation: isolate; }
  .web-screen__inner { display: grid; align-content: center; min-height: calc(100svh - var(--header-h) - 1rem); padding-block: clamp(1.5rem, 4vh, 3rem); gap: clamp(1.2rem, 3vh, 2rem); }

  .web-eyebrow { display: inline-flex; align-items: center; gap: 9px; color: var(--web-green); font-size: var(--fs-xs); font-weight: 850; letter-spacing: 0.1em; text-transform: uppercase; }
  .web-eyebrow i { width: 25px; height: 2px; border-radius: 3px; background: currentColor; box-shadow: 0 0 12px currentColor; }
  .web-eyebrow--light { color: #087d82; }

  .web-hero { color: #fff; background: radial-gradient(circle at 83% 18%, rgb(42 198 152 / 0.22), transparent 28%), linear-gradient(132deg, #031426, #06314e 53%, #075943); }
  .web-hero::before { content: ''; position: absolute; inset: 0; z-index: -2; opacity: 0.62; background-image: linear-gradient(rgb(91 228 169 / 0.055) 1px, transparent 1px), linear-gradient(90deg, rgb(91 228 169 / 0.055) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(90deg, black, transparent 88%); }
  .web-hero__glow { position: absolute; right: -13rem; bottom: -19rem; z-index: -1; width: 43rem; aspect-ratio: 1; border: 1px solid rgb(92 228 169 / 0.14); border-radius: 50%; box-shadow: 0 0 0 90px rgb(92 228 169 / 0.025), 0 0 0 180px rgb(40 183 239 / 0.018); }
  .web-hero__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(480px, 1.1fr); align-items: center; min-height: calc(100svh - var(--header-h) - 1rem); gap: clamp(2rem, 6vw, 6rem); padding-block: clamp(2rem, 5vh, 4rem); }
  .web-hero__copy h1 { max-width: 16ch; margin: var(--space-5) 0 var(--space-5); color: #fff; font-size: clamp(2.65rem, 4.6vw, 4.5rem); line-height: 0.94; letter-spacing: -0.045em; }
  .web-hero__copy > p { max-width: 62ch; margin: 0; color: #a9c8d2; font-size: clamp(0.95rem, 1.45vw, 1.14rem); line-height: 1.65; }
  .web-hero__actions { margin-top: var(--space-7); }
  .web-signals { display: flex; flex-wrap: wrap; gap: var(--space-4); margin: var(--space-6) 0 0; padding: 0; list-style: none; }
  .web-signals li { display: flex; align-items: center; gap: 6px; color: #9dbbc5; font-size: 0.7rem; }
  .web-signals :global(svg) { color: var(--web-green); }

  .product-lab { position: relative; min-width: 0; padding: 28px 0 26px; }
  .product-lab__status { position: absolute; top: 0; right: 24px; z-index: 4; display: inline-flex; align-items: center; gap: 7px; padding: 7px 11px; border: 1px solid rgb(92 228 169 / 0.2); border-radius: var(--radius-full); background: rgb(2 24 37 / 0.88); color: #77e9b8; font-size: 0.62rem; font-weight: 850; letter-spacing: 0.06em; }
  .product-lab__status i { width: 7px; height: 7px; border-radius: 50%; background: var(--web-green); box-shadow: 0 0 11px var(--web-green); }
  .browser-window { overflow: hidden; border: 1px solid rgb(103 215 216 / 0.22); border-radius: 24px; background: rgb(2 20 35 / 0.72); box-shadow: 0 42px 80px -42px #000; backdrop-filter: blur(12px); }
  .browser-window__bar { display: flex; align-items: center; gap: var(--space-4); height: 46px; padding-inline: var(--space-4); border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .browser-window__bar > span { margin-left: auto; color: #64879b; font: 0.62rem ui-monospace, SFMono-Regular, Consolas, monospace; }
  .browser-dots { display: flex; gap: 6px; }
  .browser-dots i { width: 7px; height: 7px; border-radius: 50%; background: #ff6b78; }
  .browser-dots i:nth-child(2) { background: #ffc05e; }
  .browser-dots i:nth-child(3) { background: #54df9b; }
  .browser-window__tabs { display: flex; gap: 4px; padding: 9px; border-bottom: 1px solid rgb(255 255 255 / 0.07); }
  .browser-window__tabs button, .demo-console__tabs button { padding: 7px 11px; border: 0; border-radius: 9px; background: transparent; color: #7894a5; font: inherit; font-size: 0.7rem; font-weight: 750; cursor: pointer; }
  .browser-window__tabs button[aria-selected='true'] { background: rgb(92 228 169 / 0.12); color: var(--web-green); }
  .browser-window__tabs button:focus-visible, .demo-console__tabs button:focus-visible { outline: 2px solid var(--web-green); outline-offset: 2px; }
  .browser-window__viewport { min-height: 390px; }
  .product-view { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(200px, 1.05fr); align-items: center; min-height: 390px; padding: clamp(1.5rem, 4vw, 2.8rem); gap: clamp(1rem, 3vw, 2.5rem); animation: view-enter 500ms var(--ease-out) both; }
  .product-view[hidden], .demo-view[hidden] { display: none; }
  .product-view__copy > span { color: var(--web-green); font-size: 0.64rem; font-weight: 850; letter-spacing: 0.11em; text-transform: uppercase; }
  .product-view h2 { max-width: 16ch; margin: 8px 0 var(--space-5); color: #fff; font-size: clamp(1.45rem, 2.45vw, 2.15rem); line-height: 1.05; overflow-wrap: normal; word-break: normal; }
  .product-view small { color: #7e9aaa; font-size: 0.67rem; }
  .product-view__ui { position: relative; min-height: 260px; border: 1px solid rgb(92 228 169 / 0.18); border-radius: 18px; background: linear-gradient(150deg, rgb(10 65 83 / 0.86), rgb(4 34 50 / 0.92)); overflow: hidden; }
  .product-view__ui::before { content: ''; position: absolute; inset: 18px 18px auto; height: 36px; border-radius: 10px; background: rgb(255 255 255 / 0.09); }
  .product-view__ui i { position: absolute; display: block; border-radius: 9px; background: rgb(255 255 255 / 0.11); }
  .product-view__ui i:nth-child(1) { left: 18px; top: 70px; width: 58%; height: 22px; background: rgb(255 255 255 / 0.78); }
  .product-view__ui i:nth-child(2) { left: 18px; top: 104px; width: 42%; height: 9px; }
  .product-view__ui i:nth-child(3) { left: 18px; top: 124px; width: 48%; height: 9px; }
  .product-view__ui i:nth-child(4) { left: 18px; bottom: 24px; width: 28%; height: 38px; background: linear-gradient(90deg, var(--web-green), #2abce7); }
  .product-view__ui i:nth-child(5) { right: 18px; bottom: 22px; width: 34%; height: 130px; }
  .product-view__ui i:nth-child(6) { right: 24px; bottom: 29px; width: 22%; height: 74px; background: rgb(40 183 239 / 0.2); }
  .product-view[data-kind='tienda'] .product-view__ui i:nth-child(1), .product-view[data-kind='tienda'] .product-view__ui i:nth-child(2), .product-view[data-kind='tienda'] .product-view__ui i:nth-child(3) { top: 72px; width: 26%; height: 115px; background: rgb(255 255 255 / 0.1); }
  .product-view[data-kind='tienda'] .product-view__ui i:nth-child(2) { left: 36%; }
  .product-view[data-kind='tienda'] .product-view__ui i:nth-child(3) { left: auto; right: 18px; }
  .product-view[data-kind='tienda'] .product-view__ui i:nth-child(4) { width: 46%; height: 28px; }
  .product-view[data-kind='sistema'] .product-view__ui { background-image: linear-gradient(rgb(92 228 169 / 0.06) 1px, transparent 1px), linear-gradient(90deg, rgb(92 228 169 / 0.06) 1px, transparent 1px); background-size: 28px 28px; }
  .product-view[data-kind='sistema'] .product-view__ui i:nth-child(1) { width: 28%; height: 112px; background: rgb(255 255 255 / 0.09); }
  .product-view[data-kind='sistema'] .product-view__ui i:nth-child(2) { left: 34%; top: 70px; width: 59%; height: 50px; }
  .product-view[data-kind='sistema'] .product-view__ui i:nth-child(3) { left: 34%; top: 132px; width: 59%; height: 50px; }
  .product-lab__badge { position: absolute; left: 24px; bottom: 0; z-index: 4; display: inline-flex; align-items: center; gap: 7px; padding: 8px 11px; border: 1px solid rgb(255 255 255 / 0.14); border-radius: var(--radius-full); background: rgb(2 22 35 / 0.88); color: #c9dce2; font-size: 0.66rem; font-weight: 750; }
  .product-lab__badge :global(svg) { color: var(--web-green); }

  .web-solutions {
    color: #fff;
    background:
      radial-gradient(circle at 83% 18%, rgb(45 196 237 / .18), transparent 27%),
      radial-gradient(circle at 16% 82%, rgb(92 228 169 / .13), transparent 26%),
      linear-gradient(135deg, #04172b, #06354c 58%, #075247);
  }
  .web-solutions::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .45;
    background-image:
      linear-gradient(rgb(68 205 217 / .08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(68 205 217 / .08) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }
  .web-solutions::after {
    content: '';
    position: absolute;
    top: 0;
    left: -35%;
    width: 34%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--web-blue), var(--web-green), transparent);
    box-shadow: 0 0 18px var(--web-blue);
    animation: solution-scan 8s linear infinite;
  }
  .web-solutions .web-eyebrow--light { color: var(--web-green); }
  .web-solutions .web-heading h2 { max-width: 19ch; color: #fff; }
  .web-heading__row { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(320px, 0.55fr); align-items: end; justify-content: space-between; gap: var(--space-8); margin-top: var(--space-3); }
  .web-heading h2 { max-width: 17ch; margin: 0; color: var(--web-ink); font-size: clamp(2rem, 4vw, 3.5rem); line-height: 0.98; }
  .web-heading p { max-width: 56ch; margin: 0; color: #5d7281; font-size: var(--fs-sm); line-height: 1.6; }
  .solution-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: clamp(1rem, 2.4vw, 1.8rem); width: min(100%, 1000px); margin-inline: auto; }
  .solution-card {
    --solution-accent: #58dba4;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 365px;
    padding: clamp(1.35rem, 2.5vw, 2rem);
    overflow: hidden;
    border: 1px solid rgb(103 219 204 / .22);
    border-radius: 24px;
    background: linear-gradient(145deg, rgb(5 35 54 / .92), rgb(6 53 66 / .78));
    box-shadow: 0 30px 80px -48px #000;
    backdrop-filter: blur(12px);
    transition: transform 420ms var(--ease-out), border-color 300ms, box-shadow 420ms;
  }
  .solution-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--solution-accent), var(--web-blue), transparent);
    background-size: 210% 100%;
    animation: plan-line 4.8s linear infinite;
  }
  .solution-card::after {
    content: '';
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 250px;
    aspect-ratio: 1;
    border: 1px solid rgb(92 228 169 / .12);
    border-radius: 50%;
    box-shadow: 0 0 0 38px rgb(92 228 169 / .025), 0 0 0 76px rgb(40 183 239 / .018);
    pointer-events: none;
  }
  .solution-card:hover { transform: translateY(-7px); border-color: rgb(92 228 169 / .5); box-shadow: 0 36px 90px -42px rgb(0 0 0 / .9), 0 0 32px rgb(92 228 169 / .08); }
  .solution-card--recommended {
    --solution-accent: #38c8f2;
    transform: translateY(-10px);
    border-color: rgb(61 207 240 / .58);
    background: linear-gradient(145deg, rgb(6 53 78 / .98), rgb(7 83 78 / .9));
    box-shadow: 0 32px 90px -42px #000, 0 0 38px rgb(40 183 239 / .11);
  }
  .solution-card--recommended:hover { transform: translateY(-15px); border-color: var(--web-green); }
  .solution-card__badge { position: absolute; top: 18px; right: 18px; z-index: 2; display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border: 1px solid rgb(92 228 169 / .28); border-radius: 999px; background: rgb(3 28 43 / .72); color: #8af0c3; font-size: .62rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
  .solution-card__badge i { width: 7px; height: 7px; border-radius: 50%; background: var(--web-green); box-shadow: 0 0 12px var(--web-green); animation: status-pulse 2s ease-in-out infinite; }
  .solution-card__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-5); }
  .solution-card__icon { display: grid; place-items: center; width: 50px; height: 50px; border: 1px solid color-mix(in srgb, var(--solution-accent) 32%, transparent); border-radius: 15px; background: color-mix(in srgb, var(--solution-accent) 14%, transparent); color: var(--solution-accent); box-shadow: 0 0 24px color-mix(in srgb, var(--solution-accent) 14%, transparent); }
  .solution-card__eyebrow { margin: 0 0 5px; color: var(--solution-accent); font-size: 0.66rem; font-weight: 850; letter-spacing: 0.09em; text-transform: uppercase; }
  .solution-card h3 { margin: 0 0 var(--space-3); color: #fff; font-size: clamp(1.7rem, 2.5vw, 2.35rem); }
  .solution-card__description { max-width: 47ch; margin: 0 0 var(--space-5); color: #a7c1ca; font-size: 0.82rem; line-height: 1.5; }
  .solution-card ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .solution-card li { display: flex; align-items: flex-start; gap: 8px; color: #d0e0e5; font-size: 0.76rem; }
