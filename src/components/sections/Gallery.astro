---
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import type { GalleryItem } from '../../data/services';
import type { IconName } from '../ui/icons';

interface Props {
  items: GalleryItem[];
  /** Texto del estado vacío (cuando aún no hay trabajos reales). */
  emptyText?: string;
  placeholderIcon?: IconName;
}

const {
  items,
  emptyText = 'Pronto publicaremos aquí trabajos reales.',
  placeholderIcon = 'image',
} = Astro.props;
---

{
  items.length > 0 ? (
    <ul class="gallery">
      {items.map((item) => (
        <li>
          <figure>
            <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  ) : (
    <div class="gallery-empty">
      <ul class="gallery" aria-hidden="true">
        {[1, 2, 3].map(() => (
          <li>
            <ImagePlaceholder icon={placeholderIcon} label="Trabajo real pendiente" />
          </li>
        ))}
      </ul>
      <p class="gallery-empty__text">{emptyText}</p>
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  figure {
    margin: 0;
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .gallery-empty__text {
    margin: var(--space-4) 0 0;
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
</style>
