---
import Icon from '../ui/Icon.astro';
import type { ServiceSlug } from '../../data/services';
import droneQuote from '../../data/drone-quote.json';

interface Plan {
  name: string;
  eyebrow: string;
  price: string;
  timing: string;
  support: string;
  description: string;
  includes: string[];
  featured?: boolean;
}

interface Props {
  service: Extract<ServiceSlug, 'drones' | 'desarrollo-web'>;
}

const { service } = Astro.props;

const dronePlans: Plan[] = droneQuote.packages.map((plan) => ({
  name: plan.name,
  eyebrow: plan.eyebrow,
  price: plan.priceLabel,
  timing: plan.timing,
  support: plan.support,
  description: plan.description,
  includes: plan.includes,
  featured: plan.featured,
}));

const plans: Record<Props['service'], Plan[]> = {
  'desarrollo-web': [
    {
      eyebrow: 'Presencia profesional',
      name: 'Web corporativa',
      price: 'Desde USD 750',
      timing: '2–3 semanas',
      support: '30 días de soporte',
      description: 'Para presentar la empresa, sus servicios y recibir consultas con una imagen sólida.',
      includes: ['Diseño adaptable a celular', 'Contenido autoadministrable', 'Formulario y WhatsApp', 'SEO y publicación inicial'],
    },
    {
      eyebrow: 'Operación organizada',
      name: 'Web + gestión interna',
      price: 'Desde USD 1,600',
      timing: '5–6 semanas',
      support: '60 días de soporte',
      description: 'Suma un panel privado para centralizar clientes, solicitudes y seguimiento del equipo.',
      includes: ['Todo el plan corporativo', 'Usuarios y permisos', 'Registros y estados', 'Panel e informes esenciales'],
      featured: true,
    },
    {
      eyebrow: 'Escala y automatización',
      name: 'Plataforma premium',
      price: 'Desde USD 2,600',
      timing: '7–8 semanas',
      support: '90 días de soporte',
      description: 'Una solución a medida para procesos, automatizaciones, pagos o integraciones avanzadas.',
      includes: ['Flujos personalizados', 'Automatizaciones', 'Pagos o integraciones', 'Paneles y capacitación'],
    },
  ],
  drones: dronePlans,
};

const items = plans[service];
const note = service === 'desarrollo-web'
  ? 'Precios referenciales basados en un alcance estándar. Dominio, hosting, servicios de terceros, impuestos y funciones fuera del alcance se cotizan por separado.'
  : droneQuote.note;
---

<div class="plans-shell" data-service={service}>
  <div class="plans">
    {items.map((plan) => (
      <article class:list={['plan', { 'plan--featured': plan.featured }]}>
        {plan.featured && <span class="plan__flag">Recomendado</span>}
        <p class="plan__eyebrow">{plan.eyebrow}</p>
        <h3>{plan.name}</h3>
        <p class="plan__price">{plan.price}</p>
        <p class="plan__description">{plan.description}</p>
        <div class="plan__meta">
          <span><Icon name="clock" size={16} />{plan.timing}</span>
          <span><Icon name="shield" size={16} />{plan.support}</span>
        </div>
        <ul>
          {plan.includes.map((item) => <li><Icon name="check" size={16} />{item}</li>)}
        </ul>
      </article>
    ))}
  </div>
  <p class="plans-note"><Icon name="info" size={16} />{note}</p>
  {service === 'drones' && (
    <div class="drone-conditions">
      <section>
        <span class="drone-conditions__eyebrow">Servicios adicionales</span>
        <div class="addon-list">
          {droneQuote.addons.map((addon) => (
            <article>
              <div><strong>{addon.name}</strong><small>{addon.description}</small></div>
              <b>+ S/ {addon.price.toFixed(2)}</b>
            </article>
          ))}
        </div>
      </section>
      <details>
        <summary>Condiciones principales del servicio</summary>
        <ol>
          {droneQuote.terms.map((term) => <li><strong>{term.title}:</strong> {term.text}</li>)}
        </ol>
      </details>
    </div>
  )}
</div>

<style>
  .plans-shell { --plan-accent: var(--brand-blue); --plan-soft: #ecf9ff; display: grid; gap: var(--space-4); }
  .plans-shell[data-service='drones'] { --plan-accent: #0c9fbd; --plan-soft: #eafafd; }
  .plans-shell[data-service='desarrollo-web'] { --plan-accent: #138a62; --plan-soft: #eefbf5; }
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 390px;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: linear-gradient(145deg, #fff, #f5faff);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base), box-shadow var(--dur-base);
  }

  .plan::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--plan-accent) 58%, #fff), var(--plan-accent));
    opacity: 0.45;
  }

  .plan:hover { transform: translateY(-4px); border-color: #a8ddf3; box-shadow: var(--shadow-md); }
  .plan--featured { border-color: color-mix(in srgb, var(--plan-accent) 48%, #fff); background: linear-gradient(155deg, #fff, var(--plan-soft)); }
  .plan--featured::before { height: 5px; opacity: 1; }

  .plan__flag {
    position: absolute;
    top: 15px;
    right: 15px;
    padding: 5px 9px;
    border-radius: var(--radius-full);
    background: var(--plan-accent);
    color: #fff;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .plan__eyebrow { margin: 0 0 8px; color: var(--plan-accent); font-size: var(--fs-xs); font-weight: 750; text-transform: uppercase; letter-spacing: 0.06em; }
  .plan h3 { max-width: 14ch; margin-bottom: var(--space-2); font-size: var(--fs-lg); }
  .plan__price { margin: 0 0 var(--space-4); color: var(--brand-ink); font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 820; }
  .plan__description { color: var(--text-muted); font-size: var(--fs-sm); }
  .plan__meta { display: grid; gap: 7px; margin-bottom: var(--space-4); padding-block: var(--space-3); border-block: 1px solid var(--border); }
  .plan__meta span, .plan li { display: flex; align-items: flex-start; gap: 8px; font-size: var(--fs-xs); }
  .plan__meta :global(svg), .plan li :global(svg) { flex: 0 0 auto; margin-top: 1px; color: var(--plan-accent); }
  .plan ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .plans-note { display: flex; gap: 8px; margin: 0; color: var(--text-muted); font-size: var(--fs-xs); }
  .plans-note :global(svg) { flex: 0 0 auto; margin-top: 2px; color: var(--link); }

  .drone-conditions { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr); gap: var(--space-4); margin-top: var(--space-2); }
  .drone-conditions > section,
  .drone-conditions > details { min-width: 0; padding: var(--space-5); border: 1px solid #bde8ef; border-radius: 20px; background: linear-gradient(145deg, #f7fdfe, #eaf9fc); }
  .drone-conditions__eyebrow { display: block; margin-bottom: var(--space-3); color: #087f99; font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .addon-list { display: grid; gap: 1px; overflow: hidden; border: 1px solid #cae9ef; border-radius: 14px; background: #cae9ef; }
  .addon-list article { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: 11px 13px; background: #fff; }
  .addon-list strong,
  .addon-list small { display: block; }
  .addon-list strong { color: var(--brand-ink); font-size: var(--fs-sm); }
  .addon-list small { margin-top: 2px; color: var(--text-muted); font-size: var(--fs-xs); }
  .addon-list b { flex: 0 0 auto; color: #075d71; font-size: var(--fs-sm); }
  .drone-conditions summary { color: var(--brand-ink); font-weight: 750; cursor: pointer; }
  .drone-conditions ol { display: grid; gap: var(--space-3); margin: var(--space-4) 0 0; padding-left: 1.15rem; color: var(--text-muted); font-size: var(--fs-xs); }
  .drone-conditions li::marker { color: #0c9fbd; font-weight: 800; }

  @media (max-width: 860px) {
    .plans { grid-template-columns: 1fr; }
    .plan { min-height: 0; }
    .drone-conditions { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .addon-list article { align-items: flex-start; flex-direction: column; gap: 5px; }
  }
</style>
