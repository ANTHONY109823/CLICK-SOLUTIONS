---
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import type { ServiceSlug } from '../../data/services';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  breadcrumbs?: { label: string; href: string }[];
  /** Hero compacto para páginas secundarias. */
  compact?: boolean;
  /** Identidad visual de cada línea de servicio. */
  theme?: ServiceSlug;
}

const { eyebrow, title, lead, breadcrumbs, compact = false, theme } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', { 'page-hero--compact': compact }]} data-theme={theme}>
  <div class:list={['container', 'page-hero__inner', { 'page-hero__inner--split': hasAside }]}>
    <div class="page-hero__content">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} dark />}
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      {
        Astro.slots.has('actions') && (
          <div class="page-hero__actions">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      hasAside && (
        <div class="page-hero__aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    --hero-accent: var(--brand-cyan);
    --hero-accent-2: var(--brand-blue);
    --hero-grid: rgb(255 255 255 / 0.035);
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    background:
      linear-gradient(125deg, color-mix(in srgb, var(--hero-accent) 8%, transparent), transparent 45%),
      linear-gradient(135deg, #031329, #07345f);
    color: var(--dark-text);
    isolation: isolate;
  }

  /* Retícula sutil + un único resplandor de marca. */
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--hero-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .page-hero::after {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    z-index: -1;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--hero-accent) 32%, transparent), transparent 65%);
  }

  .page-hero[data-theme='drones'] {
    --hero-accent: #72e7ff;
    --hero-accent-2: #18a9da;
    background:
      linear-gradient(180deg, transparent 58%, rgb(7 92 112 / 0.24)),
      radial-gradient(ellipse at 74% 18%, rgb(121 231 255 / 0.25), transparent 31%),
      linear-gradient(132deg, #031725, #07536d 58%, #0b7891);
  }

  .page-hero[data-theme='drones']::before {
    background-image:
      linear-gradient(rgb(114 231 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(114 231 255 / 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(420px) rotateX(54deg) scale(1.35) translateY(30%);
    transform-origin: bottom;
  }

  .page-hero[data-theme='desarrollo-web'] {
    --hero-accent: #62e8ae;
    --hero-accent-2: #21a7ff;
    background:
      radial-gradient(circle at 75% 34%, rgb(31 190 141 / 0.18), transparent 28%),
      linear-gradient(132deg, #031427, #07304f 54%, #07543f);
  }

  .page-hero[data-theme='soporte-tecnico'] {
    --hero-accent: #89baff;
    --hero-accent-2: #6979ff;
    background:
      radial-gradient(circle at 78% 28%, rgb(92 116 255 / 0.22), transparent 31%),
      linear-gradient(132deg, #071328, #12294f 54%, #263b7b);
  }

  .page-hero[data-theme='licencias-software'] {
    --hero-accent: #d0f65c;
    --hero-accent-2: #59cde8;
    --hero-grid: rgb(208 246 92 / 0.04);
    background:
      radial-gradient(circle at 78% 28%, rgb(194 239 70 / 0.17), transparent 29%),
      linear-gradient(132deg, #090d22, #10243c 54%, #183e49);
  }

  .page-hero--compact {
    padding-block: clamp(1.75rem, 3.5vw, 3.25rem);
  }

  .page-hero__inner--split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-12);
    align-items: center;
  }

  .page-hero--compact .page-hero__inner--split {
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .page-hero__content {
    max-width: 760px;
  }

  .page-hero__content::before {
    content: '';
    display: block;
    width: 72px;
    height: 4px;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--hero-accent), var(--hero-accent-2));
    box-shadow: 0 0 22px color-mix(in srgb, var(--hero-accent) 48%, transparent);
  }

  h1 {
    color: var(--dark-text);
  }

  .page-hero--compact h1 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 4.2vw, 4rem);
  }

  .page-hero__lead {
    max-width: 62ch;
    font-size: var(--fs-md);
    color: var(--dark-muted);
  }

  .page-hero[data-theme] :global(.eyebrow) { color: var(--hero-accent); }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  @media (max-width: 680px) {
    .page-hero__inner--split {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .page-hero[data-theme='drones']::before { transform: none; }
  }
</style>
