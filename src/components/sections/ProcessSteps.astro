---
import type { Step } from '../../data/services';

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="steps" style={`--steps: ${steps.length}`}>
  {
    steps.map((step, index) => (
      <li class="step">
        <span class="step__number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3 class="step__title">{step.title}</h3>
        <p class="step__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding: var(--space-8) var(--space-6) var(--space-6);
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, #fff, #fbfdff);
  }

  .step::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-cyan), var(--brand-blue));
    transform: scaleX(0.22);
    transform-origin: left;
  }

  .step + .step {
    border-left: 1px solid var(--border);
  }

  .step__number {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: var(--space-3);
    font-size: var(--fs-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--link);
    border: 1px solid #bde7f7;
    border-radius: 13px;
    background: var(--info-bg);
  }

  .step__title {
    font-size: var(--fs-md);
    margin-bottom: var(--space-2);
  }

  .step__text {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  :global(.section--dark) .step {
    border-color: var(--dark-border);
    background: var(--dark-surface);
  }

  :global(.section--dark) .step__number {
    color: var(--dark-accent);
  }

  :global(.section--dark) .step__text {
    color: var(--dark-muted);
  }

  @media (max-width: 780px) {
    .steps { grid-template-columns: 1fr 1fr; gap: var(--space-4); }
    .step { border: 1px solid var(--border); border-radius: var(--radius-lg); }
  }

  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
