---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Service } from '../../data/services';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<section class="hero">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content" data-reveal="left">
      <span class="hero__badge"><span></span> Tecnología para personas y empresas</span>
      <h1>Convertimos tus ideas en <strong>soluciones reales.</strong></h1>
      <p class="hero__lead">
        Desarrollo web, producción aérea, soporte técnico y software original desde un mismo equipo.
      </p>
      <div class="hero__actions">
        <Button href="#servicios" variant="on-dark" size="lg" iconRight="arrow-right" track="explore_services">
          Ver nuestros servicios
        </Button>
      </div>
      <div class="hero__assurance" aria-label="Nuestra forma de trabajar">
        <span><Icon name="check" size={16} /> Propuesta clara</span>
        <span><Icon name="check" size={16} /> Atención personalizada</span>
        <span><Icon name="check" size={16} /> Software legítimo</span>
      </div>
    </div>

    <div class="hero-visual" data-reveal="right" data-tilt>
      <div class="browser-window">
        <div class="browser-window__bar">
          <div class="browser-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span class="browser-url">clicksolutions.pe</span>
          <span class="browser-status">EN LÍNEA</span>
        </div>
        <div class="browser-window__body">
          <div class="code-card">
            <div class="code-card__top"><span>soluciones.ts</span><span>●</span></div>
            <div class="code-lines" aria-hidden="true">
              <span><i>01</i><b>const</b> idea = <em>'tu proyecto'</em>;</span>
              <span><i>02</i><b>const</b> equipo = <em>'ClickSolutions'</em>;</span>
              <span><i>03</i></span>
              <span><i>04</i><b>function</b> crearSolucion() {'{'}</span>
              <span><i>05</i>&nbsp;&nbsp;<b>return</b> idea + experiencia;</span>
              <span><i>06</i>{'}'}</span>
            </div>
          </div>
          <div class="visual-copy">
            <span>DESARROLLO WEB</span>
            <strong>Tu idea.<br />Una web real.</strong>
            <i></i>
            <p>Experiencias rápidas, modernas y listas para crecer.</p>
          </div>
        </div>
      </div>
      <div class="floating-chip floating-chip--top"><Icon name="code" size={18} /> Desarrollo</div>
      <div class="floating-chip floating-chip--bottom"><Icon name="shield" size={18} /> Tecnología confiable</div>
    </div>
  </div>

  <div class="container service-ribbon" id="servicios" data-reveal>
    {
      services.map((service) => (
        <a href={`/servicios/${service.slug}`} class="service-ribbon__item" data-service={service.slug}>
          <span class="service-ribbon__icon"><Icon name={service.icon} size={24} /></span>
          <span>
            <strong>{service.name}</strong>
            <small>{service.tagline}</small>
          </span>
          <Icon name="arrow-right" size={18} class="service-ribbon__arrow" />
        </a>
      ))
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(1.75rem, 4vh, 3.25rem) 0;
    background:
      radial-gradient(circle at 82% 25%, rgb(0 170 231 / 0.2), transparent 27%),
      linear-gradient(128deg, #031126 0%, #05264a 56%, #06345f 100%);
    color: var(--dark-text);
    isolation: isolate;
  }

  .hero::after {
    content: '';
    position: absolute;
    right: -13%;
    bottom: 8%;
    z-index: -1;
    width: 46%;
    aspect-ratio: 1;
    border: 1px solid rgb(99 208 249 / 0.16);
    border-radius: 50%;
    box-shadow: 0 0 0 80px rgb(0 170 231 / 0.025), 0 0 0 160px rgb(0 170 231 / 0.02);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgb(94 190 241 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(94 190 241 / 0.06) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to right, black, transparent 82%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(440px, 1.08fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding-bottom: clamp(1.75rem, 4vh, 3rem);
  }

  .hero__content { position: relative; z-index: 2; }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding: 7px 12px;
    border: 1px solid rgb(69 199 246 / 0.27);
    border-radius: var(--radius-full);
    background: rgb(2 35 67 / 0.56);
    color: #caeafd;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__badge > span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-cyan);
    box-shadow: 0 0 14px var(--brand-cyan);
    animation: pulse 2.2s ease-in-out infinite;
  }

  h1 {
    max-width: 12ch;
    margin-bottom: var(--space-6);
    color: #fff;
    font-size: clamp(2.9rem, 4.8vw, 5.3rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  h1 strong {
    display: block;
    color: transparent;
    background: linear-gradient(100deg, #57d5ff 5%, #45a3ff 52%, #74f2ff 100%);
    background-clip: text;
  }

  .hero__lead {
    max-width: 55ch;
    margin-bottom: var(--space-8);
    color: #b8ccdf;
    font-size: clamp(1.08rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.65;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero__actions :global(.btn--on-dark) { background: linear-gradient(135deg, var(--brand-cyan), var(--brand-blue)); box-shadow: 0 16px 38px -18px rgb(0 170 231 / 0.9); }

  .hero__assurance { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); margin-top: var(--space-8); color: #93abc1; font-size: var(--fs-xs); }
  .hero__assurance span { display: inline-flex; align-items: center; gap: 6px; }
  .hero__assurance :global(svg) { color: var(--dark-accent); }

  .hero-visual { position: relative; perspective: 1000px; transition: transform 350ms var(--ease-out); }
  .browser-window { overflow: hidden; border: 1px solid rgb(83 185 237 / 0.28); border-radius: 22px; background: rgb(4 20 40 / 0.78); box-shadow: 0 45px 90px -35px rgb(0 0 0 / 0.8), 0 0 70px rgb(0 170 231 / 0.1); backdrop-filter: blur(18px); transform: rotateY(-4deg) rotateX(1.5deg); }
  .browser-window__bar { display: flex; align-items: center; gap: var(--space-4); min-height: 48px; padding-inline: var(--space-4); border-bottom: 1px solid rgb(83 185 237 / 0.16); background: rgb(255 255 255 / 0.035); }
  .browser-dots { display: flex; gap: 6px; }
  .browser-dots span { width: 8px; height: 8px; border-radius: 50%; background: #2c5375; }
  .browser-dots span:first-child { background: #ff6b72; }
  .browser-dots span:nth-child(2) { background: #ffbd55; }
  .browser-dots span:last-child { background: #27d17f; }
  .browser-url { flex: 1; color: #7995ae; font-size: 0.72rem; text-align: center; }
  .browser-status { color: #42dc9b; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.09em; }

  .browser-window__body { display: grid; grid-template-columns: 1.12fr 0.88fr; min-height: 290px; padding: clamp(1rem, 2.2vw, 1.7rem); background: linear-gradient(145deg, rgb(0 170 231 / 0.055), transparent 45%), radial-gradient(circle at 82% 32%, rgb(0 130 255 / 0.14), transparent 32%); }
  .code-card { align-self: center; overflow: hidden; border: 1px solid rgb(102 185 230 / 0.16); border-radius: 14px; background: #041428; box-shadow: var(--shadow-lg); }
  .code-card__top { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid rgb(102 185 230 / 0.14); color: #829bb2; font: 0.68rem/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .code-card__top span:last-child { color: #20ce83; }
  .code-lines { display: grid; gap: 11px; padding: 20px 15px 22px; color: #c7d9e9; font: 0.72rem/1.45 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .code-lines span { white-space: nowrap; }
  .code-lines i { display: inline-block; width: 28px; color: #355675; font-style: normal; }
  .code-lines b { color: #4cc9ff; font-weight: 600; }
  .code-lines em { color: #77e9a8; font-style: normal; }
  .visual-copy { align-self: center; padding-left: clamp(1rem, 3vw, 2.1rem); }
  .visual-copy > span { color: var(--dark-accent); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em; }
  .visual-copy strong { display: block; margin-block: var(--space-3); color: #fff; font-size: clamp(1.55rem, 2.6vw, 2.35rem); line-height: 1.02; letter-spacing: -0.04em; }
  .visual-copy i { display: block; width: 52px; height: 3px; margin-block: var(--space-4); border-radius: 10px; background: linear-gradient(90deg, var(--brand-cyan), var(--brand-blue)); }
  .visual-copy p { margin: 0; color: #8fa8be; font-size: 0.82rem; line-height: 1.55; }

  .floating-chip { position: absolute; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid rgb(112 205 248 / 0.28); border-radius: var(--radius-full); background: rgb(4 27 53 / 0.9); box-shadow: 0 16px 34px rgb(0 0 0 / 0.28); color: #e5f5ff; font-size: var(--fs-xs); font-weight: 700; backdrop-filter: blur(14px); animation: float 5s ease-in-out infinite; }
  .floating-chip :global(svg) { color: var(--dark-accent); }
  .floating-chip--top { top: -20px; right: 36px; }
  .floating-chip--bottom { bottom: -20px; left: 34px; animation-delay: -2s; }

  .service-ribbon { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); position: relative; z-index: 3; }
  .service-ribbon__item { --tile-accent: var(--brand-cyan); --tile-deep: #07315b; position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-3); min-height: 92px; padding: var(--space-4); overflow: hidden; border: 1px solid color-mix(in srgb, var(--tile-accent) 25%, transparent); border-bottom: 0; background: linear-gradient(145deg, var(--tile-deep), #051c37); color: #fff; text-decoration: none; transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base); }
  .service-ribbon__item[data-service='drones'] { --tile-accent: #63e5ff; --tile-deep: #07536b; }
  .service-ribbon__item[data-service='desarrollo-web'] { --tile-accent: #5ee1aa; --tile-deep: #075044; }
  .service-ribbon__item[data-service='soporte-tecnico'] { --tile-accent: #86a7ff; --tile-deep: #263e79; }
  .service-ribbon__item[data-service='licencias-software'] { --tile-accent: #c9ef5a; --tile-deep: #374f42; }
  .service-ribbon__item:first-child { border-radius: 20px 0 0; }
  .service-ribbon__item:last-child { border-radius: 0 20px 0 0; }
  .service-ribbon__item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(125deg, color-mix(in srgb, var(--tile-accent) 24%, transparent), transparent 48%); opacity: 0; transition: opacity var(--dur-base); }
  .service-ribbon__item:hover { z-index: 2; transform: translateY(-8px); border-color: color-mix(in srgb, var(--tile-accent) 55%, transparent); color: #fff; }
  .service-ribbon__item:hover::after { opacity: 1; }
  .service-ribbon__icon { display: grid; place-items: center; position: relative; z-index: 1; width: 48px; height: 48px; border-radius: 50%; background: var(--tile-accent); color: #03162b; box-shadow: 0 12px 26px -12px color-mix(in srgb, var(--tile-accent) 78%, transparent); }
  .service-ribbon__item > span:nth-child(2) { position: relative; z-index: 1; min-width: 0; }
  .service-ribbon strong, .service-ribbon small { display: block; }
  .service-ribbon strong { margin-bottom: 4px; font-size: var(--fs-sm); }
  .service-ribbon small { color: #92acc3; font-size: 0.68rem; line-height: 1.35; }
  .service-ribbon__item :global(.service-ribbon__arrow) { position: relative; z-index: 1; color: var(--tile-accent); transition: transform var(--dur-fast); }
  .service-ribbon__item:hover :global(.service-ribbon__arrow) { transform: translateX(4px); }

  @keyframes pulse { 50% { opacity: 0.45; box-shadow: 0 0 4px var(--brand-cyan); } }
  @keyframes float { 50% { transform: translateY(-8px); } }

  @media (max-width: 1080px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr) minmax(380px, 0.9fr); gap: 3rem; }
    h1 { font-size: clamp(2.7rem, 5vw, 4.2rem); }
    .browser-window__body { min-height: 350px; }
    .service-ribbon { grid-template-columns: repeat(2, 1fr); }
    .service-ribbon__item:nth-child(2) { border-radius: 0 20px 0 0; }
    .service-ribbon__item:last-child { border-radius: 0; }
  }

  @media (max-width: 860px) {
    .hero { min-height: auto; padding-top: 3rem; }
    .hero__inner { grid-template-columns: 1fr; }
    .hero__content { max-width: 680px; }
    h1 { max-width: 13ch; }
    .hero-visual { display: none; }
  }

  @media (max-width: 620px) {
    .hero__actions { display: grid; }
    .hero__actions :global(.btn) { width: 100%; }
    .hero__assurance { display: grid; gap: var(--space-2); }
    .browser-window { border-radius: 16px; transform: none; }
    .browser-window__body { grid-template-columns: 1fr; min-height: auto; }
    .visual-copy { padding: var(--space-6) 0 0; }
    .floating-chip { display: none; }
    .service-ribbon { grid-auto-flow: column; grid-auto-columns: minmax(82vw, 1fr); grid-template-columns: none; overflow-x: auto; padding-inline: var(--gutter); scroll-snap-type: x proximity; }
    .service-ribbon__item, .service-ribbon__item:first-child, .service-ribbon__item:nth-child(2), .service-ribbon__item:last-child { min-height: 88px; border-radius: 16px 16px 0 0; scroll-snap-align: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__badge > span, .floating-chip { animation: none; }
    .hero-visual { transform: none !important; }
  }
</style>

<script>
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  const canTilt = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches;
  if (tilt && canTilt) {
    tilt.addEventListener('pointermove', (event) => {
      const rect = tilt.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      tilt.style.transform = `rotateX(${y * -3}deg) rotateY(${x * 4}deg)`;
    });
    tilt.addEventListener('pointerleave', () => { tilt.style.transform = ''; });
  }
</script>
