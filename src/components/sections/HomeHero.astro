---
import Button from '../ui/Button.astro';
import HeroWorkShowcase from './HeroWorkShowcase.astro';
import Icon from '../ui/Icon.astro';
import type { Service } from '../../data/services';
import type { HomeContent } from '../../lib/content';

interface Props {
  services: Service[];
  content: HomeContent;
}

const { services, content } = Astro.props;
---

<section class="hero">
  <div class="hero__grid" aria-hidden="true"></div>
  <svg class="hero__traces" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 170H230L320 260H650L790 120H1440M0 650H290L410 530H850L1040 720H1440M760 0V180L900 320V900" />
  </svg>
  <svg class="hero__orbit" viewBox="0 0 600 600" aria-hidden="true">
    <circle class="orbit-track" cx="300" cy="300" r="270" />
    <g class="orbit-spin"><circle class="orbit-arc" cx="300" cy="300" r="270" /><circle class="orbit-dot" cx="300" cy="30" r="5" /><circle class="orbit-dot orbit-dot--small" cx="300" cy="570" r="3" /></g>
    <g class="orbit-spin orbit-spin--reverse"><circle class="orbit-inner" cx="300" cy="300" r="226" /><circle class="orbit-dot" cx="74" cy="300" r="3" /></g>
  </svg>
  <div class="container hero__inner">
    <div class="hero__content" data-reveal="left">
      <span class="hero__badge"><span></span> {content.badge}</span>
      <h1>{content.title} <strong>{content.titleAccent}</strong></h1>
      <p class="hero__lead">
        {content.lead}
      </p>
      <div class="hero__actions">
        <Button href="#servicios" variant="on-dark" size="lg" iconRight="arrow-right" track="explore_services">
          Ver nuestros servicios
        </Button>
      </div>
      <div class="hero__assurance" aria-label="Nuestra forma de trabajar">
        <span><Icon name="check" size={16} /> Propuesta clara</span>
        <span><Icon name="check" size={16} /> Atención personalizada</span>
        <span><Icon name="check" size={16} /> Acompañamiento cercano</span>
      </div>
    </div>

    <div class="hero-visual" data-reveal="right"><HeroWorkShowcase /></div>
  </div>

  <div class="service-showcase" id="servicios" data-carousel data-carousel-autoplay="5000" data-reveal>
    <div class="container service-showcase__bar">
      <span>Explora cada especialidad</span>
      <div class="carousel-controls" aria-label="Cambiar servicio destacado">
        <span class="carousel-status" aria-live="polite" data-carousel-status>1 de {services.length}</span>
        <button type="button" aria-label="Servicio anterior" data-carousel-prev><Icon name="arrow-right" size={17} /></button>
        <button type="button" aria-label="Servicio siguiente" data-carousel-next><Icon name="arrow-right" size={17} /></button>
      </div>
    </div>
    <div class="container service-ribbon" data-carousel-track tabindex="0" aria-label="Servicios de ClickSolutions">
      {
        services.map((service) => (
          <a href={`/servicios/${service.slug}`} class="service-ribbon__item" data-service={service.slug} data-carousel-item>
            <span class="service-ribbon__icon"><Icon name={service.icon} size={24} /></span>
            <span>
              <strong>{service.name}</strong>
              <small>{service.tagline}</small>
            </span>
            <Icon name="arrow-right" size={18} class="service-ribbon__arrow" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(1.75rem, 4vh, 3.25rem) 0;
    background:
      radial-gradient(circle at 82% 25%, rgb(0 170 231 / 0.2), transparent 27%),
      linear-gradient(128deg, #031126 0%, #05264a 56%, #06345f 100%);
    color: var(--dark-text);
    isolation: isolate;
  }

  .hero__traces { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
  .hero__traces path { fill: none; stroke: #34c8ff; stroke-width: 1; stroke-dasharray: 45 380; opacity: .25; animation: trace-flow 14s linear infinite; }
  .hero__orbit { position: absolute; z-index: -1; width: min(80vw, 950px); right: -12%; top: -7%; opacity: .65; pointer-events: none; overflow: visible; }
  .orbit-track { fill: none; stroke: #63d0f926; stroke-width: .6; }
  .orbit-spin { transform-origin: 300px 300px; animation: orbit-turn 35s linear infinite; }
  .orbit-spin--reverse { animation-direction: reverse; animation-duration: 48s; }
  .orbit-arc { fill: none; stroke: #35c8ff; stroke-width: 1.4; stroke-dasharray: 100 450 25 1121; opacity: .55; }
  .orbit-inner { fill: none; stroke: #5cdfff; stroke-width: .6; stroke-dasharray: 2 16; opacity: .35; }
  .orbit-dot { fill: #5ae5ff; filter: drop-shadow(0 0 6px #00aae7); }
  .orbit-dot--small { fill: #087ff5; }
  @keyframes orbit-turn { to { transform: rotate(360deg); } }
  @keyframes trace-flow { to { stroke-dashoffset: -1700; } }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgb(94 190 241 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(94 190 241 / 0.06) 1px, transparent 1px);
    background-size: 52px 52px; animation: grid-drift 32s linear infinite;
    mask-image: linear-gradient(to right, black, transparent 82%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(440px, 1.08fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(1.75rem, 4vh, 3rem);
  }

  .hero__content { position: relative; z-index: 2; }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding: 7px 12px;
    border: 1px solid rgb(69 199 246 / 0.27);
    border-radius: var(--radius-full);
    background: rgb(2 35 67 / 0.56);
    color: #caeafd;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__badge > span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-cyan);
    box-shadow: 0 0 14px var(--brand-cyan);
    animation: pulse 2.2s ease-in-out infinite;
  }

  h1 {
    max-width: 12ch;
    margin-bottom: var(--space-6);
    color: #fff;
    font-size: clamp(2.9rem, 4.6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  h1 strong {
    display: block;
    color: transparent;
    background: linear-gradient(100deg, #57d5ff 5%, #45a3ff 52%, #74f2ff 100%);
    background-clip: text;
  }

  .hero__lead {
    max-width: 55ch;
    margin-bottom: var(--space-8);
    color: #b8ccdf;
    font-size: clamp(1.08rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.65;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero__actions :global(.btn--on-dark) { background: linear-gradient(135deg, var(--brand-cyan), var(--brand-blue)); box-shadow: 0 16px 38px -18px rgb(0 170 231 / 0.9); }

  .hero__assurance { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); margin-top: var(--space-8); color: #93abc1; font-size: var(--fs-xs); }
  .hero__assurance span { display: inline-flex; align-items: center; gap: 6px; }
  .hero__assurance :global(svg) { color: var(--dark-accent); }

  .hero-visual { position: relative; min-width: 0; }

  .service-showcase { position: relative; z-index: 3; padding-bottom: 1.75rem; }
  .service-showcase__bar { display: none; }
  .service-ribbon { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .service-ribbon__item { --tile-accent: var(--brand-cyan); --tile-deep: #07315b; position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-3); min-height: 110px; padding: var(--space-4); overflow: hidden; border: 1px solid color-mix(in srgb, var(--tile-accent) 25%, transparent); border-radius: 22px; box-shadow: 0 10px 30px #0000001a; background: linear-gradient(145deg, var(--tile-deep), #051c37); color: #fff; text-decoration: none; transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base); }
  .service-ribbon__item[data-service='drones'] { --tile-accent: #63e5ff; --tile-deep: #07536b; }
  .service-ribbon__item[data-service='desarrollo-web'] { --tile-accent: #5ee1aa; --tile-deep: #075044; }
  .service-ribbon__item[data-service='soporte-tecnico'] { --tile-accent: #86a7ff; --tile-deep: #263e79; }
  .service-ribbon__item[data-service='licencias-software'] { --tile-accent: #c9ef5a; --tile-deep: #374f42; }
  .service-ribbon__item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(125deg, color-mix(in srgb, var(--tile-accent) 24%, transparent), transparent 48%); opacity: 0; transition: opacity var(--dur-base); }
  .service-ribbon__item:hover { z-index: 2; transform: translateY(-8px); border-color: color-mix(in srgb, var(--tile-accent) 55%, transparent); color: #fff; }
  .service-ribbon__item:hover::after { opacity: 1; }
  .service-ribbon__icon { display: grid; place-items: center; position: relative; z-index: 1; width: 48px; height: 48px; border-radius: 50%; background: var(--tile-accent); color: #03162b; box-shadow: 0 12px 26px -12px color-mix(in srgb, var(--tile-accent) 78%, transparent); }
  .service-ribbon__item > span:nth-child(2) { position: relative; z-index: 1; min-width: 0; }
  .service-ribbon strong, .service-ribbon small { display: block; }
  .service-ribbon strong { margin-bottom: 4px; font-size: var(--fs-sm); }
  .service-ribbon small { color: #92acc3; font-size: 0.68rem; line-height: 1.35; }
  .service-ribbon__item :global(.service-ribbon__arrow) { position: relative; z-index: 1; color: var(--tile-accent); transition: transform var(--dur-fast); }
  .service-ribbon__item:hover :global(.service-ribbon__arrow) { transform: translateX(4px); }

  .carousel-controls { display: flex; align-items: center; gap: 8px; }
  .carousel-status { min-width: 50px; color: #8faac1; font-size: 0.7rem; font-weight: 750; text-align: right; }
  .carousel-controls button { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgb(99 208 249 / 0.24); border-radius: 11px; background: rgb(3 34 65 / 0.9); color: #dff6ff; cursor: pointer; }
  .carousel-controls button:first-of-type { transform: rotate(180deg); }
  .carousel-controls button:disabled { opacity: 0.35; cursor: default; }

  @keyframes pulse { 50% { opacity: 0.45; box-shadow: 0 0 4px var(--brand-cyan); } }
  @keyframes grid-drift { to { background-position: 52px 52px; } }

  @media (max-width: 1080px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr) minmax(380px, 0.9fr); gap: 3rem; }
    h1 { font-size: clamp(2.7rem, 5vw, 4.2rem); }
    .service-ribbon { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    .hero { min-height: auto; padding-top: 3rem; }
    .hero__inner { grid-template-columns: 1fr; }
    .hero__content { max-width: 680px; }
    h1 { max-width: 13ch; }
    .hero-visual { width: 100%; max-width: 640px; margin-inline: auto; }
  }

  @media (max-width: 620px) {
    .hero__actions { display: grid; }
    .hero__actions :global(.btn) { width: 100%; }
    .hero__assurance { display: grid; gap: var(--space-2); }
    .service-showcase { padding-top: var(--space-3); background: linear-gradient(180deg, transparent, rgb(0 8 22 / 0.3)); }
    .service-showcase__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-bottom: var(--space-3); color: #a9bfd2; font-size: var(--fs-xs); font-weight: 750; }
    .service-ribbon { grid-auto-flow: column; grid-auto-columns: minmax(82vw, 1fr); grid-template-columns: none; overflow-x: auto; padding-inline: var(--gutter); scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
    .service-ribbon::-webkit-scrollbar { display: none; }
    .service-ribbon__item, .service-ribbon__item:first-child, .service-ribbon__item:nth-child(2), .service-ribbon__item:last-child { min-height: 88px; border-radius: 22px; scroll-snap-align: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__badge > span, .hero__grid, .hero__traces path, .orbit-spin { animation: none; }
    .hero-visual { transform: none !important; }
  }
</style>
