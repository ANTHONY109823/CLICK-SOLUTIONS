---
import Icon from '../ui/Icon.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import type { Project } from '../../data/projects';
import { getService } from '../../lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const service = getService(project.service);
---

<article class="card project-card">
  {
    project.cover ? (
      <img src={project.cover.src} alt={project.cover.alt} loading="lazy" decoding="async" class="project-card__cover" />
    ) : (
      <ImagePlaceholder icon={service?.icon ?? 'image'} label="Captura pendiente" ratio="16 / 10" />
    )
  }
  <div class="project-card__body">
    <div class="project-card__meta">
      {service && <span class="badge">{service.name}</span>}
      {project.demo && <span class="badge badge--demo">Demostración</span>}
    </div>
    <h3>
      <a href={`/proyectos/${project.slug}`} class="project-card__link">{project.title}</a>
    </h3>
    <p>{project.summary}</p>
    <span class="project-card__more" aria-hidden="true">
      Ver proyecto <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    transition: box-shadow var(--dur-base), transform var(--dur-base);
  }

  .project-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project-card__cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0 var(--space-2) var(--space-2);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  h3 {
    font-size: var(--fs-md);
  }

  .project-card__link {
    color: inherit;
    text-decoration: none;
  }

  .project-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .project-card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--link);
  }
</style>
