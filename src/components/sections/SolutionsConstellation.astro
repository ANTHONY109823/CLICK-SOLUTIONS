---
import Icon from '../ui/Icon.astro';
import Logo from '../layout/Logo.astro';
import type { IconName } from '../ui/icons';

const specialties: { name: string; detail: string; icon: IconName; x: number; y: number }[] = [
  { name: 'Desarrollo web', detail: 'Ideas que conectan', icon: 'code', x: 50, y: 16 },
  { name: 'Soporte', detail: 'Siempre a tu lado', icon: 'headset', x: 79, y: 33 },
  { name: 'Software', detail: 'Herramientas originales', icon: 'key', x: 79, y: 67 },
  { name: 'Consultoría', detail: 'Visión para avanzar', icon: 'workflow', x: 50, y: 84 },
  { name: 'Mantenimiento', detail: 'Tecnología a punto', icon: 'cpu', x: 21, y: 67 },
  { name: 'Drones', detail: 'Una nueva perspectiva', icon: 'drone', x: 21, y: 33 },
];
---

<div class="constellation">
  <span class="ambient ambient--one" aria-hidden="true"></span>
  <span class="ambient ambient--two" aria-hidden="true"></span>
  <div class="constellation__map">
    <svg class="connections" viewBox="0 0 100 100" aria-hidden="true">
      {specialties.map((item) => <line x1="50" y1="50" x2={item.x} y2={item.y} />)}
      <circle cx="50" cy="50" r="33" />
    </svg>
    <div class="brand-core">
      <div class="brand-core__inner"><Logo variant="full" width={150} /></div>
    </div>
    <ul class="specialties" aria-label="Especialidades de Click Solutions">
      {specialties.map((item, index) => (
        <li class="specialty" style={`--x:${item.x}%;--y:${item.y}%;--delay:${index * -1.2}s`}>
          <div class="specialty__face">
            <Icon name={item.icon} size={36} />
            <h3>{item.name}</h3>
            <span>{item.detail}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <p class="constellation__caption"><span></span> Tecnología que conecta todas tus ideas</p>
</div>

<style>
  .constellation { position: relative; isolation: isolate; padding: 1rem 0 1.5rem; }
  .constellation__map { position: relative; width: min(100%, 780px); aspect-ratio: 1.16; margin: auto; }
  .ambient { position: absolute; z-index: -1; width: 55%; aspect-ratio: 1; border-radius: 50%; filter: blur(55px); pointer-events: none; }
  .ambient--one { background: #00b8ed17; left: 8%; top: 3%; }
  .ambient--two { background: #477dff12; right: 5%; bottom: 5%; }
  .connections { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .connections line { stroke: #54bddd; stroke-width: .18; stroke-dasharray: 1 1.3; animation: signal 18s linear infinite; }
  .connections circle { fill: none; stroke: #72cbe1; stroke-width: .12; stroke-dasharray: .3 1.3; opacity: .5; }
  .brand-core, .specialty { position: absolute; width: 28%; aspect-ratio: 1.08; translate: -50% -50%; }
  .brand-core { left: 50%; top: 50%; display: grid; place-items: center; filter: drop-shadow(0 12px 25px #0087c525); }
  .brand-core::before, .brand-core__inner, .specialty::before, .specialty__face { clip-path: polygon(29% 0, 71% 0, 100% 29%, 100% 71%, 71% 100%, 29% 100%, 0 71%, 0 29%); }
  .brand-core::before { content: ''; position: absolute; inset: -7px; background: linear-gradient(135deg, #17b9e9, #b7eafa 45%, #2375d8); animation: core-glow 5s ease-in-out infinite; }
  .brand-core__inner { position: absolute; inset: 0; display: grid; place-items: center; background: #fff; }
  .brand-core__inner :global(img) { width: 69%; max-width: 150px; }
  .specialties { list-style: none; padding: 0; margin: 0; }
  .specialty { left: var(--x); top: var(--y); animation: float 7s ease-in-out infinite; animation-delay: var(--delay); filter: drop-shadow(0 12px 15px #153f7010); }
  .specialty::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, #96d8ed, #d6e9f4 45%, #59b6dc); }
  .specialty__face { position: absolute; inset: 1.5px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .65rem; background: linear-gradient(145deg, #fff, #edf8ff); color: #007dab; }
  .specialty h3 { margin: 0; color: #102f4f; font-size: clamp(.65rem, 1.7vw, 1.12rem); letter-spacing: -.035em; }
  .specialty__face > span { font-size: clamp(.45rem, 1.05vw, .7rem); color: #5c768c; }
  .constellation__caption { display: flex; align-items: center; justify-content: center; gap: .65rem; margin: 1.5rem 0 0; color: #5c768c; font-size: .78rem; letter-spacing: .035em; text-align: center; }
  .constellation__caption > span { width: 6px; height: 6px; border-radius: 50%; background: #00a9d6; box-shadow: 0 0 0 5px #00a9d612; flex-shrink: 0; }
  @keyframes float { 0%, 100% { transform: translateY(-3px); } 50% { transform: translateY(4px); } }
  @keyframes signal { to { stroke-dashoffset: -46; } }
  @keyframes core-glow { 0%, 100% { opacity: .65; } 50% { opacity: 1; } }
  @media (max-width: 560px) {
    .constellation { margin-inline: -.5rem; }
    .specialty__face { gap: .35rem; }
    .specialty__face :global(svg) { width: 25px; height: 25px; }
    .specialty__face > span { display: none; }
    .constellation__caption { font-size: .65rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .specialty, .connections line, .brand-core::before { animation: none; }
  }
</style>
