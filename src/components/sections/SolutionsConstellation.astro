---
import Icon from '../ui/Icon.astro';

import type { IconName } from '../ui/icons';

const specialties: { name: string; detail: string; icon: IconName; x: number; y: number }[] = [
  { name: 'Desarrollo web', detail: 'Ideas que conectan', icon: 'code', x: 38.7, y: 20 },
  { name: 'Soporte', detail: 'Siempre a tu lado', icon: 'headset', x: 61.3, y: 20 },
  { name: 'Software', detail: 'Herramientas originales', icon: 'key', x: 72.6, y: 50 },
  { name: 'Consultoría', detail: 'Visión para avanzar', icon: 'workflow', x: 61.3, y: 80 },
  { name: 'Mantenimiento', detail: 'Tecnología a punto', icon: 'cpu', x: 38.7, y: 80 },
  { name: 'Drones', detail: 'Una nueva perspectiva', icon: 'drone', x: 27.4, y: 50 },
  { name: 'Tiendas online', detail: 'Comercio digital', icon: 'cart', x: 16.1, y: 20 },
  { name: 'Sistemas web', detail: 'Soluciones a medida', icon: 'layout', x: 16.1, y: 80 },
  { name: 'Fotografía aérea', detail: 'Imágenes desde el aire', icon: 'camera', x: 83.9, y: 20 },
  { name: 'Impresoras', detail: 'Configuración y soporte', icon: 'printer', x: 83.9, y: 80 },
];
---

<div class="constellation">
  <svg class="neural-background" width="100%" height="100%" aria-hidden="true">
    <defs>
      <pattern id="solutions-network" width="120" height="104" patternUnits="userSpaceOnUse">
        <path d="M30 0H90L120 52 90 104H30L0 52Z M30 0 90 104 M90 0 30 104 M0 52H120" fill="none" stroke="#00aae7" stroke-width=".7" />
        <g fill="#087ff5"><circle cx="30" cy="0" r="2"/><circle cx="90" cy="0" r="2"/><circle cx="0" cy="52" r="2"/><circle cx="60" cy="52" r="2.5"/><circle cx="120" cy="52" r="2"/></g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#solutions-network)" />
  </svg>
  <span class="ambient ambient--one" aria-hidden="true"></span>
  <span class="ambient ambient--two" aria-hidden="true"></span>
  <div class="constellation__map"><span class="center-wave" aria-hidden="true"></span><span class="center-wave center-wave--second" aria-hidden="true"></span>
    <svg class="connections" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {specialties.map((item) => <line x1="50" y1="50" x2={item.x} y2={item.y} />)}
      <circle cx="50" cy="50" r="33" />
    </svg>
    <div class="brand-core">
      <div class="brand-core__inner">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/brand/clicksolutions-logo.png`} alt="Click Solutions" width="1386" height="2500" loading="lazy" decoding="async" />
      </div>
    </div>
    <ul class="specialties" aria-label="Especialidades de Click Solutions">
      {specialties.map((item) => (
        <li class="specialty" style={`--x:${item.x}%;--y:${item.y}%;--dx:${(item.x - 50) * .07}%;--dy:${(item.y - 50) * .07}%;--delay:${Math.abs(item.x - 50) > 30 ? ".18s" : "0s"}`}>
          <div class="specialty__face">
            <Icon name={item.icon} size={36} />
            <h3>{item.name}</h3>
            <span>{item.detail}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .constellation { position: relative; isolation: isolate; padding: 1rem 0 1.5rem; }
  .neural-background { position: absolute; inset: -10% -12%; width: 124%; height: 120%; z-index: -1; opacity: .2; pointer-events: none; mask-image: radial-gradient(ellipse, #000 20%, transparent 72%); }
  .constellation__map { position: relative; width: min(100%, 1200px); aspect-ratio: 1.33; margin: auto; }
  .ambient { position: absolute; z-index: -1; width: 55%; aspect-ratio: 1; border-radius: 50%; filter: blur(55px); pointer-events: none; }
  .ambient--one { background: #00b8ed17; left: 8%; top: 3%; }
  .ambient--two { background: #477dff12; right: 5%; bottom: 5%; }
  .connections { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .connections line { stroke: #54bddd; stroke-width: .18; stroke-dasharray: 1 1.3; animation: signal 8s linear infinite; }
  .connections circle { fill: none; stroke: #72cbe1; stroke-width: .12; stroke-dasharray: .3 1.3; opacity: .5; }
  .brand-core, .specialty { position: absolute; width: 22%; aspect-ratio: 1; translate: -50% -50%; }
  .brand-core { width: 22%; left: 50%; top: 50%; display: grid; place-items: center; filter: drop-shadow(0 12px 25px #0087c525); }
  .brand-core::before, .brand-core__inner, .specialty::before, .specialty__face { clip-path: polygon(29% 0, 71% 0, 100% 29%, 100% 71%, 71% 100%, 29% 100%, 0 71%, 0 29%); }
  .brand-core::before { content: ''; position: absolute; inset: -2px; background: linear-gradient(135deg, #17b9e9, #b7eafa 45%, #2375d8); animation: core-glow 5s ease-in-out infinite; }
  .brand-core__inner { position: absolute; inset: 0; background: #fff; }
  .brand-core__inner img { position: absolute; left: 17%; top: 12%; display: block; width: 66%; height: 76%; max-width: none; max-height: none; object-fit: contain; object-position: center; }
  .specialties { list-style: none; padding: 0; margin: 0; }
  .specialty { left: var(--x); top: var(--y); animation: radial-pulse 4.2s ease-in-out infinite; animation-delay: var(--delay); filter: drop-shadow(0 12px 15px #153f7010); }
  .specialty::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, #00aae7, #087ff5 60%, #033f5c); }
  .specialty__face { position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .65rem; background: linear-gradient(145deg, #d9f7ff, #91daf4); color: #033f5c; }
  .specialty:nth-child(3n + 2) .specialty__face { background: linear-gradient(145deg, #e0eeff, #a6cfff); color: #075bb7; }
  .specialty:nth-child(3n) .specialty__face { background: linear-gradient(145deg, #087cb5, #033f5c); color: #6bddff; }
  .specialty:nth-child(3n) h3 { color: #fff; }
  .specialty:nth-child(3n) .specialty__face > span { color: #d0efff; }
  .specialty h3 { margin: 0; color: #102f4f; font-size: clamp(.6rem, 1.35vw, 1.05rem); letter-spacing: -.035em; }
  .specialty__face > span { font-size: clamp(.45rem, 1.05vw, .7rem); color: #5c768c; }
  .center-wave { position: absolute; left: 50%; top: 50%; width: 21%; aspect-ratio: 1; translate: -50% -50%; border: 1px solid #00aae7; border-radius: 30%; opacity: 0; pointer-events: none; animation: center-wave 4.2s ease-out infinite; }
  .center-wave--second { animation-delay: 2.1s; }
  @keyframes center-wave { 0% { transform: scale(.8); opacity: 0; } 15% { opacity: .4; } 100% { transform: scale(4.6); opacity: 0; } }
  @keyframes radial-pulse { 0%, 100% { transform: translate(0, 0) scale(1); } 45% { transform: translate(var(--dx), var(--dy)) scale(.985); } }
  @keyframes signal { to { stroke-dashoffset: -46; } }
  @keyframes core-glow { 0%, 100% { opacity: .65; } 50% { opacity: 1; } }
  @media (max-width: 640px) {
    .constellation { margin-inline: -.5rem; }
    .specialty__face { gap: .25rem; }
    .specialty h3 { font-size: clamp(.44rem, 1.9vw, .8rem); text-align: center; max-width: 90%; }
    .specialty__face :global(svg) { width: clamp(17px, 5vw, 28px); height: clamp(17px, 5vw, 28px); }
    .specialty__face > span { display: none; }
  }  @media (prefers-reduced-motion: reduce) {
    .specialty, .connections line, .brand-core::before, .center-wave { animation: none; }
  }
</style>
