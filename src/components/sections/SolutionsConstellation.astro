---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

type Specialty = { name: string; detail: string; icon: IconName; col: number; row: number; tone: string };
// Coordinates share the same grid as the empty tiles. Nothing sits over another tile.
const specialties: Specialty[] = [
  { name: 'Desarrollo web', detail: 'Ideas que conectan', icon: 'code', col: 8, row: 6, tone: 'cyan' },
  { name: 'Drones', detail: 'Una nueva perspectiva', icon: 'drone', col: 6, row: 7, tone: 'navy' },
  { name: 'Soporte', detail: 'Siempre a tu lado', icon: 'headset', col: 10, row: 7, tone: 'blue' },
  { name: 'Software', detail: 'Herramientas originales', icon: 'key', col: 10, row: 9, tone: 'navy' },
  { name: 'Mantenimiento', detail: 'Tecnología a punto', icon: 'cpu', col: 6, row: 9, tone: 'blue' },
  { name: 'Consultoría', detail: 'Visión para avanzar', icon: 'workflow', col: 8, row: 10, tone: 'cyan' },
  { name: 'Tiendas online', detail: 'Comercio digital', icon: 'cart', col: 4, row: 7, tone: 'cyan' },
  { name: 'Sistemas web', detail: 'Soluciones a medida', icon: 'layout', col: 4, row: 9, tone: 'blue' },
  { name: 'Fotografía aérea', detail: 'Imágenes desde el aire', icon: 'camera', col: 12, row: 7, tone: 'navy' },
  { name: 'Impresoras', detail: 'Configuración y soporte', icon: 'printer', col: 12, row: 9, tone: 'cyan' },
];
const gridSize = 18;
const mainSlots = [...specialties, { col: 8, row: 8 }];
const tiles = Array.from({ length: gridSize * gridSize }, (_, index) => {
  const col = index % gridSize;
  const row = Math.floor(index / gridSize);
  const specialty = specialties.find((item) => item.col === col && item.row === row);
  const brand = col === 8 && row === 8;
  // Each main octagon replaces four small cells; no empty tile sits underneath it.
  if (!specialty && !brand && mainSlots.some((slot) => col >= slot.col && col < slot.col + 2 && row >= slot.row && row < slot.row + 2)) return null;
  const span = specialty || brand ? 2 : 1;
  return { index, col, row, specialty, brand, span, distance: Math.hypot(col + span / 2 - 9, row + span / 2 - 9) };
}).filter((tile) => tile !== null);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="constellation">
  <ul class="octagon-field" aria-label="Especialidades de Click Solutions">
    {tiles.map((tile) => (
      <li
        class:list={['tile', { 'tile--specialty': !!tile.specialty, 'tile--brand': tile.brand, 'tile--empty': !tile.specialty && !tile.brand, 'tile--lit': !!tile.specialty || tile.brand || tile.index % 5 === 0 }]}
        data-tone={tile.specialty?.tone ?? (tile.index % 11 === 0 ? 'mist' : 'pale')}
        style={`grid-column:${tile.col + 1} / span ${tile.span};grid-row:${tile.row + 1} / span ${tile.span};--wave-delay:${tile.distance * .12}s;--edge-delay:${tile.index % 13 * -.31}s`}
        aria-hidden={!tile.specialty && !tile.brand ? 'true' : undefined}
      >
        <div class="tile__body">
          <div class="tile__face">
            {tile.brand ? (
              <img class="brand-logo" src={`${base}/brand/clicksolutions-logo.png`} alt="Click Solutions" width="1386" height="2500" loading="lazy" decoding="async" />
            ) : tile.specialty ? (
              <>
                <Icon name={tile.specialty.icon} size={28} />
                <h3>{tile.specialty.name}</h3>
                <span class="tile__detail">{tile.specialty.detail}</span>
              </>
            ) : null}
          </div>
          {(tile.specialty || tile.brand || tile.index % 5 === 0) && <svg class="edge-light" viewBox="0 0 100 100" aria-hidden="true"><path d="M29 1H71L99 29V71L71 99H29L1 71V29Z" /></svg>}
        </div>
      </li>
    ))}
  </ul>
  <div class="energy" aria-hidden="true"><span></span><span></span></div>
</div>

<style>
  .constellation {
    --cell: clamp(34px, min(8.8vw, 10svh), 92px);
    position: relative;
    isolation: isolate;
    min-height: max(600px, calc(100svh - var(--header-h)));
    overflow: hidden;
    background: #eaf5fc;
  }
  .octagon-field {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    grid-template-columns: repeat(18, minmax(0, 1fr));
    grid-template-rows: repeat(18, minmax(0, 1fr));
    width: max(100%, calc(var(--cell) * 18));
    aspect-ratio: 1;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .tile { position: relative; min-width: 0; min-height: 0; padding: 2px; }
  .tile__body { position: absolute; inset: 2px; filter: drop-shadow(0 3px 0 #a7cbdc); animation: tile-wave 4.8s ease-in-out infinite; animation-delay: var(--wave-delay); }
  .tile__body::before, .tile__face { position: absolute; inset: 0; clip-path: polygon(29% 0, 71% 0, 100% 29%, 100% 71%, 71% 100%, 29% 100%, 0 71%, 0 29%); }
  .tile__body::before { content: ''; background: linear-gradient(135deg, #9dddf1, #388cb1); }
  .tile__face { inset: 1px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: .35rem; padding: 9%; overflow: hidden; background: linear-gradient(145deg, #f6fcff, #d8edf7); color: #033f5c; }
  .tile[data-tone='mist'] .tile__face { background: linear-gradient(145deg, #d7ecf7, #a5ccdf); }
  .tile[data-tone='cyan'] .tile__face { background: linear-gradient(145deg, #d7f7ff, #94dcf0); }
  .tile[data-tone='blue'] .tile__face { background: linear-gradient(145deg, #e0efff, #accff5); color: #075bb7; }
  .tile[data-tone='navy'] .tile__face { background: linear-gradient(145deg, #087cb5, #033f5c); color: #83e3ff; }
  .tile--specialty .tile__body::before, .tile--brand .tile__body::before { background: linear-gradient(135deg, #00aae7, #087ff5, #033f5c); }
  .tile--specialty .tile__body, .tile--brand .tile__body { filter: drop-shadow(0 4px 0 #70b6d3) drop-shadow(0 0 9px #00aae738); z-index: 1; }
  .tile--empty { opacity: .6; }
  .tile--specialty .tile__face, .tile--brand .tile__face { inset: 3px; }
  .tile h3 { max-width: 100%; margin: 0; font-size: clamp(.7rem, 1.2vw, 1.05rem); font-weight: 750; text-align: center; line-height: 1.15; color: #103b55; letter-spacing: -.025em; }
  .tile__detail { font-size: clamp(.5rem, .7vw, .65rem); text-align: center; line-height: 1.25; color: #47687f; }
  .tile[data-tone='navy'] h3 { color: #fff; }
  .tile[data-tone='navy'] .tile__detail { color: #d0efff; }
  .tile--brand .tile__face { background: #fff; padding: 0; }
  .brand-logo { position: absolute; inset: 11% 17%; width: 66%; height: 78%; max-width: none; object-fit: contain; }
  .edge-light { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; filter: drop-shadow(0 0 3px #00aae7); }
  .edge-light path { fill: none; stroke: #00bfff; stroke-width: 1.2; stroke-dasharray: 38 292; animation: edge-flow 3.2s linear infinite; animation-delay: var(--edge-delay); }
  .tile--specialty .edge-light path { stroke: #a4f1ff; stroke-width: 1.6; }
  .tile--brand .edge-light path { stroke: #00aae7; stroke-width: 2; }
  .energy { position: absolute; left: 50%; top: 50%; width: var(--cell); aspect-ratio: 1; translate: -50% -50%; pointer-events: none; z-index: -1; }
  .energy span { position: absolute; inset: 0; border: 2px solid #00aae7; border-radius: 29%; opacity: 0; animation: energy-wave 4.8s ease-out infinite; }
  .energy span:nth-child(2) { animation-delay: 2.4s; }
  @keyframes tile-wave { 0%, 65%, 100% { transform: translateY(0); } 32% { transform: translateY(-3px); } }
  @keyframes edge-flow { to { stroke-dashoffset: -330; } }
  @keyframes energy-wave { 0% { transform: scale(.8); opacity: .5; } 100% { transform: scale(8); opacity: 0; } }
  @media (max-width: 640px) {
    .constellation { min-height: max(520px, calc(100svh - var(--header-h))); }
    .tile h3 { font-size: clamp(.44rem, 1.8vw, .72rem); }
    .tile__detail { display: none; }
    .tile__face { gap: .2rem; }
    .tile__face :global(svg) { width: clamp(16px, 4.5vw, 26px); height: clamp(16px, 4.5vw, 26px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile__body, .edge-light path, .energy span { animation: none; }
    .energy { display: none; }
  }
</style>
