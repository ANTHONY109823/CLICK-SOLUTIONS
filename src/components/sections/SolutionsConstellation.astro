---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

const specialties: { name: string; detail: string; icon: IconName; x: number; y: number; tone: string }[] = [
  { name: 'Desarrollo web', detail: 'Ideas que conectan', icon: 'code', x: 50, y: 16.667, tone: 'cyan' },
  { name: 'Drones', detail: 'Una nueva perspectiva', icon: 'drone', x: 31.25, y: 33.333, tone: 'navy' },
  { name: 'Soporte', detail: 'Siempre a tu lado', icon: 'headset', x: 68.75, y: 33.333, tone: 'blue' },
  { name: 'Software', detail: 'Herramientas originales', icon: 'key', x: 68.75, y: 66.667, tone: 'navy' },
  { name: 'Mantenimiento', detail: 'Tecnología a punto', icon: 'cpu', x: 31.25, y: 66.667, tone: 'blue' },
  { name: 'Consultoría', detail: 'Visión para avanzar', icon: 'workflow', x: 50, y: 83.333, tone: 'cyan' },
  { name: 'Tiendas online', detail: 'Comercio digital', icon: 'cart', x: 12.5, y: 16.667, tone: 'cyan' },
  { name: 'Sistemas web', detail: 'Soluciones a medida', icon: 'layout', x: 12.5, y: 83.333, tone: 'blue' },
  { name: 'Fotografía aérea', detail: 'Imágenes desde el aire', icon: 'camera', x: 87.5, y: 16.667, tone: 'navy' },
  { name: 'Impresoras', detail: 'Configuración y soporte', icon: 'printer', x: 87.5, y: 83.333, tone: 'cyan' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="constellation">
  <svg class="honeycomb" width="100%" height="100%" aria-hidden="true">
    <defs>
      <!-- Flat-top hexagons: pitch 90, height 60√3. Adjacent edges coincide. -->
      <pattern id="solutions-honeycomb" width="180" height="103.923048" patternUnits="userSpaceOnUse">
        <g class="honeycomb__cells">
          <path d="M-60 0-30-51.961524H30L60 0 30 51.961524H-30Z" />
          <path d="M30 51.961524 60 0H120L150 51.961524 120 103.923048H60Z" />
          <path d="M120 0 150-51.961524H210L240 0 210 51.961524H150Z" />
          <path d="M-60 103.923048-30 51.961524H30L60 103.923048 30 155.884572H-30Z" />
          <path d="M120 103.923048 150 51.961524H210L240 103.923048 210 155.884572H150Z" />
        </g>
        <path class="honeycomb__glow" d="M30 51.961524 60 0H120L150 51.961524 120 103.923048H60Z" />
      </pattern>
      <radialGradient id="solutions-daylight"><stop stop-color="#fff" stop-opacity=".5"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
    </defs>
    <rect width="100%" height="100%" fill="url(#solutions-honeycomb)" />
    <rect width="100%" height="100%" fill="url(#solutions-daylight)" />
  </svg>
  <div class="main-honeycomb">
    <div class="energy" aria-hidden="true"><span></span><span></span></div>
    <ul class="specialties" aria-label="Especialidades de Click Solutions">
      {specialties.map((item, index) => (
        <li class="tile" data-tone={item.tone} style={`--x:${item.x}%;--y:${item.y}%;--edge-delay:${index * -.37}s;--wave-delay:${Math.abs(item.x - 50) * .012}s`}>
          <div class="tile__body">
            <div class="tile__face"><Icon name={item.icon} size={30} /><h3>{item.name}</h3><span class="tile__detail">{item.detail}</span></div>
            <svg class="edge-light" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M25 1H75L99 50 75 99H25L1 50Z" /></svg>
          </div>
        </li>
      ))}
    </ul>
    <div class="tile tile--brand" style="--x:50%;--y:50%;--edge-delay:0s;--wave-delay:0s">
      <div class="tile__body">
        <div class="tile__face"><img class="brand-logo" src={`${base}/brand/clicksolutions-logo.png`} alt="Click Solutions" width="1386" height="2500" loading="lazy" decoding="async" /></div>
        <svg class="edge-light" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M25 1H75L99 50 75 99H25L1 50Z" /></svg>
      </div>
    </div>
  </div>
</div>

<style>
  .constellation { position: relative; isolation: isolate; display: grid; place-items: center; min-height: max(680px, calc(100svh - var(--header-h))); overflow: hidden; background: #edf7fc; padding: 2rem .75rem; }
  .honeycomb { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .honeycomb__cells { fill: #e3f2fa; stroke: #a8d4e8; stroke-width: 1.5; stroke-linejoin: round; }
  .honeycomb__cells path:nth-child(2) { fill: #f4fbff; }
  .honeycomb__cells path:nth-child(3n) { fill: #d0e9f5; }
  .honeycomb__glow { fill: none; stroke: #00aae7; stroke-width: 1.4; stroke-dasharray: 25 335; animation: honey-flow 5s linear infinite; opacity: .55; }
  .main-honeycomb { position: relative; width: min(100%, 960px); aspect-ratio: 8 / 5.196152423; }
  .specialties { padding: 0; margin: 0; list-style: none; }
  /* One exact flat-top honeycomb lattice: six principal tiles share the core edges. */
  .tile { position: absolute; left: var(--x); top: var(--y); width: 25%; height: 33.333333%; translate: -50% -50%; }
  .tile__body { position: absolute; inset: 1.5px; animation: tile-wave 4.8s ease-in-out infinite; animation-delay: var(--wave-delay); }
  .tile__body::before, .tile__face { position: absolute; inset: 0; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }
  .tile__body::before { content: ''; background: linear-gradient(135deg, #00aae7, #087ff5, #033f5c); }
  .tile__face { inset: 3px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: .4rem; padding: 10% 12%; background: linear-gradient(145deg, #ddf8ff, #94dcf0); color: #033f5c; }
  .tile[data-tone='blue'] .tile__face { background: linear-gradient(145deg, #dceeff, #a3cbf5); color: #075bb7; }
  .tile[data-tone='navy'] .tile__face { background: linear-gradient(145deg, #087cb5, #033f5c); color: #83e3ff; }
  .tile h3 { max-width: 100%; margin: 0; font-size: clamp(.7rem, 1.3vw, 1.05rem); font-weight: 750; text-align: center; line-height: 1.15; color: #103b55; letter-spacing: -.025em; }
  .tile__detail { font-size: clamp(.5rem, .8vw, .68rem); text-align: center; line-height: 1.25; color: #47687f; }
  .tile[data-tone='navy'] h3 { color: #fff; }
  .tile[data-tone='navy'] .tile__detail { color: #d0efff; }
  .tile--brand .tile__face { background: #fff; padding: 0; }
  .brand-logo { position: absolute; inset: 10% 18%; width: 64%; height: 80%; max-width: none; object-fit: contain; }
  .edge-light { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; filter: drop-shadow(0 0 3px #00aae7); }
  .edge-light path { fill: none; stroke: #a4f1ff; stroke-width: 1.3; stroke-dasharray: 30 270; animation: edge-flow 3.2s linear infinite; animation-delay: var(--edge-delay); }
  .tile--brand .edge-light path { stroke: #00aae7; stroke-width: 2; }
  .energy { position: absolute; left: 50%; top: 50%; width: 25%; height: 33.333%; translate: -50% -50%; pointer-events: none; }
  .energy span { position: absolute; inset: 0; border: 1px solid #00aae7; border-radius: 25%; opacity: 0; animation: energy-wave 4.8s ease-out infinite; }
  .energy span:nth-child(2) { animation-delay: 2.4s; }
  @keyframes tile-wave { 0%, 65%, 100% { filter: brightness(1); } 32% { filter: brightness(1.12); } }
  @keyframes edge-flow { to { stroke-dashoffset: -300; } }
  @keyframes honey-flow { to { stroke-dashoffset: -360; } }
  @keyframes energy-wave { 0% { transform: scale(.8); opacity: .5; } 100% { transform: scale(5); opacity: 0; } }
  @media (max-width: 640px) {
    .constellation { min-height: max(520px, calc(100svh - var(--header-h))); padding-inline: .4rem; }
    .tile h3 { font-size: clamp(.48rem, 2vw, .78rem); }
    .tile__detail { display: none; }
    .tile__face { gap: .2rem; inset: 2px; }
    .tile__face :global(svg) { width: clamp(18px, 4.5vw, 26px); height: clamp(18px, 4.5vw, 26px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile__body, .edge-light path, .energy span, .honeycomb__glow { animation: none; }
    .energy { display: none; }
  }
</style>