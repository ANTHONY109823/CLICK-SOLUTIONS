---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

type Specialty = { name: string; detail: string; icon: IconName; q: number; r: number; tone: string };
const specialties: Specialty[] = [
  { name: 'Desarrollo web', detail: 'Ideas que conectan', icon: 'code', q: 0, r: -1, tone: 'cyan' },
  { name: 'Drones', detail: 'Una nueva perspectiva', icon: 'drone', q: -1, r: 0, tone: 'navy' },
  { name: 'Software', detail: 'Herramientas originales', icon: 'key', q: 1, r: 0, tone: 'navy' },
  { name: 'Mantenimiento', detail: 'Tecnología a punto', icon: 'cpu', q: -1, r: 1, tone: 'blue' },
  { name: 'Fotografía y video', detail: 'Producción audiovisual aérea', icon: 'camera', q: 1, r: -1, tone: 'blue' },
  { name: 'Impresoras', detail: 'Configuración y soporte', icon: 'printer', q: 2, r: -2, tone: 'cyan' },
  { name: 'Fotogrametría', detail: 'Modelado y medición 3D', icon: 'photogrammetry', q: 0, r: 1, tone: 'cyan' },
  { name: 'Automatización', detail: 'Procesos más simples', icon: 'workflow', q: -2, r: 0, tone: 'blue' },
  { name: 'Diagnóstico', detail: 'Identificamos las fallas', icon: 'search', q: -2, r: 2, tone: 'cyan' },
  { name: 'Licencias originales', detail: 'Software para tu equipo', icon: 'shield', q: 2, r: 0, tone: 'navy' },
];
const emptyTones = ['pale', 'cyan', 'blue', 'pale', 'aqua', 'cyan', 'pale', 'blue', 'aqua', 'pale', 'cyan', 'mist', 'navy'];
// Every cell, including the logo and specialties, belongs to this ONE axial mesh.
const cells = Array.from({ length: 285 }, (_, index) => {
  const q = index % 15 - 7;
  const r = Math.floor(index / 15) - 9;
  const specialty = specialties.find((item) => item.q === q && item.r === r);
  return { index, q, r, specialty, brand: q === 0 && r === 0, x: q * .75, y: (r + q / 2) * Math.sqrt(3) / 2, distance: Math.hypot(q * 1.5, (r + q / 2) * Math.sqrt(3)) };
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="constellation">
  <div class="honeycomb-camera">
    <ul class="honeycomb-scene" aria-label="Especialidades de Click Solutions">
      {cells.map((cell) => (
        <li class:list={['cell', { 'cell--main': !!cell.specialty, 'cell--brand': cell.brand, 'cell--empty': !cell.specialty && !cell.brand, 'cell--small': cell.index % 3 === 0 }]}
          data-tone={cell.specialty?.tone ?? emptyTones[Math.abs(cell.q * 7 + cell.r * 11 + cell.index % 3) % emptyTones.length]}
          style={`--x:${cell.x};--y:${cell.y};--delay:${-cell.index % 17 * .43}s;--wave:${cell.distance * -.18}s;--duration:${6 + cell.index % 5}s`}
          aria-hidden={!cell.specialty && !cell.brand ? 'true' : undefined}
        >
          <span class="cell__foundation" aria-hidden="true"></span>
          <div class="cell__depth">
            <div class="cell__surface">
              {cell.brand ? <img class="brand-logo" src={`${base}/brand/clicksolutions-logo.png`} alt="Click Solutions" width="1386" height="2500" loading="lazy" decoding="async" /> : cell.specialty ? <><Icon name={cell.specialty.icon} size={30} /><h3>{cell.specialty.name}</h3><span class="cell__detail">{cell.specialty.detail}</span></> : null}
            </div>
            <svg class="edge-light" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M25 1H75L99 50 75 99H25L1 50Z" /></svg>
          </div>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .constellation { --extra-bottom: 76px; --diameter: clamp(88px, min(22vw, 21svh), 200px); position: relative; isolation: isolate; min-height: calc(max(680px, 100svh - var(--header-h)) + var(--extra-bottom)); overflow: hidden; background: #edf7fc; }
  .honeycomb-camera { position: absolute; inset: 0 0 var(--extra-bottom); transform-origin: 50% 50%; animation: camera-zoom 19s ease-in-out infinite alternate; }
  .honeycomb-scene { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .cell { position: absolute; left: calc(50% + var(--x) * var(--diameter)); top: calc(50% + var(--y) * var(--diameter)); width: var(--diameter); height: calc(var(--diameter) * .866025404); translate: -50% -50%; }
  .cell__foundation, .cell__depth, .cell__surface { position: absolute; inset: 0; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }
  /* The continuous foundation never disappears: zooming faces reveal their own cell. */
  .cell__foundation { background: linear-gradient(135deg, #d4eaf5, #e9f5fb); outline: 1px solid #b9dceb; }
  .cell__depth { inset: 1.5px; background: linear-gradient(135deg, #a8d7ec, #6eb6d8); animation: empty-zoom var(--duration) ease-in-out infinite; animation-delay: var(--delay); }
  .cell__surface { inset: 1.5px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .4rem; padding: 10% 12%; overflow: hidden; background: linear-gradient(145deg, #f8fdff, #d6edf8); color: #033f5c; }
  .cell[data-tone='blue'] .cell__surface { background: linear-gradient(145deg, #ddecff, #99c7f3); color: #075bb7; }
  .cell[data-tone='cyan'] .cell__surface { background: linear-gradient(145deg, #d8f8ff, #88d9ef); }
  .cell[data-tone='navy'] .cell__surface { background: linear-gradient(145deg, #087cb5, #033f5c); color: #8ce9ff; }
  .cell[data-tone='aqua'] .cell__surface { background: linear-gradient(145deg, #b8f3ff, #4cc8e4); }
  .cell[data-tone='mist'] .cell__surface { background: linear-gradient(145deg, #c4e4f7, #69a8d5); }
  .cell--empty[data-tone='cyan'] .cell__foundation { background: linear-gradient(135deg, #c4edf9, #dff6ff); }
  .cell--empty[data-tone='blue'] .cell__foundation { background: linear-gradient(135deg, #c9e2f9, #e2efff); }
  .cell--empty[data-tone='aqua'] .cell__foundation { background: linear-gradient(135deg, #bce9f2, #dcf7fa); }
  .cell--empty:nth-child(5n) .cell__surface::after { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 20%, #ffffff70 45%, transparent 65%); transform: translateX(-140%); animation: surface-shine 7s ease-in-out infinite; animation-delay: var(--delay); pointer-events: none; }
  .cell--small .cell__depth { animation-name: small-zoom; }
  .cell--main, .cell--brand { z-index: 2; }
  .cell--main .cell__depth, .cell--brand .cell__depth { scale: 1.05; background: linear-gradient(135deg, #00aae7, #087ff5, #033f5c); animation: main-zoom 7s ease-in-out infinite; animation-delay: var(--wave); }
  .cell--main .cell__surface, .cell--brand .cell__surface { inset: 3px; }
  .cell--brand .cell__depth { animation-name: brand-zoom; }
  .cell--brand .cell__surface { background: #fff; padding: 0; }
  .brand-logo { position: absolute; inset: 10% 18%; width: 64%; height: 80%; max-width: none; object-fit: contain; }
  .cell h3 { max-width: 100%; margin: 0; color: #103b55; font-size: clamp(.7rem, 1.3vw, 1.05rem); font-weight: 750; line-height: 1.15; letter-spacing: -.025em; text-align: center; }
  .cell__detail { color: #47687f; font-size: clamp(.5rem, .8vw, .68rem); line-height: 1.25; text-align: center; }
  .cell[data-tone='navy'] h3 { color: #fff; }
  .cell[data-tone='navy'] .cell__detail { color: #d0efff; }
  .edge-light { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .edge-light path { fill: none; stroke: #00aae7; stroke-width: 1; stroke-dasharray: 35 265; animation: edge-flow 4s linear infinite; animation-delay: var(--delay); }
  .cell--main .edge-light path, .cell--brand .edge-light path { stroke: #a4f1ff; stroke-width: 1.6; }
  .cell--brand .edge-light path { stroke: #00bfff; stroke-width: 2; }
  .cell--empty .edge-light path { stroke: #009fdd; stroke-width: 1.4; }
  @keyframes camera-zoom { 0% { transform: scale(1) translate(0, 0); } 40% { transform: scale(1.06) translate(-.8%, .8%); } 75% { transform: scale(1.11) translate(.8%, -.6%); } 100% { transform: scale(1.025) translate(.3%, .2%); } }
  @keyframes empty-zoom { 0%, 100% { transform: scale(.94); opacity: .9; } 30% { transform: scale(.64); opacity: .28; } 55% { transform: scale(.35); opacity: 0; } 80% { transform: scale(1); opacity: 1; } }
  @keyframes small-zoom { 0%, 100% { transform: scale(.53); opacity: .55; } 35% { transform: scale(.9); opacity: .95; } 65% { transform: scale(.3); opacity: 0; } 85% { transform: scale(.65); opacity: .7; } }
  @keyframes main-zoom { 0%, 100% { transform: scale(.94) translateY(0); opacity: .88; } 45% { transform: scale(1.04) translateY(-2px); opacity: 1; } 70% { transform: scale(.98) translateY(1px); opacity: .96; } }
  @keyframes brand-zoom { 0%, 100% { transform: scale(.98); } 50% { transform: scale(1.035); } }
  @keyframes edge-flow { to { stroke-dashoffset: -300; } }
  @keyframes surface-shine { 0%, 30% { transform: translateX(-140%); } 75%, 100% { transform: translateX(140%); } }
  @media (max-width: 640px) {
    .constellation { --diameter: clamp(76px, 22vw, 140px); min-height: calc(max(520px, 100svh - var(--header-h)) + var(--extra-bottom)); }
    .honeycomb-camera { animation-name: camera-mobile; }
    .cell h3 { font-size: clamp(.48rem, 2vw, .78rem); }
    .cell__detail { display: none; }
    .cell__surface { gap: .2rem; }
    .cell__surface :global(svg) { width: clamp(18px, 4.5vw, 26px); height: clamp(18px, 4.5vw, 26px); }
  }
  @keyframes camera-mobile { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.025); } }
  @media (prefers-reduced-motion: reduce) {
    .honeycomb-camera, .cell__depth, .cell--main .cell__depth, .cell--brand .cell__depth, .edge-light path, .cell--empty:nth-child(5n) .cell__surface::after { animation: none; }
    .cell--empty .cell__depth { transform: scale(.8); opacity: .75; }
  }
</style>
