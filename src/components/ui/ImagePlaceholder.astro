---
/**
 * Espacio reservado para una imagen real. Se marca claramente como provisional
 * para que nadie lo confunda con un trabajo realizado.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  label?: string;
  icon?: IconName;
  ratio?: string;
  dark?: boolean;
}

const { label = 'Imagen pendiente', icon = 'image', ratio = '4 / 3', dark = false } = Astro.props;
---

<div class:list={['placeholder', { 'placeholder--dark': dark }]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={`${label} (espacio provisional)`}>
  <Icon name={icon} size={32} />
  <span>{label}</span>
</div>

<style>
  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-4);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    background-image: radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0);
    background-size: 18px 18px;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    text-align: center;
  }

  .placeholder--dark {
    border-color: var(--dark-border);
    background-color: var(--dark-card);
    background-image: radial-gradient(circle at 1px 1px, var(--dark-border) 1px, transparent 0);
    color: var(--dark-muted);
  }
</style>
