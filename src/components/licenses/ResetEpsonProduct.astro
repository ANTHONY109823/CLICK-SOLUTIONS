---
import Icon from '../ui/Icon.astro';
import software from '../../data/click-software.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const downloadUrl = software.drClick.download.startsWith('/') ? `${base}${software.drClick.download}` : software.drClick.download;
const contactUrl = `${base}/contacto`;
const storyImage = `${base}/images/software/reset-epson-flow.png`;
---

<div class="click-suite" aria-label="Software propio de ClickSolutions">
  <article class="doctor-card" aria-labelledby="doctor-title">
    <div class="doctor-card__top">
      <span class="product-badge">Descarga gratuita</span>
      <span class="product-version">v{software.drClick.version}</span>
    </div>

    <div class="doctor-visual" aria-hidden="true">
      <span class="doctor-visual__pulse"></span>
      <span class="doctor-visual__printer"><Icon name="printer" size={43} /></span>
      <span class="doctor-visual__scan"><Icon name="search" size={22} /></span>
    </div>

    <div class="doctor-card__copy">
      <span class="product-label">DIAGNÓSTICO PARA WINDOWS</span>
      <h3 id="doctor-title">{software.drClick.name}</h3>
      <p>Detecta el estado de la impresora y te indica si necesitas ResetEpson.</p>
    </div>

    {software.drClick.available ? (
      <a class="doctor-download" href={downloadUrl} download={software.drClick.filename} data-track="free_download" data-track-label="dr-clicksolutions">
        <Icon name="download" size={18} />Descargar gratis
      </a>
    ) : (
      <span class="doctor-download doctor-download--pending"><Icon name="clock" size={18} />Descarga próximamente</span>
    )}
  </article>

  <article class="reset-card" id="reset-epson" aria-labelledby="reset-epson-title">
    <header class="reset-card__header">
      <div>
        <span class="product-label">REINICIO DEL CONTADOR DE TINTA RESIDUAL</span>
        <h2 id="reset-epson-title">{software.resetEpson.name}</h2>
      </div>
    </header>

    <div class="compatibility" aria-label="Modelos compatibles">
      <Icon name="check" size={17} />
      <p><strong>Más de 1450 modelos Epson EcoTank</strong> · {software.resetEpson.featuredModels.join(', ')} y muchos más.</p>
    </div>

    <div class="reset-story" style={`--story-image:url("${storyImage}")`} role="img" aria-label="Diagnóstico, impresora compatible y activación de ResetEpson">
      <span class="reset-story__slide reset-story__slide--diagnosis"></span>
      <span class="reset-story__slide reset-story__slide--printer"></span>
      <span class="reset-story__slide reset-story__slide--success"></span>
      <span class="reset-story__progress" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>

    <div class="reset-plans" aria-label="Planes de ResetEpson">
      {software.resetEpson.plans.map((plan) => (
        <a class:list={["reset-plan", { "reset-plan--recommended": plan.recommended }]} href={`${contactUrl}?servicio=licencias-software&producto=ResetEpson%20ClickSolutions&plan=${plan.id}`} data-track="license_interest" data-track-label={`reset-epson-${plan.id}`}>
          {plan.recommended && <span class="reset-plan__badge">Más elegido</span>}
          <span class="reset-plan__duration">{plan.duration}</span>
          <h3>{plan.name}</h3>
          <strong>{plan.price}</strong>
          <span class="reset-plan__action">Elegir plan <Icon name="arrow-right" size={15} /></span>
        </a>
      ))}
    </div>

    <div class="reset-meta">
      <span><Icon name="monitor" size={16} />Windows + USB</span>
      <span><Icon name="lock" size={16} />Licencia vinculada a una PC</span>
    </div>
  </article>
</div>

<style>
  .click-suite { display: grid; grid-template-columns: minmax(270px, .72fr) minmax(0, 1.45fr); height: 100%; min-height: 0; gap: clamp(.9rem, 1.7vw, 1.3rem); }
  .doctor-card, .reset-card { min-width: 0; overflow: hidden; border: 1px solid #b7e1f3; border-radius: 23px; box-shadow: 0 24px 60px -48px #0a4663; }
  .doctor-card { position: relative; display: grid; grid-template-rows: auto minmax(150px, 1fr) auto auto; align-items:center; padding: clamp(1rem, 2vw, 1.35rem); background: radial-gradient(circle at 50% 28%, rgb(50 210 176 / .16), transparent 33%), linear-gradient(150deg, #041a31, #074f58); color: #fff; }
  .doctor-card::before { content: ''; position: absolute; inset: 0; opacity: .32; background-image: linear-gradient(rgb(100 228 207 / .06) 1px, transparent 1px), linear-gradient(90deg, rgb(100 228 207 / .06) 1px, transparent 1px); background-size: 30px 30px; pointer-events: none; }
  .doctor-card > * { position: relative; z-index: 1; }
  .doctor-card__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .product-badge, .product-version { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; font-size: .62rem; font-weight: 800; }
  .product-badge { padding: 6px 9px; border: 1px solid rgb(105 234 190 / .24); background: rgb(72 218 162 / .1); color: #81e9bd; }
  .product-version { color: #7699aa; }
  .doctor-visual { position: relative; display: grid; place-items: center; align-self: stretch; min-height: 125px; }
  .doctor-visual__pulse { position: absolute; width: 112px; aspect-ratio: 1; border: 1px solid rgb(101 232 206 / .22); border-radius: 50%; box-shadow: 0 0 0 24px rgb(101 232 206 / .035), 0 0 0 48px rgb(101 232 206 / .02); animation: doctor-pulse 2.8s ease-in-out infinite; }
  .doctor-visual__printer { display: grid; place-items: center; width: 78px; height: 78px; border: 1px solid rgb(101 232 206 / .25); border-radius: 24px; background: rgb(4 31 47 / .88); color: #67e6ce; box-shadow: 0 18px 40px -25px #000, 0 0 28px rgb(101 232 206 / .1); }
  .doctor-visual__scan { position: absolute; right: calc(50% - 64px); bottom: 18%; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: #16a9d0; color: #fff; box-shadow: 0 0 22px rgb(22 169 208 / .38); animation: doctor-scan 3s ease-in-out infinite; }
  .doctor-card__copy { text-align: center; }
  .product-label { color: #2faecb; font-size: .61rem; font-weight: 850; letter-spacing: .1em; }
  .doctor-card .product-label { color: #69e6cf; }
  .doctor-card h3 { margin: 5px 0 7px; color: #fff; font-size: clamp(1.35rem, 2vw, 1.8rem); }
  .doctor-card__copy p { max-width: 32ch; margin: 0 auto 14px; color: #b6cdd2; font-size: .78rem; line-height: 1.45; }
  .doctor-download { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 12px; background: linear-gradient(135deg, #53dda7, #22bdda); color: #032036; font-size: .77rem; font-weight: 850; text-decoration: none; }
  .doctor-download--pending { border: 1px solid rgb(255 255 255 / .13); background: rgb(3 25 40 / .62); color: #9eb8c1; }

  .reset-card { display: grid; grid-template-rows: auto auto minmax(88px, .8fr) auto auto; padding: clamp(.9rem, 1.7vw, 1.25rem); background: linear-gradient(145deg, #fff, #f2fafc); }
  .reset-card__header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }
  .reset-card__header h2 { margin: 4px 0 5px; color: var(--brand-ink); font-size: clamp(1.65rem, 2.55vw, 2.35rem); line-height: 1; letter-spacing: -.045em; }
  .compatibility { display: flex; align-items: center; gap: 8px; margin-top: 7px; padding: 8px 10px; border: 1px solid #b7e6d1; border-radius: 10px; background: #edfff5; color: #346b58; }
  .compatibility :global(svg) { flex: 0 0 auto; color: #21815d; }
  .compatibility p { margin: 0; font-size: .68rem; line-height: 1.35; }
  .compatibility strong { color: #176a4d; }
  .reset-story { position: relative; min-height: 88px; margin-top: 8px; overflow: hidden; border-radius: 14px; background: #06253a; box-shadow: inset 0 0 0 1px rgb(59 201 224 / .22); isolation: isolate; }
  .reset-story::after { content: ''; position: absolute; inset: 0; z-index: 2; background: linear-gradient(90deg, rgb(3 21 36 / .2), transparent 50%, rgb(3 21 36 / .15)); pointer-events: none; }
  .reset-story__slide { position: absolute; inset: 0; opacity: 0; background-image: var(--story-image); background-size: 300% 100%; background-repeat: no-repeat; animation: story-fade 12s infinite; }
  .reset-story__slide--diagnosis { background-position: left center; }
  .reset-story__slide--printer { background-position: center center; animation-delay: 4s; }
  .reset-story__slide--success { background-position: right center; animation-delay: 8s; }
  .reset-story__progress { position: absolute; right: 12px; bottom: 9px; z-index: 3; display: flex; gap: 5px; }
  .reset-story__progress i { width: 19px; height: 3px; overflow: hidden; border-radius: 999px; background: rgb(255 255 255 / .42); }
  .reset-story__progress i::after { content: ''; display: block; width: 100%; height: 100%; background: #6ce7cf; transform: scaleX(0); transform-origin: left; animation: story-progress 12s linear infinite; }
  .reset-story__progress i:nth-child(2)::after { animation-delay: 4s; }.reset-story__progress i:nth-child(3)::after { animation-delay: 8s; }
  .reset-plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; gap: 9px; margin-block: 9px; }
  .reset-plan { position: relative; display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto auto auto; align-items:end; min-width: 0; padding: .75rem .82rem; overflow: hidden; border: 1px solid #d4e4eb; border-radius: 15px; background: #fff; color: inherit; text-decoration: none; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .reset-plan::before { content: ''; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, transparent, #21afd4, transparent); }
  .reset-plan:hover { transform: translateY(-4px); border-color: #62c7df; box-shadow: 0 22px 35px -29px #0d6f8a; }
  .reset-plan--recommended { border-color: #39afd0; background: linear-gradient(155deg, #edfaff, #ecfff7); box-shadow: 0 20px 42px -34px #087999; }
  .reset-plan__badge { position: absolute; top: 8px; right: 8px; padding: 4px 6px; border-radius: 999px; background: #087d9b; color: #fff; font-size: .48rem; font-weight: 850; text-transform: uppercase; }
  .reset-plan__duration { grid-column: 1 / -1; color: #138ca7; font-size: .63rem; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; }
  .reset-plan h3 { grid-column: 1; margin: 5px 0 0; color: var(--brand-ink); font-size: .92rem; }
  .reset-plan > strong { grid-column: 1; color: #073d59; font-size: clamp(1.45rem, 2.2vw, 1.95rem); line-height: 1; }
  .reset-plan__action { grid-column: 2; grid-row: 2 / 4; display: grid; place-items:center; width: 34px; height: 34px; border-radius: 50%; background:#e9f8fb; color: #087d9b; font-size: 0; }
  .reset-meta { display: flex; align-items:center; gap: 18px; padding-top: 7px; border-top: 1px solid #dce9ee; color:#526b78; font-size:.69rem; font-weight:700; }
  .reset-meta span { display:flex; align-items:center; gap:6px; }.reset-meta :global(svg){color:#179fc0}

  @keyframes doctor-pulse { 50% { transform: scale(1.08); opacity: .55; } }
  @keyframes doctor-scan { 50% { transform: translate(5px, -8px) rotate(-8deg); } }
  @keyframes story-fade { 0%,5%{opacity:0;transform:scale(1.04)} 9%,29%{opacity:1;transform:scale(1)} 34%,100%{opacity:0;transform:scale(1.02)} }
  @keyframes story-progress { 0%,5%{transform:scaleX(0)} 8%,31%{transform:scaleX(1)} 34%,100%{transform:scaleX(0)} }
  @media (max-width: 900px) { .click-suite { grid-template-columns: 1fr; height: auto; } .doctor-card { min-height: 520px; } .reset-card { min-height: 540px; } }
  @media (max-width: 620px) { .doctor-card { min-height: 440px; } .reset-card__header { display: grid; } .reset-plans { grid-template-columns: 1fr; } .reset-card { min-height: auto; } .reset-plan{min-height:104px}.reset-meta{align-items:flex-start;flex-direction:column;gap:5px} }
  @media (prefers-reduced-motion: reduce) { .doctor-visual__pulse, .doctor-visual__scan, .reset-story__slide, .reset-story__progress i::after { animation: none; } .reset-story__slide--printer{opacity:1}.reset-plan { transition: none; } }
</style>
