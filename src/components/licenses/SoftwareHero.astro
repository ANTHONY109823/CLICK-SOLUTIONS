---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

const solutions: Array<{ id: string; number: string; icon: IconName; eyebrow: string; title: string; description: string; tags: string[] }> = [
  { id: 'software-propio', number: '01', icon: 'cpu', eyebrow: 'Creado por ClickSolutions', title: 'Software propio', description: 'Herramientas desarrolladas para resolver necesidades concretas, con activación y acompañamiento directo.', tags: ['ResetEpson', 'Activación privada', 'Windows'] },
  { id: 'licencias', number: '02', icon: 'key', eyebrow: 'Opciones verificadas', title: 'Licencias originales y gratuitas', description: 'Software comercial y herramientas abiertas, ordenadas por uso para que elijas la modalidad correcta.', tags: ['Microsoft', 'Adobe', 'ArtCraft'] },
  { id: 'proteccion', number: '03', icon: 'shield', eyebrow: 'Seguridad digital', title: 'Protección para tu PC', description: 'Antivirus originales para hogares, profesionales y varios dispositivos, cotizados según tu necesidad.', tags: ['ESET', 'Panda', 'Bitdefender'] },
];
---

<section class="software-overview" aria-labelledby="software-overview-title">
  <div class="software-overview__orb" aria-hidden="true"></div>
  <div class="container software-overview__inner">
    <header class="software-overview__header" data-reveal>
      <h1 id="software-overview-title">Software y licencias</h1>
    </header>

    <div class="software-overview__cards" aria-label="Líneas principales de software">
      {solutions.map((solution, index) => (
        <a class="software-service" href={`#${solution.id}`} data-kind={solution.id} data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <div class="software-service__copy">
            <div class="software-service__top">
              <span class="software-service__icon"><Icon name={solution.icon} size={23} /></span>
              <span class="software-service__number">{solution.number}</span>
            </div>
            <p class="software-service__eyebrow">{solution.eyebrow}</p>
            <h2>{solution.title}</h2>
            <p class="software-service__description">{solution.description}</p>
            <div class="software-service__tags">{solution.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>

          <div class="software-service__visual" aria-hidden="true">
            {solution.id === 'software-propio' ? (
              <div class="utility-window">
                <span class="utility-window__bar"><i></i><i></i><i></i><b>ResetEpson.exe</b></span>
                <span class="printer-motion"><span class="printer-paper"><i></i><i></i><i></i></span><Icon name="printer" size={42} /></span>
                <strong>Equipo verificado</strong><small>Licencia vinculada a tu PC</small>
                <span class="utility-window__status"><i></i> LISTO PARA ACTIVAR</span>
              </div>
            ) : solution.id === 'licencias' ? (
              <div class="license-terminal">
                <span class="license-terminal__bar"><i></i><i></i><i></i><b>verificar-licencia.cs</b></span>
                <small>LICENCIA ORIGINAL</small>
                <strong>Serial verificado</strong>
                <code></code>
                <span class="license-terminal__status"><Icon name="check" size={14} /> CLAVE LISTA PARA ACTIVAR</span>
                <div><span>Microsoft</span><span>Adobe</span><span>ArtCraft</span></div>
              </div>
            ) : (
              <div class="security-orbit">
                <span class="security-orbit__shield"><Icon name="shield" size={48} /></span>
                <span class="security-orbit__brand brand-one">ESET</span><span class="security-orbit__brand brand-two">PANDA</span><span class="security-orbit__brand brand-three">BITDEFENDER</span>
              </div>
            )}
            <span class="software-service__cta">Ver detalles <Icon name="arrow-right" size={16} /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .software-overview{position:relative;min-height: min(836px, calc(100svh - var(--header-h)));padding-block:clamp(1.5rem,3vh,2.4rem);overflow:hidden;background:radial-gradient(circle at 86% 9%,rgb(177 235 75/.18),transparent 27%),linear-gradient(135deg,#061529 0%,#07343c 57%,#0a5145 100%);color:#fff;isolation:isolate}
  .software-overview::before{content:'';position:absolute;inset:0;z-index:-2;opacity:.45;background-image:linear-gradient(rgb(152 231 197/.055) 1px,transparent 1px),linear-gradient(90deg,rgb(152 231 197/.055) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(90deg,transparent,#000 15%,#000 86%,transparent)}
  .software-overview__orb{position:absolute;right:-10rem;bottom:-18rem;z-index:-1;width:39rem;aspect-ratio:1;border:1px solid rgb(185 239 95/.13);border-radius:50%;box-shadow:0 0 0 80px rgb(83 222 163/.03),0 0 0 160px rgb(83 222 163/.02)}
  .software-overview__inner{display:grid;width:min(calc(100% - 2rem),1560px);max-width:none;gap:clamp(1rem,2.4vh,1.8rem)}
  .software-overview__header{display:flex;align-items:center;gap:var(--space-5)}
  .software-overview__header h1{display:inline-flex;align-items:center;gap:10px;margin:0;color:#c5ef68;font-size:var(--fs-xs);font-weight:850;letter-spacing:.1em;text-transform:uppercase}.software-overview__header h1::before{content:'';width:24px;height:2px;background:currentColor}
  .software-overview__cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));min-height:clamp(560px,76svh,720px);overflow:hidden;border:1px solid rgb(128 219 184/.2);border-radius:24px;background:rgb(3 22 34/.5);box-shadow:0 32px 75px -45px #001018}
  .software-service{--card-accent:#71e1bd;position:relative;display:grid;grid-template-rows:20rem minmax(170px,1fr);min-width:0;overflow:hidden;border-right:1px solid rgb(128 219 184/.17);background:linear-gradient(155deg,#0d4542,#061f31);color:inherit;text-decoration:none;transition:background-color var(--dur-base),box-shadow var(--dur-base),transform var(--dur-base) var(--ease-out)}
  .software-service::before{content:'';position:absolute;inset:0 0 auto;z-index:4;height:3px;background:linear-gradient(90deg,transparent 0%,var(--card-accent) 38%,#fff 50%,var(--card-accent) 62%,transparent 100%);background-size:220% 100%;opacity:.9;box-shadow:0 0 15px color-mix(in srgb,var(--card-accent) 65%,transparent);animation:service-line 4.6s linear infinite}.software-service::after{content:'';position:absolute;inset:0;z-index:3;pointer-events:none;background:linear-gradient(112deg,transparent 34%,color-mix(in srgb,var(--card-accent) 8%,transparent) 50%,transparent 66%);transform:translateX(-125%);animation:card-sweep 8s ease-in-out infinite}.software-service:nth-child(2)::before,.software-service:nth-child(2)::after{animation-delay:-1.5s}.software-service:nth-child(3)::before,.software-service:nth-child(3)::after{animation-delay:-3s}.software-service:last-child{border-right:0}.software-service[data-kind='licencias']{--card-accent:#44cfff;border-inline:1px solid rgb(68 207 255/.28);background:linear-gradient(150deg,#0b3854,#092638);box-shadow:0 24px 60px -36px #001b2a}.software-service[data-kind='proteccion']{--card-accent:#c5ef68;background:linear-gradient(155deg,#234c3e,#082c32)}.software-service:hover{z-index:1;background-color:rgb(112 225 189/.045);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--card-accent) 38%,transparent),0 24px 60px -40px #001018;transform:translateY(-3px)}.software-service[data-kind='licencias']:hover{background-color:rgb(68 207 255/.045);box-shadow:inset 0 0 0 1px rgb(68 207 255/.4),0 28px 65px -38px #045e78}.software-service:focus-visible{z-index:5;outline:3px solid var(--card-accent);outline-offset:-3px}
  .software-service__copy{padding:clamp(1.15rem,2.2vw,1.75rem)}.software-service__top{display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4)}.software-service__icon{display:grid;place-items:center;width:44px;height:44px;border:1px solid color-mix(in srgb,var(--card-accent) 28%,transparent);border-radius:13px;background:color-mix(in srgb,var(--card-accent) 11%,transparent);color:var(--card-accent)}.software-service__number{color:rgb(215 245 235/.22);font:850 1.35rem ui-monospace,SFMono-Regular,Consolas,monospace}
  .software-service__eyebrow{margin:0 0 6px;color:var(--card-accent);font-size:.65rem;font-weight:850;letter-spacing:.11em;text-transform:uppercase}.software-service h2{max-width:15ch;margin:0 0 10px;color:#fff;font-size:clamp(1.35rem,2.3vw,2rem);line-height:1.04}.software-service__description{margin:0;color:#9bb6bc;font-size:clamp(.75rem,1vw,.84rem);line-height:1.55}.software-service__tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:var(--space-4)}.software-service__tags span{padding:5px 8px;border:1px solid rgb(178 222 211/.14);border-radius:var(--radius-full);color:#bad0ce;font-size:.62rem;font-weight:700}
  .software-service[data-kind='licencias'] h2{color:#fff}.software-service[data-kind='licencias'] .software-service__description{color:#9dbdca}.software-service[data-kind='licencias'] .software-service__number{color:rgb(171 224 241/.25)}.software-service[data-kind='licencias'] .software-service__tags span{border-color:rgb(117 211 241/.2);background:rgb(3 26 42/.24);color:#b9dce6}
  .software-service__visual{position:relative;display:grid;place-items:center;min-height:0;padding:clamp(1.2rem,3vw,2.1rem);overflow:hidden;background:linear-gradient(150deg,rgb(3 26 39/.88),rgb(17 72 69/.65))}.software-service__visual::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgb(255 255 255/.035) 1px,transparent 1px),linear-gradient(90deg,rgb(255 255 255/.035) 1px,transparent 1px);background-size:34px 34px}.software-service__cta{position:absolute;right:14px;bottom:12px;z-index:3;display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid rgb(255 255 255/.15);border-radius:var(--radius-full);background:rgb(2 22 35/.8);color:#d8ece8;font-size:.65rem;font-weight:750}
  .software-service[data-kind='licencias'] .software-service__visual{background:linear-gradient(150deg,#061f32,#0b4354)}.software-service[data-kind='licencias'] .software-service__visual::before{background-image:linear-gradient(rgb(68 207 255/.07) 1px,transparent 1px),linear-gradient(90deg,rgb(68 207 255/.07) 1px,transparent 1px)}
  .utility-window{position:relative;z-index:1;display:grid;justify-items:center;width:min(100%,310px);padding:3.4rem 1.2rem 1.2rem;border:1px solid rgb(113 225 189/.28);border-radius:18px;background:rgb(3 20 33/.82);color:var(--card-accent);text-align:center;box-shadow:0 22px 45px rgb(0 0 0/.2),0 0 28px rgb(113 225 189/.05)}.utility-window__bar{position:absolute;inset:0 0 auto;display:flex;align-items:center;gap:5px;height:36px;padding:0 11px;border-bottom:1px solid rgb(255 255 255/.09)}.utility-window__bar i{width:6px;height:6px;border-radius:50%;background:#ff6e74}.utility-window__bar i:nth-child(2){background:#ffd25b}.utility-window__bar i:nth-child(3){background:#64de96}.utility-window__bar b{margin-left:auto;color:#6f8ca1;font:500 .55rem var(--font-mono)}.utility-window strong{margin-top:9px;color:#fff;font-size:.9rem}.utility-window small{color:#8ea8b1;font-size:.66rem}.utility-window__status{display:flex;align-items:center;gap:6px;margin-top:14px;padding:6px 8px;border-radius:8px;background:rgb(113 225 189/.09);font-size:.58rem;font-weight:800}.utility-window__status i{width:6px;height:6px;border-radius:50%;background:currentColor;box-shadow:0 0 9px currentColor;animation:status-blink 1.4s ease-in-out infinite}.printer-motion{position:relative;display:grid;place-items:end center;width:72px;height:66px}.printer-motion :global(svg){position:relative;z-index:2;filter:drop-shadow(0 0 9px rgb(113 225 189/.28))}.printer-paper{position:absolute;top:0;left:50%;z-index:1;width:38px;height:48px;padding:8px 6px;border-radius:3px;background:#dffcf3;box-shadow:0 0 18px rgb(113 225 189/.18);transform:translateX(-50%);animation:print-paper 3.2s ease-in-out infinite}.printer-paper i{display:block;height:2px;margin-bottom:5px;border-radius:2px;background:#3f9e89}.printer-paper i:nth-child(2){width:78%}.printer-paper i:nth-child(3){width:58%}
  .license-terminal{position:relative;z-index:1;display:grid;width:min(100%,330px);padding:3.5rem 1.2rem 1.25rem;border:1px solid rgb(68 207 255/.28);border-radius:18px;background:linear-gradient(150deg,rgb(2 18 32/.94),rgb(4 35 51/.9));box-shadow:0 24px 50px rgb(0 0 0/.24),0 0 30px rgb(68 207 255/.08)}.license-terminal__bar{position:absolute;inset:0 0 auto;display:flex;align-items:center;gap:5px;height:36px;padding:0 11px;border-bottom:1px solid rgb(255 255 255/.08)}.license-terminal__bar i{width:6px;height:6px;border-radius:50%;background:#ff6e74}.license-terminal__bar i:nth-child(2){background:#ffd25b}.license-terminal__bar i:nth-child(3){background:#64de96}.license-terminal__bar b{margin-left:auto;color:#668aa0;font:500 .55rem var(--font-mono)}.license-terminal>small{color:#44cfff;font-size:.58rem;font-weight:850;letter-spacing:.1em}.license-terminal>strong{margin:5px 0 12px;color:#fff;font-size:1rem}.license-terminal code{display:flex;align-items:center;min-height:42px;padding:0 11px;overflow:hidden;border:1px solid rgb(68 207 255/.18);border-radius:10px;background:#031725;color:#8be2ff;font:750 .82rem var(--font-mono);white-space:nowrap}.license-terminal code::before{content:'CS-8F2K-91PX-7Q4M';display:block;width:0;overflow:hidden;animation:serial-type 4.8s steps(18,end) infinite}.license-terminal code::after{content:'';width:2px;height:16px;margin-left:2px;background:#8be2ff;box-shadow:0 0 8px #44cfff;animation:cursor-blink .8s steps(1) infinite}.license-terminal__status{display:flex;align-items:center;gap:6px;margin-top:10px;color:#6ce6b2;font-size:.58rem;font-weight:800}.license-terminal__status :global(svg){filter:drop-shadow(0 0 6px rgb(108 230 178/.45))}.license-terminal>div{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}.license-terminal>div span{padding:5px 7px;border:1px solid rgb(68 207 255/.14);border-radius:999px;color:#91b7c5;font-size:.56rem;font-weight:700}
  .security-orbit{position:relative;z-index:1;display:grid;place-items:center;width:min(100%,300px);aspect-ratio:1.35;border:1px solid rgb(197 239 104/.12);border-radius:50%;box-shadow:inset 0 0 45px rgb(197 239 104/.05),0 0 0 24px rgb(197 239 104/.025)}.security-orbit::before,.security-orbit::after{content:'';position:absolute;inset:-1px;border:2px solid transparent;border-top-color:rgb(197 239 104/.8);border-right-color:rgb(87 225 166/.32);border-radius:50%;filter:drop-shadow(0 0 7px rgb(197 239 104/.38));animation:defense-spin 5.5s linear infinite}.security-orbit::after{inset:18px;border-top-color:rgb(87 225 166/.64);border-right-color:transparent;border-bottom-color:rgb(197 239 104/.24);animation-duration:3.8s;animation-direction:reverse}.security-orbit__shield{position:relative;z-index:2;display:grid;place-items:center;width:92px;height:92px;border:1px solid rgb(197 239 104/.2);border-radius:30px;background:radial-gradient(circle,rgb(197 239 104/.2),rgb(197 239 104/.08));color:var(--card-accent);box-shadow:0 0 35px rgb(197 239 104/.16);animation:shield-pulse 2.4s ease-in-out infinite}.security-orbit__shield :global(svg){filter:drop-shadow(0 0 9px rgb(197 239 104/.45))}.security-orbit__brand{position:absolute;z-index:3;padding:6px 9px;border:1px solid rgb(197 239 104/.2);border-radius:var(--radius-full);background:#082735;color:#dce9bd;font-size:.58rem;font-weight:850;letter-spacing:.05em}.brand-one{left:0;top:18%}.brand-two{right:-2%;top:12%}.brand-three{right:2%;bottom:9%}
  @keyframes service-line{to{background-position:-220% 0}}@keyframes card-sweep{0%,55%{transform:translateX(-125%)}80%,100%{transform:translateX(125%)}}@keyframes print-paper{0%,15%{transform:translate(-50%,18px);opacity:.25}42%,72%{transform:translate(-50%,-7px);opacity:1}100%{transform:translate(-50%,18px);opacity:.25}}@keyframes serial-type{0%,12%{width:0}58%,82%{width:18ch}100%{width:0}}@keyframes cursor-blink{50%{opacity:0}}@keyframes defense-spin{to{transform:rotate(1turn)}}@keyframes shield-pulse{50%{transform:scale(1.06);box-shadow:0 0 52px rgb(197 239 104/.26)}}@keyframes status-blink{50%{opacity:.35;transform:scale(.75)}}
  @media(max-width:900px){.software-overview{min-height:auto}.software-overview__cards{grid-template-columns:1fr}.software-service{grid-template-columns:minmax(0,1fr) minmax(220px,.85fr);grid-template-rows:1fr;border-right:0;border-bottom:1px solid rgb(128 219 184/.17)}.software-service:last-child{border-bottom:0}}
  @media(max-width:600px){.software-overview__header{align-items:flex-start;flex-direction:column;gap:6px}.software-overview__cards{border-radius:20px}.software-service{grid-template-columns:1fr;grid-template-rows:auto 245px}.software-service h2{max-width:17ch}}
  @media(prefers-reduced-motion:reduce){.software-service{transition:none}.software-service::before,.software-service::after,.printer-paper,.license-terminal code::before,.license-terminal code::after,.security-orbit::before,.security-orbit::after,.security-orbit__shield,.utility-window__status i{animation:none}.license-terminal code::before{width:18ch}}
@media(max-width:900px){.software-overview__cards{min-height:0;grid-auto-rows:auto}.software-service{grid-template-rows:auto}.software-service__visual{min-height:245px}}
</style>
