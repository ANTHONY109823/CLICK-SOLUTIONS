---
import Button from '../ui/Button.astro';
import software from '../../data/click-software.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const products = [
  {
    id: 'eset', name: 'ESET HOME Security', tone: 'green',
    image: software.antivirus.eset.image, alt: software.antivirus.eset.alt,
    href: '/contacto?servicio=licencias-software&producto=ESET%20HOME%20Security',
  },
  {
    id: 'panda', name: 'Panda Dome', tone: 'cyan',
    image: software.antivirus.panda.image, alt: software.antivirus.panda.alt,
    href: '/contacto?servicio=licencias-software&producto=Panda%20Dome',
  },
  {
    id: 'bitdefender', name: 'Bitdefender Total Security', tone: 'blue',
    image: software.antivirus.bitdefender.image, alt: software.antivirus.bitdefender.alt,
    href: '/contacto?servicio=licencias-software&producto=Bitdefender%20Total%20Security',
  },
].map((product) => ({
  ...product,
  image: product.image.startsWith('/') ? `${base}${product.image}` : product.image,
  href: `${base}${product.href}`,
}));
---

<section class="antivirus" aria-label="Antivirus originales">
  <div class="antivirus__grid">
    {products.map((product) => (
      <article class="antivirus-card" data-tone={product.tone}>
        <div class="antivirus-card__media">
          <img src={product.image} alt={product.alt} loading="lazy" />
          <span class="antivirus-card__glow" aria-hidden="true"></span>
        </div>
        <div class="antivirus-card__footer">
          <h3>{product.name}</h3>
          <Button href={product.href} size="sm" track="license_interest" data-track-label={`${product.id}-spotlight`}>Consultar licencia</Button>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .antivirus{height:auto;min-height:0;padding:clamp(.75rem,1.4vw,1rem);overflow:hidden;border:1px solid #1a4b59;border-radius:26px;background:radial-gradient(circle at 85% 5%,rgb(184 236 76/.12),transparent 28%),linear-gradient(135deg,#061c2e,#0a4143);box-shadow:0 30px 65px -48px #00101b}
  .antivirus__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));height:auto;min-height:0;align-items:start;gap:clamp(.7rem,1.3vw,1rem)}
  .antivirus-card{--card-accent:#8fe45a;position:relative;display:grid;grid-template-rows:auto auto;min-width:0;min-height:0;margin:0;padding:0;overflow:hidden;border:1px solid color-mix(in srgb,var(--card-accent) 38%,transparent);border-radius:22px;background:#082638;box-shadow:0 20px 45px -34px var(--card-accent);transition:transform .28s ease,box-shadow .28s ease,border-color .28s ease}
  .antivirus-card[data-tone='cyan']{--card-accent:#55d7ee}.antivirus-card[data-tone='blue']{--card-accent:#7ca7ff}
  .antivirus-card:hover{z-index:2;transform:translateY(-5px) scale(1.015);border-color:var(--card-accent);box-shadow:0 28px 55px -30px var(--card-accent)}
  .antivirus-card__media{position:relative;display:grid;place-items:center;min-height:0;padding:clamp(.55rem,1.1vw,.85rem);overflow:hidden;background:radial-gradient(circle at 50% 48%,color-mix(in srgb,var(--card-accent) 17%,transparent),transparent 58%),linear-gradient(180deg,#09283a,#071e30)}
  .antivirus-card__media img{position:relative;z-index:1;display:block;width:100%;height:auto;aspect-ratio:1;min-height:0;object-fit:contain;filter:drop-shadow(0 18px 28px rgb(0 10 20/.3));transition:transform .65s cubic-bezier(.2,.8,.2,1),filter .35s ease}
  .antivirus-card:hover .antivirus-card__media img{transform:scale(1.025);filter:saturate(1.08) drop-shadow(0 20px 34px rgb(0 10 20/.38))}
  .antivirus-card__media::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 82%,rgb(7 28 46/.32));pointer-events:none}
  .antivirus-card__glow{position:absolute;right:-15%;bottom:-30%;width:58%;aspect-ratio:1;border:1px solid color-mix(in srgb,var(--card-accent) 50%,transparent);border-radius:50%;box-shadow:0 0 0 30px color-mix(in srgb,var(--card-accent) 7%,transparent),0 0 45px color-mix(in srgb,var(--card-accent) 18%,transparent);animation:security-orbit 8s linear infinite}
  .antivirus-card__footer{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 15px;background:linear-gradient(135deg,#082337,#0b343e)}
  .antivirus-card h3{margin:0;color:#fff;font-size:clamp(1.05rem,1.7vw,1.45rem);line-height:1.05;letter-spacing:-.02em}
  .antivirus-card__footer :global(.btn){flex:0 0 auto;min-height:44px;padding-inline:12px;background:var(--card-accent);color:#061b24;font-size:.72rem;box-shadow:0 0 20px color-mix(in srgb,var(--card-accent) 22%,transparent)}
  @keyframes security-orbit{to{transform:rotate(360deg)}}
  @media(max-width:820px){.antivirus{padding:8px;border-radius:18px}.antivirus__grid{grid-template-columns:1fr;grid-template-rows:repeat(3,auto);gap:7px}.antivirus-card{grid-template-columns:minmax(0,1.3fr) minmax(180px,.7fr);grid-template-rows:1fr;border-radius:15px}.antivirus-card__footer{align-items:flex-start;flex-direction:column;justify-content:center;padding:12px}.antivirus-card__footer :global(.btn){width:100%}}
  @media(max-width:520px){.antivirus-card{grid-template-columns:1fr}.antivirus-card__media{display:grid}.antivirus-card__footer{align-items:center;flex-direction:column;justify-content:space-between}}
  @media(prefers-reduced-motion:reduce){.antivirus-card,.antivirus-card__media img{transition:none}.antivirus-card__glow{animation:none}}
</style>
