---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const products = [
  {
    id: 'eset', maker: 'ESET', name: 'ESET HOME Security', plans: 'Essential · Premium · Ultimate',
    text: 'Protección multiplataforma para hogares y equipos personales, elegida según funciones y cantidad de dispositivos.',
    platforms: ['Windows', 'macOS', 'Android'],
    official: 'https://www.eset.com/pe/hogar/planes-de-proteccion/',
    href: '/contacto?servicio=licencias-software&producto=ESET%20HOME%20Security', tone: 'green',
  },
  {
    id: 'panda', maker: 'PANDA SECURITY', name: 'Panda Dome', plans: 'Essential · Advanced · Complete · Premium',
    text: 'Antivirus, navegación segura y privacidad con distintas coberturas para personas, familias y varios dispositivos.',
    platforms: ['Windows', 'macOS', 'Android', 'iOS'],
    official: 'https://www.pandasecurity.com/es/homeusers/',
    href: '/contacto?servicio=licencias-software&producto=Panda%20Dome', tone: 'cyan',
  },
];
---

<section class="antivirus" id="antivirus" aria-labelledby="antivirus-title">
  <header class="antivirus__heading">
    <div>
      <span class="eyebrow">ANTIVIRUS CON LICENCIA ORIGINAL</span>
      <h2 id="antivirus-title">Protección que sí puedes verificar.</h2>
    </div>
    <p>Primero confirmamos sistema, dispositivos y duración. Después recibes la cotización y recién entonces se gestiona la licencia.</p>
  </header>

  <div class="antivirus__grid">
    {products.map((product, index) => (
      <article class="antivirus-card" data-tone={product.tone}>
        <div class="antivirus-card__top">
          <span class="antivirus-card__number">0{index + 1}</span>
          <span class="antivirus-card__status"><i></i> POR PEDIDO</span>
        </div>
        <div class="antivirus-card__identity">
          <span class="antivirus-card__shield"><Icon name="shield" size={30} /></span>
          <div><small>{product.maker}</small><h3>{product.name}</h3></div>
        </div>
        <p class="antivirus-card__plans">{product.plans}</p>
        <p class="antivirus-card__text">{product.text}</p>
        <div class="antivirus-card__platforms" aria-label="Sistemas compatibles">
          {product.platforms.map((platform) => <span>{platform}</span>)}
        </div>
        <div class="antivirus-card__actions">
          <Button href={product.href} size="sm" iconRight="arrow-right" track="license_interest" data-track-label={`${product.id}-spotlight`}>Consultar licencia</Button>
          <a href={product.official} target="_blank" rel="noopener noreferrer">Información oficial <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
  </div>

  <div class="antivirus__process" aria-label="Proceso para adquirir antivirus">
    <span><b>1</b><small>Indica tus equipos</small></span><Icon name="arrow-right" size={18} />
    <span><b>2</b><small>Confirmamos el plan</small></span><Icon name="arrow-right" size={18} />
    <span><b>3</b><small>Apruebas la cotización</small></span><Icon name="arrow-right" size={18} />
    <span><b>4</b><small>Recibes y activas</small></span>
  </div>
</section>

<style>
  .antivirus { padding: clamp(1.5rem, 3vw, 2.5rem); overflow: hidden; border: 1px solid #173c4b; border-radius: 28px; background: radial-gradient(circle at 90% 0%, rgb(184 236 76 / .13), transparent 25%), linear-gradient(135deg, #061c2e, #0b3e43); color: #dbeaf0; box-shadow: 0 30px 65px -48px #00101b; }
  .antivirus__heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .72fr); align-items: end; gap: var(--space-8); margin-bottom: var(--space-7); }
  .antivirus__heading .eyebrow { color: #bce95d; }
  .antivirus__heading h2 { max-width: 13ch; margin: 7px 0 0; color: #fff; font-size: clamp(2rem, 4vw, 3.8rem); line-height: 1; letter-spacing: -.045em; }
  .antivirus__heading > p { margin: 0; color: #99b1be; font-size: var(--fs-sm); line-height: 1.6; }
  .antivirus__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .antivirus-card { --card-accent: #8fe45a; position: relative; padding: clamp(1.25rem, 2.6vw, 2rem); overflow: hidden; border: 1px solid color-mix(in srgb, var(--card-accent) 28%, transparent); border-radius: 22px; background: linear-gradient(145deg, rgb(255 255 255 / .07), rgb(255 255 255 / .025)); }
  .antivirus-card[data-tone='cyan'] { --card-accent: #55d7ee; }
  .antivirus-card::after { content: ''; position: absolute; right: -16%; bottom: -45%; width: 55%; aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--card-accent) 22%, transparent); border-radius: 50%; box-shadow: 0 0 0 32px color-mix(in srgb, var(--card-accent) 5%, transparent); pointer-events: none; }
  .antivirus-card__top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); margin-bottom: var(--space-5); }
  .antivirus-card__number { color: rgb(255 255 255 / .18); font-family: var(--font-mono); font-size: 1.7rem; font-weight: 800; }
  .antivirus-card__status { display: inline-flex; align-items: center; gap: 7px; padding: 6px 9px; border: 1px solid color-mix(in srgb, var(--card-accent) 30%, transparent); border-radius: var(--radius-full); color: var(--card-accent); font-size: .62rem; font-weight: 800; letter-spacing: .08em; }
  .antivirus-card__status i { width: 6px; height: 6px; border-radius: 50%; background: var(--card-accent); box-shadow: 0 0 10px var(--card-accent); }
  .antivirus-card__identity { display: flex; align-items: center; gap: var(--space-4); }
  .antivirus-card__shield { display: grid; place-items: center; width: 62px; height: 62px; flex: 0 0 auto; border-radius: 18px; background: color-mix(in srgb, var(--card-accent) 14%, transparent); color: var(--card-accent); }
  .antivirus-card__identity small { color: var(--card-accent); font-size: .65rem; font-weight: 800; letter-spacing: .11em; }
  .antivirus-card h3 { margin: 3px 0 0; color: #fff; font-size: clamp(1.45rem, 3vw, 2.1rem); }
  .antivirus-card__plans { margin: var(--space-5) 0 var(--space-3); color: #cfdee5; font-size: var(--fs-xs); font-weight: 750; }
  .antivirus-card__text { min-height: 4.7em; margin: 0; color: #98aebb; font-size: var(--fs-sm); line-height: 1.6; }
  .antivirus-card__platforms { display: flex; flex-wrap: wrap; gap: 7px; margin-top: var(--space-5); }
  .antivirus-card__platforms span { padding: 5px 9px; border: 1px solid rgb(255 255 255 / .12); border-radius: var(--radius-full); color: #b9ccd5; font-size: .68rem; }
  .antivirus-card__actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-top: var(--space-6); }
  .antivirus-card__actions :global(.btn) { background: var(--card-accent); color: #061b24; }
  .antivirus-card__actions > a { color: #b9ccd5; font-size: var(--fs-xs); font-weight: 700; text-decoration: none; }
  .antivirus-card__actions > a:hover { color: #fff; text-decoration: underline; }
  .antivirus__process { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; align-items: center; gap: var(--space-3); margin-top: var(--space-4); padding: var(--space-4); border: 1px solid rgb(255 255 255 / .09); border-radius: 18px; background: rgb(0 0 0 / .13); }
  .antivirus__process > span { display: flex; align-items: center; gap: 9px; min-width: 0; }
  .antivirus__process b { display: grid; place-items: center; width: 28px; height: 28px; flex: 0 0 auto; border: 1px solid rgb(184 236 76 / .25); border-radius: 9px; color: #bce95d; font-family: var(--font-mono); font-size: .7rem; }
  .antivirus__process small { color: #9eb2bd; font-size: .7rem; }
  .antivirus__process > :global(svg) { color: rgb(184 236 76 / .4); }

  @media (max-width: 820px) {
    .antivirus__heading, .antivirus__grid { grid-template-columns: 1fr; }
    .antivirus-card__text { min-height: 0; }
    .antivirus__process { grid-template-columns: repeat(4, 1fr); }
    .antivirus__process > :global(svg) { display: none; }
    .antivirus__process > span { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 520px) {
    .antivirus { padding: 1.1rem; border-radius: 22px; }
    .antivirus__heading { gap: var(--space-3); }
    .antivirus-card { padding: 1.1rem; }
    .antivirus-card__actions { display: grid; }
    .antivirus-card__actions :global(.btn) { width: 100%; }
    .antivirus__process { grid-template-columns: 1fr 1fr; }
    .antivirus__process > span { flex-direction: row; }
  }
</style>
