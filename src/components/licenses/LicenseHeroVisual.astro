---
import Icon from '../ui/Icon.astro';
---

<div class="license-visual" aria-label="Licencias comerciales y software gratuito disponible">
  <div class="license-visual__grid" aria-hidden="true"></div>
  <div class="license-visual__center">
    <span><Icon name="key" size={34} /></span>
    <strong>Software confiable</strong>
    <small>Licencias + código abierto</small>
  </div>
  <div class="software-card software-card--one">
    <Icon name="layout" size={20} />
    <span><strong>Productividad</strong><small>Trabajo y oficina</small></span>
  </div>
  <div class="software-card software-card--two">
    <Icon name="shield" size={20} />
    <span><strong>Seguridad</strong><small>Protección digital</small></span>
  </div>
  <div class="software-card software-card--three">
    <Icon name="sparkles" size={20} />
    <span><strong>Diseño</strong><small>Contenido profesional</small></span>
  </div>
  <div class="software-card software-card--four">
    <Icon name="cpu" size={20} />
    <span><strong>Ingeniería</strong><small>Herramientas técnicas</small></span>
  </div>
</div>

<style>
  .license-visual {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    border: 1px solid rgb(74 186 235 / 0.24);
    border-radius: 26px;
    background:
      radial-gradient(circle at 50% 50%, rgb(0 170 231 / 0.22), transparent 35%),
      linear-gradient(145deg, rgb(7 46 83 / 0.92), rgb(3 20 42 / 0.96));
    box-shadow: 0 36px 80px -42px #000;
  }

  .license-visual::before,
  .license-visual::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 240px;
    height: 240px;
    border: 1px solid rgb(65 198 249 / 0.16);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .license-visual::after {
    width: 330px;
    height: 330px;
    border-style: dashed;
    animation: orbit 24s linear infinite;
  }

  .license-visual__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: radial-gradient(circle, black, transparent 80%);
  }

  .license-visual__center {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    justify-items: center;
    width: 168px;
    padding: var(--space-5);
    border: 1px solid rgb(86 204 251 / 0.28);
    border-radius: 22px;
    background: rgb(3 19 41 / 0.82);
    box-shadow: 0 22px 48px rgb(0 0 0 / 0.28), 0 0 42px rgb(0 170 231 / 0.12);
    backdrop-filter: blur(12px);
    transform: translate(-50%, -50%);
  }

  .license-visual__center > span {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-bottom: var(--space-3);
    border-radius: 18px;
    background: linear-gradient(145deg, var(--brand-cyan), var(--brand-blue));
    color: #031426;
  }

  .license-visual__center strong { color: #fff; font-size: var(--fs-sm); }
  .license-visual__center small { margin-top: 4px; color: var(--dark-muted); font-size: 0.68rem; }

  .software-card {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 150px;
    padding: 11px 13px;
    border: 1px solid rgb(83 193 239 / 0.24);
    border-radius: 14px;
    background: rgb(5 33 62 / 0.9);
    box-shadow: 0 18px 36px rgb(0 0 0 / 0.22);
    backdrop-filter: blur(10px);
    animation: float 5s ease-in-out infinite;
  }

  .software-card :global(svg) { flex: 0 0 auto; color: var(--dark-accent); }
  .software-card strong, .software-card small { display: block; }
  .software-card strong { color: #fff; font-size: 0.75rem; }
  .software-card small { margin-top: 2px; color: #89a6be; font-size: 0.62rem; }
  .software-card--one { top: 8%; left: 5%; }
  .software-card--two { top: 13%; right: 4%; animation-delay: -1.5s; }
  .software-card--three { bottom: 10%; left: 4%; animation-delay: -3s; }
  .software-card--four { right: 5%; bottom: 7%; animation-delay: -4.2s; }

  @keyframes orbit { to { transform: translate(-50%, -50%) rotate(360deg); } }
  @keyframes float { 50% { transform: translateY(-7px); } }

  @media (max-width: 520px) {
    .license-visual { min-height: 340px; }
    .software-card { min-width: 132px; padding: 9px 10px; }
    .software-card--one, .software-card--three { left: 2%; }
    .software-card--two, .software-card--four { right: 2%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .license-visual::after,
    .software-card { animation: none; }
  }
</style>
