---
/**
 * Catálogo de licencias con búsqueda y filtros en el navegador.
 * No hay compra en línea todavía: cada producto lleva a una consulta (site.features.onlinePayments).
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import type { LicenseProduct } from '../../data/licenses';

interface Props {
  products: LicenseProduct[];
}

const { products } = Astro.props;

const productGroups = [
  {
    id: 'commercial',
    title: 'Licencias originales',
    products: products.filter((product) => product.productModel !== 'open-source-service'),
  },
  {
    id: 'free',
    title: 'Software gratuito',
    products: products.filter((product) => product.productModel === 'open-source-service'),
  },
];

---

{
  products.length === 0 ? (
    <div class="empty-state">
      <span class="icon-tile"><Icon name="key" size={22} /></span>
      <h3>Catálogo en preparación</h3>
      <p>Estamos preparando el catálogo de productos. Mientras tanto, cuéntanos qué software necesitas y te informamos sobre disponibilidad, condiciones y precio.</p>
      <Button href="/contacto?servicio=licencias-software" track="quote_cta" data-track-label="licenses-empty">
        Consultar licencia
      </Button>
    </div>
  ) : (
    <div class="catalog">
      <div class="catalog-content">
        <div class="catalog-groups">
          {productGroups.map((group) => (
            <section class={`catalog-group catalog-group--${group.id}`} data-catalog-group>
              <header class="group-heading">
                <h3>{group.title}</h3>
              </header>

              <ul class="products products--list" aria-label={group.title}>
                {group.products.map((p) => (
                  <li
                    class="product product--row"
                    data-brand={p.manufacturer.toLowerCase().replace(/\s+/g, '-')}
                  >
                    {p.image ? (
                      <img src={p.image.src} alt={p.image.alt} width="42" height="42" loading="lazy" class="product__img" />
                    ) : (
                      <span class="product__brand" aria-hidden="true">{p.manufacturer.slice(0, 2).toUpperCase()}</span>
                    )}
                    <h4 class="product__name">{p.name}</h4>

                    {group.id === 'free' && p.officialUrl && (
                      <Button
                        href={p.officialUrl}
                        size="sm"
                        external
                        track="free_download"
                        data-track-label={p.id}
                      >
                        Descargar
                      </Button>
                    )}
                  </li>
                ))}
              </ul>

              {group.id === 'commercial' && (
                <div class="group-consult">
                  <Button href="/contacto?servicio=licencias-software" track="license_interest" data-track-label="catalogo-licencias">
                    Consultar licencias
                  </Button>
                </div>
              )}
            </section>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  .catalog { min-width: 0; width: 100%; max-width: 100%; overflow: clip; }
  .filter:not(.filter--search) {
    display: none;
  }

  .filter {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--brand-ink);
  }

  input,
  select {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    font: inherit;
    font-size: 16px;
    color: var(--text);
  }

  input {
    padding-left: 42px;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: var(--brand-cyan);
    box-shadow: var(--focus-ring);
  }

  .products {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(300px, 330px);
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 3px 2px var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .products::-webkit-scrollbar { display: none; }

  .product {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 460px;
    padding: var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-xl);
    scroll-snap-align: start;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base), border-color var(--dur-base);
  }

  .product::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-cyan), var(--brand-blue));
  }

  .product:hover {
    transform: translateY(-5px);
    border-color: #b9e6f8;
    box-shadow: var(--shadow-lg);
  }

  .product[hidden] {
    display: none;
  }

  .product__img {
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  .product__brand {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: linear-gradient(145deg, #e4f7ff, #ceeaff);
    color: var(--brand-navy);
    box-shadow: 0 14px 28px -20px rgb(0 111 205 / 0.9);
    font-size: var(--fs-md);
    font-weight: 850;
    letter-spacing: -0.04em;
  }

  .product[data-brand='adobe'] .product__brand { background: linear-gradient(145deg, #fff0f0, #ffd8d8); color: #c92323; }
  .product[data-brand='eset'] .product__brand { background: linear-gradient(145deg, #e7fbfa, #c7f1ef); color: #007d79; }
  .product[data-brand='bitdefender'] .product__brand { background: linear-gradient(145deg, #fff0f2, #ffd8df); color: #b31533; }
  .product[data-brand='corel'] .product__brand { background: linear-gradient(145deg, #effbe7, #d8f4c7); color: #378320; }
  .product[data-brand='autodesk'] .product__brand { background: linear-gradient(145deg, #eef7ff, #d8eaff); color: #1268a6; }
  .product[data-brand='artcraft'] .product__brand { background: linear-gradient(145deg, #211d35, #0c0a15); color: #d8ff61; }

  .product__name {
    margin-bottom: 2px;
    font-size: var(--fs-lg);
  }

  dt {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .product__terms {
    margin-bottom: var(--space-3);
    font-size: var(--fs-sm);
  }

  .product__terms summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--link);
  }

  .product__terms p {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
  }

  @media (min-width: 821px) {
    .catalog {
      display: grid;
      grid-template-rows: auto auto auto auto minmax(0, 1fr);
      height: 100%;
    }

    .filter { gap: 0; }
    .filter label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    input, select { min-height: 40px; border-radius: 11px; font-size: 14px; }

    .products {
      height: 100%;
      min-height: 0;
      grid-auto-columns: minmax(250px, calc((100% - 3 * var(--space-3)) / 4));
      gap: var(--space-3);
      padding-bottom: 2px;
    }

    .product {
      min-height: 0;
      height: 100%;
      padding: 14px;
      border-radius: 18px;
    }

    .product__brand { width: 46px; height: 46px; border-radius: 13px; font-size: var(--fs-sm); }
    .product__name { font-size: clamp(1.05rem, 1.45vw, 1.35rem); line-height: 1.05; }
    .product__specs, .product__terms { display: none; }
  }

  @media (max-width: 719px) {
    .filter:not(.filter--search) { display: flex; }

    .product {
      min-height: 0;
    }
  }

  @media (max-width: 479px) {
    .products {
      grid-auto-columns: minmax(84vw, 1fr);
    }

  }

  @media (max-width: 820px) {
    .catalog { display: grid; grid-template-rows: auto auto minmax(0, 1fr); height: 100%; }
    .catalog-note, .category-bar, .filter:not(.filter--search) { display: none; }
    .filter label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    input { min-height: 40px; border-radius: 11px; font-size: 14px; }
    .products { height: 100%; min-height: 0; grid-auto-columns: minmax(260px, 84vw); gap: 10px; padding-bottom: 2px; }
    .product { height: 100%; min-height: 0; padding: 13px; border-radius: 17px; }
    .product__brand { width: 44px; height: 44px; border-radius: 12px; font-size: var(--fs-sm); }
    .product__name { font-size: clamp(1.05rem, 4.5vw, 1.3rem); line-height: 1.05; }
    .product__specs, .product__terms { display: none; }
  }

  /* Catálogo dividido: navegación vertical + dos modalidades independientes. */
  .catalog {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: 0;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .catalog-content {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    gap: 0;
    min-width: 0;
    min-height: 0;
  }

  .catalog-content .catalog-note {
    min-height: 34px;
    margin: 0;
    padding: 7px 11px;
    border-radius: 11px;
    font-size: .7rem;
  }

  .catalog-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
    min-height: 0;
  }

  .catalog-group {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-width: 0;
    min-height: 0;
    padding: 12px;
    overflow: hidden;
    border: 1px solid #cce4ef;
    border-radius: 18px;
    background: linear-gradient(145deg, #f5fbff, #edf7fc);
  }

  .catalog-group--free {
    border-color: #cce8d5;
    background: linear-gradient(145deg, #f7fff9, #edf9f1);
  }

  .group-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 9px;
  }

  .group-heading > div:first-child { min-width: 0; }
  .group-heading h3 { margin: 0; color: var(--brand-ink); font-size: 1.25rem; line-height: 1.05; }

  .catalog-group .catalog-controls { flex: 0 0 auto; gap: 5px; }
  .catalog-group .catalog-controls > span { min-width: 42px; font-size: .61rem; }
  .catalog-group .catalog-controls button { width: 30px; height: 30px; border-radius: 9px; }

  .catalog-group .products {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 8px) / 2);
    gap: 8px;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
  }

  .catalog-group .product {
    min-width: 0;
    min-height: 0;
    height: 100%;
    padding: 11px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 13px 30px -25px rgb(3 63 92 / .55);
  }

  .catalog-group--free .product::before { background: linear-gradient(90deg, #35c477, #8ed66b); }
  .catalog-group .product:hover { transform: translateY(-2px); }
  .catalog-group .product__brand { width: 42px; height: 42px; border-radius: 12px; font-size: .76rem; }
  .catalog-group .product__badges { gap: 3px; }
  .catalog-group .product__badges .badge { padding: 3px 5px; font-size: .53rem; }
  .catalog-group .product__name { margin: 18px 0 0; font-size: clamp(1.05rem, 1.45vw, 1.3rem); line-height: 1.05; }
  .catalog-group .product__footer { gap: 5px; padding-top: 7px; }
  .catalog-group .product__price { max-width: 10ch; font-size: .64rem; }
  .catalog-group .product__footer :global(.btn) { min-height: 32px; padding-inline: 8px; font-size: .62rem; }
  .catalog-content > .no-results {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 20px;
    background: rgb(247 251 253 / .96);
  }

  .catalog-content > .no-results[hidden] { display: none; }

  @media (max-width: 1100px) and (min-width: 821px) {
    .catalog { grid-template-columns: 185px minmax(0, 1fr); }
    .catalog-group .products { grid-auto-columns: 100%; }
  }

  @media (max-width: 820px) {
    .catalog {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      gap: 7px;
    }

    .catalog-content { grid-template-rows: minmax(0, 1fr); }
    .catalog-content .catalog-note { display: none; }
    .catalog-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
    .catalog-group { padding: 8px; border-radius: 14px; }
    .group-heading { align-items: center; margin-bottom: 6px; }
    .group-heading p, .catalog-group .catalog-controls > span { display: none; }
    .group-heading h3 { font-size: .9rem; }
    .catalog-group .catalog-controls button { width: 27px; height: 27px; }
    .catalog-group .products { grid-auto-columns: 100%; }
    .catalog-group .product { padding: 9px; }
    .catalog-group .product__desc { -webkit-line-clamp: 2; }
    .catalog-group .product__footer { align-items: stretch; flex-direction: column; }
    .catalog-group .product__price { max-width: none; }
    .catalog-group .product__footer :global(.btn) { width: 100%; }
  }

  @media (max-width: 560px) {
    .catalog-groups { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: minmax(82vw, 1fr); overflow-x: auto; scroll-snap-type: x mandatory; }
    .catalog-group { scroll-snap-align: start; }
  }

  /* Listas compactas: una consulta general y descargas individuales. */
  .catalog{grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr);gap:0}
  .catalog-content{width:100%;height:100%}
  .catalog-group{grid-template-rows:auto minmax(0,1fr) auto;box-shadow:inset 0 0 35px rgb(27 165 220/.035),0 20px 55px -48px #07506d}
  .catalog-group--free{box-shadow:inset 0 0 35px rgb(53 196 119/.045),0 20px 55px -48px #18734c}
  .group-heading h3{position:relative;display:inline-flex;align-items:center;gap:9px}
  .group-heading h3::after{content:'';width:34px;height:3px;border-radius:99px;background:linear-gradient(90deg,#05afe8,#69e9ff);box-shadow:0 0 12px #05afe8;animation:heading-glow 2.8s ease-in-out infinite}
  .catalog-group--free .group-heading h3::after{background:linear-gradient(90deg,#27c774,#b3ef55);box-shadow:0 0 12px #27c774}
  .catalog-group .products--list{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    grid-auto-flow:row;
    grid-auto-columns:initial;
    grid-auto-rows:minmax(58px,1fr);
    align-content:stretch;
    gap:7px;
    height:100%;
    max-height:100%;
    padding:1px 3px 1px 1px;
    overflow-x:hidden;
    overflow-y:auto;
    scroll-snap-type:none;
    scrollbar-width:thin;
  }
  .catalog-group .product--row{
    --row-accent:#06aee8;
    --row-accent-2:#74e7ff;
    --row-bg:linear-gradient(145deg,#f8fdff,#eaf8ff);
    position:relative;
    isolation:isolate;
    display:grid;
    grid-template-columns:42px minmax(0,1fr) auto;
    align-items:center;
    gap:9px;
    width:100%;
    height:100%;
    min-height:58px;
    padding:9px 10px;
    border:0;
    border-radius:12px;
    background:transparent;
    box-shadow:0 12px 25px -22px var(--row-accent);
    transition:transform .24s ease,box-shadow .24s ease,filter .24s ease;
  }
  .catalog-group .product--row::before{content:'';position:absolute;inset:-160%;z-index:0;width:auto;height:auto;background:conic-gradient(from 0deg,transparent 0 34%,var(--row-accent) 43%,var(--row-accent-2) 49%,var(--row-accent) 55%,transparent 64% 100%);animation:row-border-spin 6s linear infinite}
  .catalog-group .product--row::after{content:'';position:absolute;inset:2px;z-index:0;border-radius:10px;background:var(--row-bg);box-shadow:inset 0 0 18px rgb(255 255 255/.65)}
  .catalog-group .product--row>*{position:relative;z-index:1}
  .catalog-group .product--row:hover{z-index:4;transform:translateY(-3px) scale(1.025);filter:saturate(1.12);box-shadow:0 20px 35px -20px var(--row-accent)}
  .catalog-group .product--row[data-brand='microsoft']{--row-accent:#00a4ef;--row-accent-2:#77dcff;--row-bg:linear-gradient(145deg,#f7fcff,#e4f5ff)}
  .catalog-group .product--row[data-brand='adobe']{--row-accent:#ef3b48;--row-accent-2:#ff9b9b;--row-bg:linear-gradient(145deg,#fffafa,#fff0f1)}
  .catalog-group .product--row[data-brand='corel']{--row-accent:#53b83e;--row-accent-2:#b4ec6a;--row-bg:linear-gradient(145deg,#fbfff8,#edf9e7)}
  .catalog-group .product--row[data-brand='autodesk']{--row-accent:#168bd2;--row-accent-2:#75d8ff;--row-bg:linear-gradient(145deg,#f8fcff,#e7f5ff)}
  .catalog-group .product--row[data-brand='artcraft']{--row-accent:#74d839;--row-accent-2:#d4ff5f;--row-bg:linear-gradient(145deg,#fcfff8,#f0fae9)}
  .catalog-group .product--row .product__brand{width:46px;height:46px;border-radius:12px;font-size:.76rem}
  .catalog-group .product--row .product__img{width:46px;height:46px;border-radius:12px}
  .catalog-group .product--row .product__name{min-width:0;margin:0;font-size:.82rem;line-height:1.15}
  .catalog-group .product--row :global(.btn){min-height:32px;padding-inline:9px;font-size:.63rem;transition:transform .2s ease,box-shadow .2s ease}
  .catalog-group .product--row :global(.btn:hover){transform:scale(1.06);box-shadow:0 0 18px rgb(5 139 181/.3)}
  .group-consult{display:flex;justify-content:flex-end;padding-top:9px;border-top:1px solid #d8e8ee}
  .group-consult :global(.btn){min-width:180px}

  @media (max-width:1100px){
    .catalog-group .products--list{grid-template-columns:1fr}
  }
  @media (max-width:820px){
    .catalog{grid-template-rows:minmax(0,1fr)}
    .catalog-group .products--list{grid-template-columns:1fr}
    .catalog-group .product--row{grid-template-columns:38px minmax(0,1fr) auto;min-height:50px;padding:6px}
    .catalog-group .product--row .product__brand,.catalog-group .product--row .product__img{width:38px;height:38px}
    .group-consult :global(.btn){width:100%;min-width:0}
  }
  @keyframes row-border-spin{to{transform:rotate(360deg)}}
  @keyframes heading-glow{50%{opacity:.45;transform:scaleX(.72)}}
  @media (prefers-reduced-motion:reduce){
    .catalog-group .product--row::before,.group-heading h3::after{animation:none}
    .catalog-group .product--row,.catalog-group .product--row :global(.btn){transition:none}
  }
</style>
