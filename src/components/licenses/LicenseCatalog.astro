---
/**
 * Catálogo de licencias con búsqueda y filtros en el navegador.
 * No hay compra en línea todavía: cada producto lleva a una consulta (site.features.onlinePayments).
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { availabilityLabels, type LicenseProduct } from '../../data/licenses';

interface Props {
  products: LicenseProduct[];
}

const { products } = Astro.props;

const unique = (values: string[]) => [...new Set(values)].sort((a, b) => a.localeCompare(b, 'es'));
const categories = unique(products.map((p) => p.category));
const manufacturers = unique(products.map((p) => p.manufacturer));
const hasOpenSourceProducts = products.some((p) => p.productModel === 'open-source-service');

const formatPrice = (price: LicenseProduct['price']) =>
  price
    ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: price.currency }).format(price.amount)
    : 'Precio a consultar';

const availabilityClass: Record<LicenseProduct['availability'], string> = {
  disponible: 'badge--success',
  'bajo-pedido': 'badge--warning',
  'fase-temprana': 'badge--info',
  'en-desarrollo': 'badge--neutral',
  agotado: 'badge--danger',
};

const consultHref = (p: LicenseProduct) =>
  `/contacto?servicio=licencias-software&producto=${encodeURIComponent(`${p.name} (${p.edition})`)}`;

const productHref = (p: LicenseProduct) =>
  p.productModel === 'open-source-service' && p.officialUrl ? p.officialUrl : consultHref(p);
---

{
  products.length === 0 ? (
    <div class="empty-state">
      <span class="icon-tile"><Icon name="key" size={22} /></span>
      <h3>Catálogo en preparación</h3>
      <p>Estamos preparando el catálogo de productos. Mientras tanto, cuéntanos qué software necesitas y te informamos sobre disponibilidad, condiciones y precio.</p>
      <Button href="/contacto?servicio=licencias-software" track="quote_cta" data-track-label="licenses-empty">
        Consultar licencia
      </Button>
    </div>
  ) : (
    <div class="catalog" data-catalog>
      <div class="catalog-note">
        <Icon name="info" size={18} />
        <p>{hasOpenSourceProducts
          ? 'El catálogo combina licencias comerciales con descargas gratuitas opcionales. Los productos ArtCraft son de código abierto: puedes descargarlos sin costo desde su fuente oficial y pedir instalación o soporte solo si lo necesitas.'
          : 'Este catálogo presenta las líneas que podemos cotizar. La disponibilidad comercial se valida antes de confirmar cada pedido.'}</p>
      </div>

      <div class="category-bar" aria-label="Filtrar por categoría">
        <button type="button" class="category-chip is-active" data-category-button="" aria-pressed="true">Todo</button>
        {categories.map((category) => (
          <button type="button" class="category-chip" data-category-button={category} aria-pressed="false">{category}</button>
        ))}
      </div>

      <div class="filters" role="search" aria-label="Buscar y filtrar software">
        <div class="filter filter--search">
          <label for="lc-search">Buscar</label>
          <div class="search-input">
            <Icon name="search" size={18} />
            <input id="lc-search" type="search" placeholder="Nombre, fabricante o tipo" autocomplete="off" data-filter-search />
          </div>
        </div>
        <div class="filter">
          <label for="lc-category">Categoría</label>
          <select id="lc-category" data-filter-category>
            <option value="">Todas</option>
            {categories.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
        <div class="filter">
          <label for="lc-manufacturer">Fabricante</label>
          <select id="lc-manufacturer" data-filter-manufacturer>
            <option value="">Todos</option>
            {manufacturers.map((m) => <option value={m}>{m}</option>)}
          </select>
        </div>
      </div>

      <p class="results-count" aria-live="polite" data-results-count>
        {products.length} {products.length === 1 ? 'producto' : 'productos'}
      </p>

      <ul class="products">
        {products.map((p) => (
          <li
            class="card product"
            data-product
            data-category={p.category}
            data-manufacturer={p.manufacturer}
            data-brand={p.manufacturer.toLowerCase().replace(/\s+/g, '-')}
            data-search={`${p.name} ${p.manufacturer} ${p.category} ${p.licenseType} ${p.edition} ${p.productModel ?? ''}`.toLowerCase()}
          >
            <div class="product__head">
              {p.image ? (
                <img src={p.image.src} alt={p.image.alt} width="56" height="56" loading="lazy" class="product__img" />
              ) : (
                <span class="product__brand" aria-hidden="true">{p.manufacturer.slice(0, 2).toUpperCase()}</span>
              )}
              <div class="product__badges">
                {p.demo && <span class="badge badge--demo">Demostración</span>}
                {p.productModel === 'open-source-service' && <span class="badge badge--free">Gratis · opcional</span>}
                <span class={`badge ${availabilityClass[p.availability]}`}>{availabilityLabels[p.availability]}</span>
              </div>
            </div>

            <p class="product__maker">{p.category}</p>
            <h3 class="product__name">{p.name}</h3>
            <p class="product__manufacturer">por {p.manufacturer}</p>
            {p.officialUrl && <a class="product__official" href={p.officialUrl} target="_blank" rel="noopener noreferrer">Ver información oficial <span aria-hidden="true">↗</span></a>}
            <p class="product__desc">{p.description}</p>

            <dl class="product__specs">
              <div><dt>Edición</dt><dd>{p.edition}</dd></div>
              <div><dt>{p.productModel === 'open-source-service' ? 'Modalidad' : 'Tipo de licencia'}</dt><dd>{p.licenseType}</dd></div>
              <div><dt>Duración</dt><dd>{p.duration}</dd></div>
              <div><dt>Dispositivos</dt><dd>{p.devices ?? 'No aplica'}</dd></div>
              <div class="span-2"><dt>Compatible con</dt><dd>{p.platforms.join(', ')}</dd></div>
            </dl>

            <details class="product__terms">
              <summary>{p.productModel === 'open-source-service' ? 'Condiciones del proyecto y servicio' : 'Condiciones y devoluciones'}</summary>
              <p><strong>Condiciones de uso:</strong> {p.terms}</p>
              <p><strong>Devoluciones:</strong> {p.refundPolicy}</p>
            </details>

            <div class="product__footer">
              <p class="product__price">{p.priceLabel ?? formatPrice(p.price)}</p>
              <Button
                href={productHref(p)}
                size="sm"
                variant={p.availability === 'agotado' || p.availability === 'en-desarrollo' ? 'secondary' : 'primary'}
                external={p.productModel === 'open-source-service'}
                track={p.productModel === 'open-source-service' ? 'free_download' : 'license_interest'}
                data-track-label={p.id}
              >
                {p.productModel === 'open-source-service' ? 'Descarga gratuita' : (p.ctaLabel ?? 'Consultar disponibilidad')}
              </Button>
            </div>
          </li>
        ))}
      </ul>

      <div class="empty-state no-results" hidden data-no-results>
        <p>No encontramos productos con esos filtros. Prueba con otra búsqueda o <a href="/contacto?servicio=licencias-software">consúltanos directamente</a>.</p>
      </div>
    </div>
  )
}

<style>
  .catalog { min-width: 0; }

  .catalog-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid #b9e6f8;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--info-bg), #f7fcff);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .catalog-note :global(svg) {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--brand-blue);
  }

  .catalog-note p {
    margin: 0;
  }

  .category-bar {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .category-chip {
    flex: 0 0 auto;
    min-height: 38px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: #fff;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 650;
    cursor: pointer;
    transition: background-color var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast), transform var(--dur-fast);
  }

  .category-chip:hover {
    border-color: var(--brand-cyan);
    color: var(--brand-navy);
    transform: translateY(-1px);
  }

  .category-chip.is-active {
    border-color: var(--brand-navy);
    background: var(--brand-navy);
    color: #fff;
    box-shadow: 0 10px 24px -16px rgb(3 63 92 / 0.8);
  }

  .filters {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: linear-gradient(145deg, #fff, #f7fbfe);
    box-shadow: var(--shadow-sm);
  }

  .filter:not(.filter--search) {
    display: none;
  }

  .filter {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--brand-ink);
  }

  .search-input {
    position: relative;
  }

  .search-input :global(svg) {
    position: absolute;
    top: 50%;
    left: 14px;
    color: var(--text-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  input,
  select {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    font: inherit;
    font-size: 16px;
    color: var(--text);
  }

  input {
    padding-left: 42px;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: var(--brand-cyan);
    box-shadow: var(--focus-ring);
  }

  .results-count {
    margin-bottom: var(--space-3);
    font-size: var(--fs-sm);
    font-weight: 650;
    color: var(--text-muted);
  }

  .products {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(300px, 330px);
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 3px 2px var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .product {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 460px;
    padding: var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-xl);
    scroll-snap-align: start;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base), border-color var(--dur-base);
  }

  .product::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-cyan), var(--brand-blue));
  }

  .product:hover {
    transform: translateY(-5px);
    border-color: #b9e6f8;
    box-shadow: var(--shadow-lg);
  }

  .product[hidden] {
    display: none;
  }

  .product__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .product__img {
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  .product__brand {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: linear-gradient(145deg, #e4f7ff, #ceeaff);
    color: var(--brand-navy);
    box-shadow: 0 14px 28px -20px rgb(0 111 205 / 0.9);
    font-size: var(--fs-md);
    font-weight: 850;
    letter-spacing: -0.04em;
  }

  .product[data-brand='adobe'] .product__brand { background: linear-gradient(145deg, #fff0f0, #ffd8d8); color: #c92323; }
  .product[data-brand='eset'] .product__brand { background: linear-gradient(145deg, #e7fbfa, #c7f1ef); color: #007d79; }
  .product[data-brand='bitdefender'] .product__brand { background: linear-gradient(145deg, #fff0f2, #ffd8df); color: #b31533; }
  .product[data-brand='corel'] .product__brand { background: linear-gradient(145deg, #effbe7, #d8f4c7); color: #378320; }
  .product[data-brand='autodesk'] .product__brand { background: linear-gradient(145deg, #eef7ff, #d8eaff); color: #1268a6; }
  .product[data-brand='artcraft'] .product__brand { background: linear-gradient(145deg, #211d35, #0c0a15); color: #d8ff61; }

  .badge--free {
    border: 1px solid #b8e7c4;
    background: #effcf2;
    color: #166534;
  }

  .badge--info {
    background: #e8f6ff;
    color: #075985;
  }

  .badge--neutral {
    background: #f1f3f5;
    color: #4b5563;
  }

  .product__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .product__maker {
    margin: var(--space-3) 0 var(--space-1);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .product__name {
    margin-bottom: 2px;
    font-size: var(--fs-lg);
  }

  .product__manufacturer {
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .product__official {
    align-self: flex-start;
    margin-bottom: var(--space-4);
    color: var(--link);
    font-size: var(--fs-xs);
    font-weight: 650;
    text-decoration: none;
  }

  .product__official:hover {
    text-decoration: underline;
  }

  .product__desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .product__specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: linear-gradient(145deg, var(--surface), #fff);
    font-size: var(--fs-sm);
  }

  .product__specs .span-2 {
    grid-column: 1 / -1;
  }

  dt {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .product__terms {
    margin-bottom: var(--space-3);
    font-size: var(--fs-sm);
  }

  .product__terms summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--link);
  }

  .product__terms p {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
  }

  .product__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .product__price {
    margin: 0;
    max-width: 12ch;
    font-weight: 750;
    line-height: 1.25;
    color: var(--brand-ink);
  }

  .no-results {
    margin-top: var(--space-4);
    padding: var(--space-8);
  }

  @media (max-width: 719px) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }

    .filter--search {
      grid-column: 1 / -1;
    }

    .product {
      min-height: 0;
    }
  }

  @media (max-width: 479px) {
    .products {
      grid-auto-columns: minmax(84vw, 1fr);
    }

    .filters {
      grid-template-columns: 1fr;
      padding: var(--space-4);
    }

    .filter--search {
      grid-column: auto;
    }

    .product__footer {
      align-items: stretch;
      flex-direction: column;
    }

    .product__price {
      max-width: none;
    }

    .product__footer :global(.btn) {
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((catalog) => {
    const search = catalog.querySelector<HTMLInputElement>('[data-filter-search]')!;
    const category = catalog.querySelector<HTMLSelectElement>('[data-filter-category]')!;
    const manufacturer = catalog.querySelector<HTMLSelectElement>('[data-filter-manufacturer]')!;
    const count = catalog.querySelector<HTMLElement>('[data-results-count]')!;
    const empty = catalog.querySelector<HTMLElement>('[data-no-results]')!;
    const items = [...catalog.querySelectorAll<HTMLElement>('[data-product]')];
    const categoryButtons = [...catalog.querySelectorAll<HTMLButtonElement>('[data-category-button]')];

    const normalize = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

    const apply = () => {
      const q = normalize(search.value);
      let visible = 0;
      for (const item of items) {
        const match =
          (!q || normalize(item.dataset.search ?? '').includes(q)) &&
          (!category.value || item.dataset.category === category.value) &&
          (!manufacturer.value || item.dataset.manufacturer === manufacturer.value);
        item.hidden = !match;
        if (match) visible++;
      }
      count.textContent = `${visible} ${visible === 1 ? 'producto' : 'productos'}`;
      empty.hidden = visible > 0;
      categoryButtons.forEach((button) => {
        const active = button.dataset.categoryButton === category.value;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };

    search.addEventListener('input', apply);
    category.addEventListener('change', apply);
    manufacturer.addEventListener('change', apply);
    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        category.value = button.dataset.categoryButton ?? '';
        apply();
      });
    });
  });
</script>
