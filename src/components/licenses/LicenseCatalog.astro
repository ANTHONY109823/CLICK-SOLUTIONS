---
/**
 * Catálogo de licencias con búsqueda y filtros en el navegador.
 * No hay compra en línea todavía: cada producto lleva a una consulta (site.features.onlinePayments).
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { availabilityLabels, type LicenseProduct } from '../../data/licenses';

interface Props {
  products: LicenseProduct[];
}

const { products } = Astro.props;

const unique = (values: string[]) => [...new Set(values)].sort((a, b) => a.localeCompare(b, 'es'));
const categories = unique(products.map((p) => p.category));
const hasOpenSourceProducts = products.some((p) => p.productModel === 'open-source-service');
const productGroups = [
  {
    id: 'commercial',
    eyebrow: 'Licencias originales',
    title: 'Software con costo',
    description: 'Cotizamos la edición correcta antes de activar.',
    products: products.filter((product) => product.productModel !== 'open-source-service'),
  },
  {
    id: 'free',
    eyebrow: 'Descargas oficiales',
    title: 'Software gratuito',
    description: 'Código abierto para descargar desde su fuente oficial.',
    products: products.filter((product) => product.productModel === 'open-source-service'),
  },
];

const formatPrice = (price: LicenseProduct['price']) =>
  price
    ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: price.currency }).format(price.amount)
    : 'Precio a consultar';

const availabilityClass: Record<LicenseProduct['availability'], string> = {
  disponible: 'badge--success',
  'bajo-pedido': 'badge--warning',
  'fase-temprana': 'badge--info',
  'en-desarrollo': 'badge--neutral',
  agotado: 'badge--danger',
};

const consultHref = (p: LicenseProduct) =>
  `/contacto?servicio=licencias-software&producto=${encodeURIComponent(`${p.name} (${p.edition})`)}`;

const productHref = (p: LicenseProduct) =>
  p.productModel === 'open-source-service' && p.officialUrl ? p.officialUrl : consultHref(p);
---

{
  products.length === 0 ? (
    <div class="empty-state">
      <span class="icon-tile"><Icon name="key" size={22} /></span>
      <h3>Catálogo en preparación</h3>
      <p>Estamos preparando el catálogo de productos. Mientras tanto, cuéntanos qué software necesitas y te informamos sobre disponibilidad, condiciones y precio.</p>
      <Button href="/contacto?servicio=licencias-software" track="quote_cta" data-track-label="licenses-empty">
        Consultar licencia
      </Button>
    </div>
  ) : (
    <div class="catalog" data-catalog>
      <aside class="catalog-sidebar" aria-label="Buscar y filtrar software">
        <div class="filters" role="search">
          <div class="filter filter--search">
            <label for="lc-search">Buscar software</label>
            <div class="search-input">
              <Icon name="search" size={18} />
              <input id="lc-search" type="search" placeholder="Nombre o fabricante" autocomplete="off" data-filter-search />
            </div>
          </div>
        </div>

        <div class="category-panel">
          <p class="category-panel__label">Filtrar por uso</p>
          <div class="category-bar" aria-label="Filtrar por categoría">
            <button type="button" class="category-chip is-active" data-category-button="" aria-pressed="true"><span>Todo el software</span><small>{products.length}</small></button>
            {categories.map((category) => (
              <button type="button" class="category-chip" data-category-button={category} aria-pressed="false"><span>{category}</span><small>{products.filter((product) => product.category === category).length}</small></button>
            ))}
          </div>
        </div>

        <div class="catalog-summary">
          <strong data-results-count>{products.length} productos</strong>
          <span>Resultados visibles</span>
        </div>
      </aside>

      <div class="catalog-content">
        <div class="catalog-note">
          <Icon name="info" size={17} />
          <p>{hasOpenSourceProducts
            ? 'Licencias comerciales a la izquierda. Descargas gratuitas y oficiales a la derecha.'
            : 'La disponibilidad comercial se valida antes de confirmar cada pedido.'}</p>
        </div>

        <div class="catalog-groups">
          {productGroups.map((group) => (
            <section class={`catalog-group catalog-group--${group.id}`} data-catalog-group data-carousel>
              <header class="group-heading">
                <div>
                  <span>{group.eyebrow}</span>
                  <h3>{group.title}</h3>
                  <p>{group.description}</p>
                </div>
                <div class="catalog-controls" aria-label={`Recorrer ${group.title.toLowerCase()}`}>
                  <span aria-live="polite" data-carousel-status>1 de {group.products.length}</span>
                  <button type="button" aria-label="Producto anterior" data-carousel-prev><Icon name="arrow-right" size={16} /></button>
                  <button type="button" aria-label="Producto siguiente" data-carousel-next><Icon name="arrow-right" size={16} /></button>
                </div>
              </header>

              <ul class="products" data-carousel-track tabindex="0" aria-label={group.title}>
                {group.products.map((p) => (
                  <li
                    class="card product"
                    data-product
                    data-carousel-item
                    data-category={p.category}
                    data-manufacturer={p.manufacturer}
                    data-brand={p.manufacturer.toLowerCase().replace(/\s+/g, '-')}
                    data-search={`${p.name} ${p.manufacturer} ${p.category} ${p.licenseType} ${p.edition} ${p.productModel ?? ''}`.toLowerCase()}
                  >
                    <div class="product__head">
                      {p.image ? (
                        <img src={p.image.src} alt={p.image.alt} width="48" height="48" loading="lazy" class="product__img" />
                      ) : (
                        <span class="product__brand" aria-hidden="true">{p.manufacturer.slice(0, 2).toUpperCase()}</span>
                      )}
                      <div class="product__badges">
                        {p.productModel === 'open-source-service' && <span class="badge badge--free">Gratis</span>}
                        <span class={`badge ${availabilityClass[p.availability]}`}>{availabilityLabels[p.availability]}</span>
                      </div>
                    </div>

                    <p class="product__maker">{p.category}</p>
                    <h4 class="product__name">{p.name}</h4>
                    <p class="product__manufacturer">por {p.manufacturer}</p>
                    {p.officialUrl && <a class="product__official" href={p.officialUrl} target="_blank" rel="noopener noreferrer">Fuente oficial <span aria-hidden="true">↗</span></a>}
                    <p class="product__desc">{p.description}</p>

                    <div class="product__footer">
                      <p class="product__price">{p.priceLabel ?? formatPrice(p.price)}</p>
                      <Button
                        href={productHref(p)}
                        size="sm"
                        variant={p.availability === 'agotado' || p.availability === 'en-desarrollo' ? 'secondary' : 'primary'}
                        external={p.productModel === 'open-source-service'}
                        track={p.productModel === 'open-source-service' ? 'free_download' : 'license_interest'}
                        data-track-label={p.id}
                      >
                        {p.productModel === 'open-source-service' ? 'Descargar' : (p.ctaLabel ?? 'Consultar')}
                      </Button>
                    </div>
                  </li>
                ))}
              </ul>

              <p class="group-empty" hidden data-group-empty>No hay resultados en este grupo.</p>
            </section>
          ))}
        </div>

        <div class="empty-state no-results" hidden data-no-results>
          <p>No encontramos productos con esos filtros. Prueba con otra búsqueda o <a href="/contacto?servicio=licencias-software">consúltanos directamente</a>.</p>
        </div>
      </div>
    </div>
  )
}

<style>
  .catalog { min-width: 0; width: 100%; max-width: 100%; overflow: clip; }

  .catalog-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid #b9e6f8;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--info-bg), #f7fcff);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .catalog-note :global(svg) {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--brand-blue);
  }

  .catalog-note p {
    margin: 0;
  }

  .category-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .category-chip {
    flex: 0 0 auto;
    min-height: 38px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: #fff;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 650;
    cursor: pointer;
    transition: background-color var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast), transform var(--dur-fast);
  }

  .category-chip:hover {
    border-color: var(--brand-cyan);
    color: var(--brand-navy);
    transform: translateY(-1px);
  }

  .category-chip.is-active {
    border-color: var(--brand-navy);
    background: var(--brand-navy);
    color: #fff;
    box-shadow: 0 10px 24px -16px rgb(3 63 92 / 0.8);
  }

  .filters {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: linear-gradient(145deg, #fff, #f7fbfe);
    box-shadow: var(--shadow-sm);
  }

  .filter:not(.filter--search) {
    display: none;
  }

  .filter {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--brand-ink);
  }

  .search-input {
    position: relative;
  }

  .search-input :global(svg) {
    position: absolute;
    top: 50%;
    left: 14px;
    color: var(--text-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  input,
  select {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    font: inherit;
    font-size: 16px;
    color: var(--text);
  }

  input {
    padding-left: 42px;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: var(--brand-cyan);
    box-shadow: var(--focus-ring);
  }

  .results-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .results-count {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 650;
    color: var(--text-muted);
  }

  .catalog-controls { display: flex; align-items: center; gap: 8px; }
  .catalog-controls > span { min-width: 56px; color: var(--text-muted); font-size: var(--fs-xs); font-weight: 750; text-align: right; }
  .catalog-controls button { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--border); border-radius: 12px; background: #fff; color: var(--brand-navy); cursor: pointer; transition: border-color var(--dur-fast), background-color var(--dur-fast), opacity var(--dur-fast); }
  .catalog-controls button:first-of-type { transform: rotate(180deg); }
  .catalog-controls button:hover:not(:disabled) { border-color: var(--brand-cyan); background: var(--info-bg); }
  .catalog-controls button:disabled { opacity: 0.35; cursor: default; }

  .products {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(300px, 330px);
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 3px 2px var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .products::-webkit-scrollbar { display: none; }

  .product {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 460px;
    padding: var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-xl);
    scroll-snap-align: start;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base), border-color var(--dur-base);
  }

  .product::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-cyan), var(--brand-blue));
  }

  .product:hover {
    transform: translateY(-5px);
    border-color: #b9e6f8;
    box-shadow: var(--shadow-lg);
  }

  .product[hidden] {
    display: none;
  }

  .product__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .product__img {
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  .product__brand {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: linear-gradient(145deg, #e4f7ff, #ceeaff);
    color: var(--brand-navy);
    box-shadow: 0 14px 28px -20px rgb(0 111 205 / 0.9);
    font-size: var(--fs-md);
    font-weight: 850;
    letter-spacing: -0.04em;
  }

  .product[data-brand='adobe'] .product__brand { background: linear-gradient(145deg, #fff0f0, #ffd8d8); color: #c92323; }
  .product[data-brand='eset'] .product__brand { background: linear-gradient(145deg, #e7fbfa, #c7f1ef); color: #007d79; }
  .product[data-brand='bitdefender'] .product__brand { background: linear-gradient(145deg, #fff0f2, #ffd8df); color: #b31533; }
  .product[data-brand='corel'] .product__brand { background: linear-gradient(145deg, #effbe7, #d8f4c7); color: #378320; }
  .product[data-brand='autodesk'] .product__brand { background: linear-gradient(145deg, #eef7ff, #d8eaff); color: #1268a6; }
  .product[data-brand='artcraft'] .product__brand { background: linear-gradient(145deg, #211d35, #0c0a15); color: #d8ff61; }

  .badge--free {
    border: 1px solid #b8e7c4;
    background: #effcf2;
    color: #166534;
  }

  .badge--info {
    background: #e8f6ff;
    color: #075985;
  }

  .badge--neutral {
    background: #f1f3f5;
    color: #4b5563;
  }

  .product__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .product__maker {
    margin: var(--space-3) 0 var(--space-1);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .product__name {
    margin-bottom: 2px;
    font-size: var(--fs-lg);
  }

  .product__manufacturer {
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .product__official {
    align-self: flex-start;
    margin-bottom: var(--space-4);
    color: var(--link);
    font-size: var(--fs-xs);
    font-weight: 650;
    text-decoration: none;
  }

  .product__official:hover {
    text-decoration: underline;
  }

  .product__desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .product__specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: linear-gradient(145deg, var(--surface), #fff);
    font-size: var(--fs-sm);
  }

  .product__specs .span-2 {
    grid-column: 1 / -1;
  }

  dt {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .product__terms {
    margin-bottom: var(--space-3);
    font-size: var(--fs-sm);
  }

  .product__terms summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--link);
  }

  .product__terms p {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
  }

  .product__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .product__price {
    margin: 0;
    max-width: 12ch;
    font-weight: 750;
    line-height: 1.25;
    color: var(--brand-ink);
  }

  .no-results {
    margin-top: var(--space-4);
    padding: var(--space-8);
  }

  @media (min-width: 821px) {
    .catalog {
      display: grid;
      grid-template-rows: auto auto auto auto minmax(0, 1fr);
      height: 100%;
    }

    .catalog-note {
      align-items: center;
      min-height: 38px;
      margin-bottom: 7px;
      padding: 7px 11px;
      border-radius: 12px;
      font-size: var(--fs-xs);
    }

    .catalog-note p {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
    }

    .category-bar {
      flex-wrap: nowrap;
      gap: 6px;
      margin-bottom: 7px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .category-bar::-webkit-scrollbar { display: none; }
    .category-chip { min-height: 32px; padding-inline: 12px; font-size: var(--fs-xs); }

    .filters {
      margin-bottom: 7px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .filter { gap: 0; }
    .filter label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    input, select { min-height: 40px; border-radius: 11px; font-size: 14px; }

    .results-bar { min-height: 34px; margin-bottom: 6px; }
    .catalog-controls button { width: 34px; height: 34px; border-radius: 10px; }

    .products {
      height: 100%;
      min-height: 0;
      grid-auto-columns: minmax(250px, calc((100% - 3 * var(--space-3)) / 4));
      gap: var(--space-3);
      padding-bottom: 2px;
    }

    .product {
      min-height: 0;
      height: 100%;
      padding: 14px;
      border-radius: 18px;
    }

    .product__brand { width: 46px; height: 46px; border-radius: 13px; font-size: var(--fs-sm); }
    .product__badges { gap: 4px; }
    .product__badges .badge { padding: 4px 7px; font-size: .62rem; }
    .product__maker { margin: 9px 0 2px; font-size: .63rem; }
    .product__name { font-size: clamp(1.05rem, 1.45vw, 1.35rem); line-height: 1.05; }
    .product__manufacturer { margin-bottom: 5px; }
    .product__official { margin-bottom: 6px; }
    .product__desc { margin: 5px 0 7px; font-size: var(--fs-xs); line-height: 1.45; }
    .product__specs, .product__terms { display: none; }
    .product__footer { gap: 7px; padding-top: 8px; }
    .product__price { font-size: var(--fs-xs); }
    .product__footer :global(.btn) { min-height: 36px; padding-inline: 11px; font-size: var(--fs-xs); }
  }

  @media (max-width: 719px) {
    .category-bar { display: none; }

    .filters {
      grid-template-columns: 1fr 1fr;
    }

    .filter:not(.filter--search) { display: flex; }

    .filter--search {
      grid-column: 1 / -1;
    }

    .product {
      min-height: 0;
    }
  }

  @media (max-width: 479px) {
    .products {
      grid-auto-columns: minmax(84vw, 1fr);
    }

    .filters {
      grid-template-columns: 1fr;
      padding: var(--space-4);
    }

    .filter--search {
      grid-column: auto;
    }

    .product__footer {
      align-items: stretch;
      flex-direction: column;
    }

    .product__price {
      max-width: none;
    }

    .product__footer :global(.btn) {
      width: 100%;
    }
  }

  @media (max-width: 820px) {
    .catalog { display: grid; grid-template-rows: auto auto minmax(0, 1fr); height: 100%; }
    .catalog-note, .category-bar, .filter:not(.filter--search) { display: none; }
    .filters { display: block; margin-bottom: 6px; padding: 0; border: 0; background: transparent; box-shadow: none; }
    .filter--search { display: block; }
    .filter label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    input { min-height: 40px; border-radius: 11px; font-size: 14px; }
    .results-bar { min-height: 34px; margin-bottom: 6px; }
    .catalog-controls button { width: 34px; height: 34px; }
    .products { height: 100%; min-height: 0; grid-auto-columns: minmax(260px, 84vw); gap: 10px; padding-bottom: 2px; }
    .product { height: 100%; min-height: 0; padding: 13px; border-radius: 17px; }
    .product__brand { width: 44px; height: 44px; border-radius: 12px; font-size: var(--fs-sm); }
    .product__badges { gap: 4px; }
    .product__badges .badge { padding: 4px 7px; font-size: .6rem; }
    .product__maker { margin: 8px 0 2px; font-size: .62rem; }
    .product__name { font-size: clamp(1.05rem, 4.5vw, 1.3rem); line-height: 1.05; }
    .product__manufacturer, .product__official { margin-bottom: 5px; }
    .product__desc { margin: 4px 0 6px; font-size: var(--fs-xs); line-height: 1.4; }
    .product__specs, .product__terms { display: none; }
    .product__footer { flex-direction: row; align-items: center; gap: 7px; padding-top: 7px; }
    .product__price { max-width: 11ch; font-size: var(--fs-xs); }
    .product__footer :global(.btn) { width: auto; min-height: 36px; padding-inline: 10px; font-size: var(--fs-xs); }
  }

  /* Catálogo dividido: navegación vertical + dos modalidades independientes. */
  .catalog {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 14px;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .catalog-sidebar {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-height: 0;
    padding: 13px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgb(255 255 255 / .9);
    box-shadow: 0 18px 50px -38px rgb(4 48 72 / .45);
  }

  .catalog-sidebar .filters {
    display: block;
    margin: 0 0 12px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .catalog-sidebar .filter--search { display: flex; gap: 7px; }
  .catalog-sidebar .filter label {
