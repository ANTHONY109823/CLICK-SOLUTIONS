---
import { site } from '../../config/site';

// Solo se muestra si hay un número de WhatsApp válido en src/config/site.ts.
const number = site.contact.whatsapp?.replace(/\D/g, '') ?? '';
const url = number ? `https://wa.me/${number}?text=${encodeURIComponent('Hola ClickSolutions, quiero solicitar información')}` : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  url && (
    <a
      href={url}
      class="whatsapp-float"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp (se abre en una nueva pestaña)"
      data-track="whatsapp_click"
      data-track-label="float"
      data-whatsapp-float
      data-number={number}
    >
      <img src={`${base}/brand/whatsapp.svg`} alt="" width="30" height="30" aria-hidden="true" />
    </a>
  )
}

<style>
  .whatsapp-float {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border: 1px solid #8cf0b994;
    border-radius: var(--radius-full);
    background: linear-gradient(145deg, #28d878, #0fa45a);
    color: #fff;
    box-shadow: 0 7px 0 #07844533, 0 12px 32px #075c4a40, inset 0 1px 0 #ffffff66;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast);
  }

  .whatsapp-float::before { content: ''; position: absolute; inset: -6px; border: 1px solid #25d36666; border-radius: inherit; opacity: 0; animation: whatsapp-ring 4s ease-out infinite; pointer-events: none; }
  .whatsapp-float img { position: relative; display: block; }

  .whatsapp-float:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 16px 36px #08744955, inset 0 1px 0 #ffffff66;
    color: #fff;
  }
  .whatsapp-float:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  @keyframes whatsapp-ring { 0%, 20% { transform: scale(.9); opacity: 0; } 35% { opacity: .5; } 75%, 100% { transform: scale(1.3); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .whatsapp-float::before { animation: none; } }
</style>

<script>
  const floatingLink = document.querySelector<HTMLAnchorElement>('[data-whatsapp-float]');
  if (floatingLink) {
    const path = location.pathname;
    const messages = [
      { match: '/servicios/drones', text: 'Hola ClickSolutions, quiero consultar por sus servicios con drones' },
      { match: '/servicios/desarrollo-web', text: 'Hola ClickSolutions, quiero cotizar un proyecto de desarrollo web' },
      { match: '/servicios/licencias-software', text: 'Hola ClickSolutions, quiero consultar por software o una licencia original' },
      { match: '/proyectos', text: 'Hola ClickSolutions, quiero conversar sobre un proyecto' },
    ];
    const text = messages.find((item) => path.includes(item.match))?.text ?? 'Hola ClickSolutions, quiero solicitar información';
    floatingLink.href = `https://wa.me/${floatingLink.dataset.number}?text=${encodeURIComponent(text)}`;
  }
</script>
