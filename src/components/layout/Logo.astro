---
/**
 * Logo oficial de ClickSolutions. Se usan los archivos originales, sin modificaciones:
 * - "full": logo vertical completo (src/assets/brand/clicksolutions-logo.png).
 * - "mark": isotipo + nombre de la marca en texto (hasta contar con una versión horizontal oficial).
 * Astro solo genera copias redimensionadas para la web; el diseño y los colores no cambian.
 * Siempre sobre fondo claro: el texto del logo es azul marino.
 */
interface Props {
  variant?: 'mark' | 'full';
  /** Ancho del logo completo en px. */
  width?: number;
  loading?: 'eager' | 'lazy';
}

const { variant = 'mark', width = 120, loading = 'lazy' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  variant === 'full' ? (
    <img
      src={`${base}/brand/clicksolutions-logo.png`}
      alt="ClickSolutions"
      width={width}
      loading={loading}
      decoding="async"
      class="logo-full"
    />
  ) : (
    <span class="logo-mark">
      <span class="logo-mark__symbol">
        <img src={`${base}/brand/clicksolutions-isotipo.png`} alt="" width="42" height="46" loading="eager" decoding="async" class="logo-mark__icon" />
      </span>
      <span class="logo-mark__text"><strong>Click</strong><span>solutions</span></span>
    </span>
  )
}

<style>
  .logo-mark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .logo-mark :global(.logo-mark__icon) {
    width: 42px;
    height: auto;
  }

  .logo-mark__symbol {
    display: grid;
    place-items: center;
    filter: drop-shadow(0 7px 14px rgb(0 170 231 / 0.22));
  }

  .logo-mark__text {
    display: grid;
    line-height: 0.82;
    letter-spacing: -0.035em;
    color: var(--logo-color, var(--brand-navy));
  }

  .logo-mark__text strong {
    font-size: 1.28rem;
    font-weight: 800;
  }

  .logo-mark__text span {
    margin-left: 1px;
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  :global(.logo-full) {
    height: auto;
  }
</style>
