---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site';
import { companyNav, helpNav, legalNav } from '../../data/navigation';
import { getServices } from '../../lib/content';
import { mailtoUrl, telUrl, whatsappUrl, socialLinks } from '../../lib/links';

const services = getServices();
const email = mailtoUrl();
const phone = telUrl();
const whatsapp = whatsappUrl();
const socials = socialLinks();
const year = new Date().getFullYear();

const columns = [
  { title: 'Servicios', links: services.map((s) => ({ label: s.name, href: `/servicios/${s.slug}` })) },
  { title: 'Empresa', links: companyNav },
  { title: 'Ayuda', links: helpNav },
  { title: 'Legal', links: legalNav },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label="ClickSolutions, ir al inicio" class="footer-logo">
        <Logo variant="mark" />
      </a>
      <p>{site.description}</p>

      {
        (email || phone || whatsapp || site.contact.area) && (
          <ul class="footer-contact">
            {whatsapp && (
              <li>
                <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-label="footer">
                  <Icon name="message" size={18} /> WhatsApp
                </a>
              </li>
            )}
            {email && (
              <li>
                <a href={email} data-track="email_click" data-track-label="footer">
                  <Icon name="mail" size={18} /> {site.contact.email}
                </a>
              </li>
            )}
            {phone && (
              <li>
                <a href={phone} data-track="phone_click" data-track-label="footer">
                  <Icon name="phone" size={18} /> {site.contact.phone}
                </a>
              </li>
            )}
            {site.contact.area && (
              <li>
                <span>
                  <Icon name="map-pin" size={18} /> {site.contact.area}
                </span>
              </li>
            )}
          </ul>
        )
      }

      {
        socials.length > 0 && (
          <ul class="footer-social">
            {socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      columns.map((column) => (
        <nav class="footer-col" aria-label={column.title}>
          <h2 class="footer-title">{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <p>
      © {year} {site.legalName ?? site.name}{site.ruc && ` · RUC ${site.ruc}`}. Todos los derechos reservados.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --logo-color: #fff;
    margin-top: auto;
    background:
      radial-gradient(circle at 12% 0%, rgb(0 170 231 / 0.12), transparent 30%),
      var(--dark-bg);
    border-top: 1px solid var(--dark-border);
    color: var(--dark-muted);
    font-size: var(--fs-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: var(--space-10) var(--space-8);
    padding-block: var(--space-16) var(--space-10);
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  .footer-brand p {
    max-width: 34ch;
    color: var(--dark-muted);
  }

  .footer-contact,
  .footer-social,
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-contact {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .footer-contact a,
  .footer-contact span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--dark-text);
    text-decoration: none;
  }

  .footer-contact :global(svg) {
    color: var(--dark-accent);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .footer-title {
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: #fff;
  }

  .footer-col li + li {
    margin-top: var(--space-3);
  }

  .footer-col a,
  .footer-social a {
    color: var(--dark-muted);
    text-decoration: none;
  }

  .footer-col a:hover,
  .footer-social a:hover,
  .footer-contact a:hover {
    color: var(--dark-accent);
    text-decoration: underline;
  }

  .footer-bottom {
    padding-block: var(--space-6);
    border-top: 1px solid var(--dark-border);
    color: var(--dark-muted);
    font-size: var(--fs-xs);
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 959px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
