---
import Logo from './Logo.astro';
import { site } from '../../config/site';
import { legalNav } from '../../data/navigation';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a href="/" aria-label="ClickSolutions, ir al inicio" class="footer-logo"><Logo variant="mark" /></a>
    <p>© {year} {site.legalName ?? site.name}{site.ruc && ` · RUC ${site.ruc}`}.</p>
    <nav aria-label="Información legal">
      <ul>{legalNav.map((link) => <li><a href={link.href}>{link.label.replace('Política de ', '')}</a></li>)}</ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    --logo-color: #fff;
    margin-top: auto;
    background:
      radial-gradient(circle at 12% 0%, rgb(0 170 231 / 0.12), transparent 30%),
      var(--dark-bg);
    border-top: 1px solid var(--dark-border);
    color: var(--dark-muted);
    font-size: var(--fs-sm);
  }

  .footer-inner { display: flex; align-items: center; gap: var(--space-6); min-height: 88px; padding-block: var(--space-4); }

  .footer-logo {
    display: inline-flex;
    flex: 0 0 auto;
  }

  .footer-inner p { margin: 0; color: var(--dark-muted); font-size: var(--fs-xs); }
  .footer-inner nav { margin-left: auto; }
  .footer-inner ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-inner a { color: var(--dark-muted); font-size: var(--fs-xs); text-decoration: none; }
  .footer-inner a:hover { color: var(--dark-accent); }

  @media (max-width: 720px) { .footer-inner { align-items: flex-start; flex-direction: column; gap: var(--space-3); } .footer-inner nav { margin-left: 0; } .footer-inner ul { justify-content: flex-start; gap: var(--space-2) var(--space-4); } }
</style>
