---
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getServices } from '../../lib/content';
import { routePath } from '../../lib/links';

const services = getServices();
const path = routePath(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const shortLabels: Record<string, string> = {
  drones: 'Drones',
  'desarrollo-web': 'Desarrollo web',
  'soporte-tecnico': 'Soporte',
  'licencias-software': 'Software',
};
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="ClickSolutions, ir al inicio">
      <Logo variant="mark" />
    </a>

    <nav class="nav-desktop" aria-label="Servicios principales">
      <ul class="nav-list">
        {services.map((service) => {
          const href = `/servicios/${service.slug}`;
          return (
            <li>
              <a
                href={href}
                class:list={['nav-link', { active: isActive(href) }]}
                aria-current={isActive(href) ? 'page' : undefined}
              >
                <Icon name={service.icon} size={16} />
                {shortLabels[service.slug]}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <Button href="/contacto" size="sm" class="header-cta" track="quote_cta" data-track-label="header">
        Cotizar
      </Button>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <Icon name="menu" size={24} class="icon-open" />
        <Icon name="x" size={24} class="icon-close" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-mobile-menu>
    <nav class="container" aria-label="Servicios principales">
      <p class="mobile-label">Elige un servicio</p>
      <ul class="mobile-list">
        {
          services.map((service) => (
            <li>
              <a href={`/servicios/${service.slug}`} class="mobile-link" aria-current={isActive(`/servicios/${service.slug}`) ? 'page' : undefined}>
                <span class="mobile-link__icon"><Icon name={service.icon} size={20} /></span>
                <span><strong>{service.name}</strong><small>{service.tagline}</small></span>
                <Icon name="arrow-right" size={17} />
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/contacto" size="lg" class="mobile-cta" track="quote_cta" data-track-label="mobile-menu">
        Solicitar cotización
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    --logo-color: #fff;
    background: rgb(3 19 41 / 0.94);
    border-bottom: 1px solid rgb(83 174 229 / 0.16);
    box-shadow: 0 0 0 rgb(1 15 32 / 0);
    transition: box-shadow var(--dur-base), background-color var(--dur-base);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--brand-cyan), var(--brand-blue), transparent);
    opacity: 0.8;
  }

  .site-header.is-scrolled {
    background: rgb(3 19 41 / 0.98);
    box-shadow: 0 16px 42px -30px rgb(0 0 0 / 0.9);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background: rgb(3 19 41 / 0.82);
      backdrop-filter: saturate(150%) blur(16px);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    height: var(--header-h);
    transition: height var(--dur-base) var(--ease-out);
  }

  .is-scrolled .header-inner {
    height: 64px;
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-desktop {
    min-width: 0;
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 clamp(0.55rem, 1vw, 0.9rem);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    font: inherit;
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 600;
    color: #d8e7f4;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }

  .nav-link:hover,
  .nav-link[aria-expanded='true'] {
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }

  .nav-link.active {
    background: rgb(0 170 231 / 0.12);
    color: var(--dark-accent);
    font-weight: 600;
  }

  .nav-link :global(svg) {
    color: #6fcff5;
  }

  .nav-link :global(.chevron) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav-link[aria-expanded='true'] :global(.chevron) {
    transform: rotate(180deg);
  }

  .has-menu {
    position: relative;
  }

  .nav-signal {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-cyan);
    box-shadow: 0 0 12px var(--brand-cyan);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    width: min(560px, 90vw);
    padding: var(--space-3);
    background: rgb(6 25 49 / 0.98);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transform: translateX(-50%);
    animation: dropdown-in var(--dur-base) var(--ease-out);
  }

  /* Puente invisible para que el menú no se cierre al mover el mouse hacia él. */
  .dropdown::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }

  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translate(-50%, -4px);
    }
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dropdown-item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--dark-text);
    transition: background-color var(--dur-fast);
  }

  .dropdown-item:hover,
  .dropdown-item[aria-current='page'] {
    background: rgb(255 255 255 / 0.07);
  }

  .dropdown-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgb(0 170 231 / 0.14);
    color: var(--dark-accent);
  }

  .dropdown-title {
    display: block;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: #fff;
  }

  .dropdown-desc {
    display: block;
    font-size: var(--fs-xs);
    color: var(--dark-muted);
    line-height: 1.45;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  :global(.header-cta) {
    background: linear-gradient(135deg, var(--brand-cyan), var(--brand-blue));
    color: #031426;
    box-shadow: 0 10px 26px -14px rgb(0 170 231 / 0.9);
  }

  :global(.header-cta:hover) {
    background: linear-gradient(135deg, #38c8fa, #3198ff);
    color: #031426;
    transform: translateY(-1px);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    cursor: pointer;
  }

  .menu-toggle :global(.icon-close),
  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 2;
    width: 100%;
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-block: var(--space-4) var(--space-12);
    background:
      radial-gradient(circle at 80% 5%, rgb(0 170 231 / 0.14), transparent 34%),
      var(--dark-bg);
    border-top: 1px solid var(--dark-border);
    overscroll-behavior: contain;
  }

  .mobile-label {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dark-muted);
  }

  .mobile-list {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 68px;
    padding: var(--space-3);
    border: 1px solid var(--dark-border);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.035);
    color: var(--dark-text);
    text-decoration: none;
  }

  .mobile-link__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgb(0 170 231 / 0.12);
  }

  .mobile-link strong,
  .mobile-link small {
    display: block;
  }

  .mobile-link strong {
    font-size: var(--fs-sm);
  }

  .mobile-link small {
    margin-top: 2px;
    color: var(--dark-muted);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .mobile-link :global(svg) {
    color: var(--dark-accent);
  }

  :global(.mobile-cta) {
    width: 100%;
    margin-top: var(--space-8);
  }

  @media (max-width: 1040px) {
    .nav-link :global(svg) {
      display: none;
    }
  }

  @media (max-width: 880px) {
    .nav-desktop {
      display: none;
    }

    .header-actions {
      margin-left: auto;
    }

    .menu-toggle {
      display: inline-grid;
    }

    .is-scrolled .mobile-menu {
      height: calc(100dvh - 64px);
    }
  }

  @media (max-width: 420px) {
    :global(.header-cta) {
      display: none !important;
    }
  }

  @media (min-width: 881px) {
    .mobile-menu {
      display: none !important;
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  const siteHeader = document.querySelector<HTMLElement>('[data-header]');
  const syncHeader = () => siteHeader?.classList.toggle('is-scrolled', window.scrollY > 18);
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });

  // Menú móvil.
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (menuToggle && mobileMenu) {
    const setMenu = (open: boolean) => {
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      mobileMenu.hidden = !open;
      document.body.classList.toggle('menu-open', open);
    };

    menuToggle.addEventListener('click', () => setMenu(mobileMenu.hasAttribute('hidden')));
    mobileMenu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.hidden) {
        setMenu(false);
        menuToggle.focus();
      }
    });
    window.matchMedia('(min-width: 881px)').addEventListener('change', (e) => {
      if (e.matches) setMenu(false);
    });
  }
</script>
