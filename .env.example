# Copia este archivo como .env para desarrollo local.
# En producción, define estas variables en Railway → servicio → Variables.
# Nunca subas el archivo .env al repositorio.

# URL pública del sitio (con https y sin barra final). Se usa en el sitemap, canonical y Open Graph.
SITE_URL=

# --- Formulario de contacto (Resend: https://resend.com) ---
# Pon "true" solo cuando las tres variables siguientes estén configuradas y probadas.
PUBLIC_CONTACT_FORM_ENABLED=false
# Clave de API de Resend (secreta, solo servidor).
RESEND_API_KEY=
# Correo que recibirá las solicitudes.
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "ClickSolutions <web@tudominio.pe>".
CONTACT_FROM_EMAIL=

# --- Analítica (desactivada por defecto) ---
PUBLIC_ANALYTICS_ENABLED=false
